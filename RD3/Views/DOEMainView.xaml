<UserControl
    x:Class="RD3.Views.DOEMainView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ex="clr-namespace:LayUI.Wpf.Extensions;assembly=LayUI.Wpf.Extensions"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:local="clr-namespace:RD3.Views"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:rd3="clr-namespace:RD3"
    xmlns:shared="clr-namespace:RD3.Shared;assembly=RD3.Shared"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    xmlns:viewmodels="clr-namespace:RD3.ViewModels"
    Width="1000"
    Height="600"
    d:DataContext="{d:DesignInstance Type=viewmodels:DOEMainViewModel}"
    rd3:DraggableUserControlAttach.IsDraggable="True"
    TextElement.FontFamily="{DynamicResource AppFontFamily}"
    TextElement.FontSize="{DynamicResource TextFontSize}"
    TextElement.FontWeight="Regular"
    TextElement.Foreground="{DynamicResource MaterialDesignBody}"
    TextOptions.TextFormattingMode="Ideal"
    TextOptions.TextRenderingMode="Auto"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ObjectDataProvider
            x:Key="DataFromEnum1"
            MethodName="GetValues"
            ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="shared:Factor" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
        <ObjectDataProvider
            x:Key="DataFromEnum2"
            MethodName="GetValues"
            ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="shared:DOEResponse" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
    </UserControl.Resources>
    <prism:Dialog.WindowStyle>
        <Style TargetType="Window">
            <Setter Property="SizeToContent" Value="WidthAndHeight" />
            <Setter Property="ResizeMode" Value="NoResize" />
            <Setter Property="prism:Dialog.WindowStartupLocation" Value="CenterScreen" />
            <Setter Property="Width" Value="{Binding FormWidth, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <Setter Property="Height" Value="{Binding FormHeight, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <Setter Property="Left" Value="{Binding LeftLocation, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <Setter Property="Top" Value="{Binding TopLocation, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <Setter Property="ShowInTaskbar" Value="True" />
            <Setter Property="AllowsTransparency" Value="False" />
            <Setter Property="WindowStyle" Value="ThreeDBorderWindow" />
            <Setter Property="WindowState" Value="{Binding FormState, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <Setter Property="Opacity" Value="1" />
            <Setter Property="Background" Value="{StaticResource BackGroundBrush}" />
        </Style>
    </prism:Dialog.WindowStyle>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="10" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <DockPanel LastChildFill="False">
            <hc:UniformSpacingPanel
                DockPanel.Dock="Left"
                Orientation="Horizontal"
                Spacing="10">
                <Button
                    Height="30"
                    HorizontalAlignment="Left"
                    hc:BorderElement.CornerRadius="{StaticResource DefaultCornerRadius}"
                    hc:IconElement.Geometry="{StaticResource GeometryChoose}"
                    Background="Transparent"
                    BorderThickness="1"
                    Command="{Binding ChooseReactorCommand}"
                    Content="{ex:Language Key='选择设备'}"
                    IsEnabled="{Binding DataResult.Rows.Count, Converter={StaticResource NumericToBoolConverter}}" />
                <Button
                    Height="30"
                    HorizontalAlignment="Left"
                    hc:BorderElement.CornerRadius="{StaticResource DefaultCornerRadius}"
                    hc:IconElement.Geometry="{StaticResource GeometrySendCommand}"
                    Background="Transparent"
                    BorderThickness="1"
                    Command="{Binding ControlReactorCommand}"
                    Content="{ex:Language Key='下发指令'}"
                    IsEnabled="{Binding DataResult.Rows.Count, Converter={StaticResource NumericToBoolConverter}}" />
                <Button
                    Height="30"
                    HorizontalAlignment="Left"
                    hc:BorderElement.CornerRadius="{StaticResource DefaultCornerRadius}"
                    hc:IconElement.Geometry="{StaticResource DownloadGeometry}"
                    Background="Transparent"
                    BorderThickness="1"
                    Command="{Binding GetResultCommand}"
                    Content="{ex:Language Key='获取结果'}"
                    IsEnabled="{Binding DataResult.Rows.Count, Converter={StaticResource NumericToBoolConverter}}" />
                <Button
                    Height="30"
                    HorizontalAlignment="Left"
                    hc:BorderElement.CornerRadius="{StaticResource DefaultCornerRadius}"
                    hc:IconElement.Geometry="{StaticResource GeometryAnalyse}"
                    Background="Transparent"
                    BorderThickness="1"
                    Command="{Binding AnalyseCommand}"
                    Content="{ex:Language Key='分析数据'}"
                    IsEnabled="{Binding DataResult.Rows.Count, Converter={StaticResource NumericToBoolConverter}}" />
            </hc:UniformSpacingPanel>
            <hc:UniformSpacingPanel
                DockPanel.Dock="Right"
                Orientation="Horizontal"
                Spacing="10">
                <Button
                    Height="30"
                    HorizontalAlignment="Left"
                    hc:BorderElement.CornerRadius="{StaticResource DefaultCornerRadius}"
                    hc:IconElement.Geometry="{StaticResource GeometryDesign}"
                    Background="Transparent"
                    BorderThickness="1"
                    Command="{Binding DesignCommand}"
                    Content="{ex:Language Key='设计实验'}"
                    IsEnabled="{Binding DesignEnable}" />
                <Button
                    Height="30"
                    HorizontalAlignment="Left"
                    hc:BorderElement.CornerRadius="{StaticResource DefaultCornerRadius}"
                    hc:IconElement.Geometry="{StaticResource GeometryBind}"
                    Background="Transparent"
                    BorderThickness="1"
                    Command="{Binding BindCommand}"
                    Content="{ex:Language Key='绑定参数'}"
                    IsEnabled="{Binding BindEnable}" />
                <Button
                    Height="30"
                    HorizontalAlignment="Left"
                    hc:BorderElement.CornerRadius="{StaticResource DefaultCornerRadius}"
                    hc:IconElement.Geometry="{StaticResource GeometryUnBind}"
                    Background="Transparent"
                    BorderThickness="1"
                    Command="{Binding UnBindCommand}"
                    Content="{ex:Language Key='解绑参数'}"
                    IsEnabled="{Binding BindEnable}" />
                <Button
                    Height="30"
                    HorizontalAlignment="Left"
                    hc:BorderElement.CornerRadius="{StaticResource DefaultCornerRadius}"
                    hc:IconElement.Geometry="{StaticResource GeometrySave}"
                    Background="Transparent"
                    BorderThickness="1"
                    Command="{Binding SaveCommand}"
                    Content="{ex:Language Key='保存结果'}"
                    IsEnabled="{Binding DataResult.Rows.Count, Converter={StaticResource NumericToBoolConverter}}" />
                <Button
                    Height="30"
                    HorizontalAlignment="Left"
                    hc:BorderElement.CornerRadius="{StaticResource DefaultCornerRadius}"
                    hc:IconElement.Geometry="{StaticResource GeometryImportTemplate}"
                    Background="Transparent"
                    BorderThickness="1"
                    Command="{Binding ImportCommand}"
                    Content="{ex:Language Key='导入文件'}" />
            </hc:UniformSpacingPanel>
        </DockPanel>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="auto" />
            </Grid.ColumnDefinitions>
            <DataGrid
                Name="dataGrid"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                hc:DataGridAttach.CanUnselectAllWithBlankArea="False"
                hc:DataGridAttach.ShowSelectAllButton="False"
                AutoGenerateColumns="True"
                AutoGeneratingColumn="dataGrid_AutoGeneratingColumn"
                Background="{StaticResource DefaultBrush}"
                CellStyle="{StaticResource DataGridTextCenterCellStyle}"
                ColumnHeaderStyle="{StaticResource DataGridCenterColumnHeaderStyle}"
                ColumnWidth="Auto"
                HeadersVisibility="Column"
                ItemsSource="{Binding DataResult}"
                RowHeaderWidth="60"
                ScrollViewer.HorizontalScrollBarVisibility="Auto"
                ScrollViewer.VerticalScrollBarVisibility="Auto"
                SelectionMode="Single"
                SelectionUnit="FullRow" />
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition Height="auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Border
                    Grid.RowSpan="2"
                    BorderBrush="LightGray"
                    BorderThickness="2"
                    CornerRadius="4">
                    <DockPanel LastChildFill="True">
                        <TextBlock
                            Margin="10,0,0,0"
                            DockPanel.Dock="Top"
                            Text="{ex:Language Key='DOE设计表字段:'}" />
                        <ListBox
                            Name="ListBoxDOE"
                            Width="220"
                            ItemsSource="{Binding DoeColunms}"
                            SelectedItem="{Binding SelectedDoeColunm}"
                            SelectionMode="Single"
                            Style="{StaticResource MaterialDesignNavigationPrimaryListBox}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>
                <Border
                    Grid.Column="2"
                    BorderBrush="LightGray"
                    BorderThickness="2"
                    CornerRadius="4">
                    <DockPanel LastChildFill="True">
                        <TextBlock
                            Margin="10,0,0,0"
                            DockPanel.Dock="Top"
                            Text="{ex:Language Key='实验因子:'}" />
                        <ListBox
                            Name="ListboxFactor"
                            Width="220"
                            ItemsSource="{Binding Source={StaticResource DataFromEnum1}}"
                            SelectionChanged="ListboxFactor_SelectionChanged"
                            SelectionMode="Multiple"
                            Style="{StaticResource MaterialDesignNavigationPrimaryListBox}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={StaticResource EnumToStringConverter}}" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>
                <Border
                    Grid.Row="1"
                    Grid.Column="2"
                    BorderBrush="LightGray"
                    BorderThickness="2"
                    CornerRadius="4">
                    <DockPanel
                        Grid.Row="1"
                        Grid.Column="2"
                        LastChildFill="True">
                        <TextBlock
                            Margin="10,0,0,0"
                            DockPanel.Dock="Top"
                            Text="{ex:Language Key='响应因子:'}" />
                        <ListBox
                            Width="220"
                            ItemsSource="{Binding Source={StaticResource DataFromEnum2}}"
                            SelectedItem="{Binding SelectedResponse}"
                            SelectionMode="Single"
                            Style="{StaticResource MaterialDesignNavigationPrimaryListBox}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={StaticResource EnumToStringConverter}}" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>
                <Border
                    Grid.Row="2"
                    Grid.ColumnSpan="3"
                    BorderBrush="LightGray"
                    BorderThickness="2"
                    CornerRadius="4">
                    <DockPanel
                        Grid.Row="2"
                        Grid.ColumnSpan="3"
                        LastChildFill="True">
                        <TextBlock
                            Margin="10,0,0,0"
                            DockPanel.Dock="Top"
                            Text="{ex:Language Key='已绑定参数对:'}" />
                        <ListBox
                            Height="150"
                            ItemsSource="{Binding ParameterPairs}"
                            Style="{StaticResource MaterialDesignListBox}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <hc:UniformSpacingPanel Orientation="Horizontal" Spacing="5">
                                        <TextBlock Text="{Binding Param1}" />
                                        <TextBlock Text="&gt;&gt;" Visibility="{Binding IsResponse, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                                        <TextBlock Text="​​&lt;&lt;​​" Visibility="{Binding IsResponse, Converter={StaticResource Boolean2VisibilityConverter}}" />
                                        <TextBlock Text="{Binding Param2}" />
                                    </hc:UniformSpacingPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
