<UserControl
    x:Class="RD3.Views.DeviceNodesView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Selector="clr-namespace:RD3"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ex="clr-namespace:LayUI.Wpf.Extensions;assembly=LayUI.Wpf.Extensions"
    xmlns:ext="clr-namespace:RD3.Extensions"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:local="clr-namespace:RD3"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:viewmodels="clr-namespace:RD3.ViewModels"
    xmlns:wpf="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
    MinWidth="1200"
    MinHeight="800"
    d:DataContext="{d:DesignInstance Type=viewmodels:DeviceNodesViewModel}"
    prism:ViewModelLocator.AutoWireViewModel="True"
    Background="Transparent"
    TextElement.FontFamily="{DynamicResource AppFontFamily}"
    TextElement.FontWeight="Regular"
    TextElement.Foreground="{DynamicResource MaterialDesignBody}"
    TextOptions.TextFormattingMode="Ideal"
    TextOptions.TextRenderingMode="Auto"
    mc:Ignorable="d">
    <Border Background="{StaticResource BackGroundBrush}" CornerRadius="{StaticResource DefaultCornerRadius}">
        <Grid>
            <Grid.RowDefinitions>
                <!--  操作按钮  -->
                <RowDefinition Height="70" />
                <!--  数据表格  -->
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Name="controlButtons">
                <!--  操作按钮  -->
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="120" />
                </Grid.ColumnDefinitions>
                <Button
                    Name="DeleteRow"
                    Grid.Column="1"
                    Width="80"
                    Height="40"
                    Background="SkyBlue"
                    Command="{Binding DeleteCommand}"
                    CommandParameter="{Binding SelectedIndex, ElementName=dataGrid}"
                    Content="删除数据" />
                <Button
                    Name="SaveColumn"
                    Grid.Column="2"
                    Width="80"
                    Height="40"
                    Background="SkyBlue"
                    Command="{Binding SaveCommand}"
                    Content="保存数据" />
            </Grid>
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <DataGrid
                    Name="dataGrid"
                    Grid.Column="0"
                    Margin="-1,0,1,0"
                    hc:DataGridAttach.CanUnselectAllWithBlankArea="False"
                    hc:DataGridAttach.ShowSelectAllButton="False"
                    AutoGenerateColumns="False"
                    Background="{StaticResource DefaultBrush}"
                    CanUserAddRows="True"
                    CanUserSortColumns="False"
                    ColumnWidth="SizeToHeader"
                    GridLinesVisibility="All"
                    HeadersVisibility="Column"
                    HorizontalGridLinesBrush="LightGray"
                    IsReadOnly="False"
                    ItemsSource="{Binding ParameterNodeCol}"
                    LayoutUpdated="DataGridMain_OnLayoutUpdated"
                    LoadingRow="DataGrid_LoadingRow"
                    RowHeaderWidth="100"
                    ScrollViewer.HorizontalScrollBarVisibility="Auto"
                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                    SelectionMode="Single"
                    SelectionUnit="FullRow"
                    VerticalGridLinesBrush="LightGray">
                    <DataGrid.Columns>
                        <!--  列表  -->
                        <DataGridTextColumn
                            Width="auto"
                            Binding="{Binding name}"
                            CanUserSort="False"
                            CellStyle="{StaticResource DataGridTextCenterCellStyle}"
                            Header="名称"
                            HeaderStyle="{StaticResource DataGridCenterColumnHeaderStyle}"
                            IsReadOnly="False" />
                        <DataGridTextColumn
                            Width="auto"
                            Binding="{Binding ename}"
                            CanUserSort="False"
                            CellStyle="{StaticResource DataGridTextCenterCellStyle}"
                            Header="英文名称"
                            HeaderStyle="{StaticResource DataGridCenterColumnHeaderStyle}"
                            IsReadOnly="False" />
                        <DataGridTextColumn
                            Width="auto"
                            Binding="{Binding minValue}"
                            CanUserSort="False"
                            CellStyle="{StaticResource DataGridTextCenterCellStyle}"
                            Header="最小值"
                            HeaderStyle="{StaticResource DataGridCenterColumnHeaderStyle}"
                            IsReadOnly="False" />
                        <DataGridTextColumn
                            Width="auto"
                            Binding="{Binding maxValue}"
                            CanUserSort="False"
                            CellStyle="{StaticResource DataGridTextCenterCellStyle}"
                            Header="最大值"
                            HeaderStyle="{StaticResource DataGridCenterColumnHeaderStyle}"
                            IsReadOnly="False" />
                        <DataGridComboBoxColumn
                            x:Name="colUnit"
                            Width="auto"
                            CanUserSort="False"
                            CellStyle="{StaticResource DataGridTextCenterCellStyle}"
                            Header="单位"
                            HeaderStyle="{StaticResource DataGridCenterColumnHeaderStyle}"
                            IsReadOnly="False"
                            SelectedValueBinding="{Binding unit, UpdateSourceTrigger=PropertyChanged}" />
                        <DataGridComboBoxColumn
                            x:Name="colAxisType"
                            Width="auto"
                            CanUserSort="False"
                            CellStyle="{StaticResource DataGridTextCenterCellStyle}"
                            Header="坐标轴"
                            HeaderStyle="{StaticResource DataGridCenterColumnHeaderStyle}"
                            IsReadOnly="False"
                            SelectedValueBinding="{Binding axisType, UpdateSourceTrigger=PropertyChanged}" />
                        <!--  Binding="{Binding axisType}"  -->
                        <DataGridComboBoxColumn
                            x:Name="colFieldName"
                            Width="auto"
                            CanUserSort="False"
                            CellStyle="{StaticResource DataGridTextCenterCellStyle}"
                            Header="关联"
                            HeaderStyle="{StaticResource DataGridCenterColumnHeaderStyle}"
                            IsReadOnly="False"
                            SelectedValueBinding="{Binding fieldName, UpdateSourceTrigger=PropertyChanged}" />
                        <DataGridComboBoxColumn
                            x:Name="colUsed"
                            Width="auto"
                            CanUserSort="False"
                            CellStyle="{StaticResource DataGridTextCenterCellStyle}"
                            Header="是否使用"
                            HeaderStyle="{StaticResource DataGridCenterColumnHeaderStyle}"
                            IsReadOnly="False"
                            SelectedValueBinding="{Binding isUsed, UpdateSourceTrigger=PropertyChanged}" />
                        <DataGridTextColumn
                            Width="300"
                            Binding="{Binding description}"
                            CanUserSort="False"
                            CellStyle="{StaticResource DataGridTextCenterCellStyle}"
                            Header="描述"
                            HeaderStyle="{StaticResource DataGridCenterColumnHeaderStyle}"
                            IsReadOnly="False" />
                        <DataGridTextColumn
                            Width="auto"
                            Binding="{Binding lineWidth}"
                            CanUserSort="False"
                            CellStyle="{StaticResource DataGridTextCenterCellStyle}"
                            Header="线宽"
                            HeaderStyle="{StaticResource DataGridCenterColumnHeaderStyle}" />
                        <DataGridTextColumn
                            Width="auto"
                            Binding="{Binding pointSize}"
                            CanUserSort="False"
                            CellStyle="{StaticResource DataGridTextCenterCellStyle}"
                            Header="标记尺寸"
                            HeaderStyle="{StaticResource DataGridCenterColumnHeaderStyle}" />
                        <DataGridTextColumn
                            x:Name="colColor"
                            Width="auto"
                            Binding="{Binding colorStr}"
                            CanUserSort="False"
                            CellStyle="{StaticResource DataGridTextCenterCellStyle}"
                            Header="颜色代码"
                            HeaderStyle="{StaticResource DataGridCenterColumnHeaderStyle}"
                            IsReadOnly="True" />
                        <DataGridTextColumn
                            Width="60"
                            CanUserSort="False"
                            CellStyle="{StaticResource DataGridTextCenterCellStyle}"
                            Header="颜色"
                            HeaderStyle="{StaticResource DataGridCenterColumnHeaderStyle}"
                            IsReadOnly="True" />
                        <DataGridTemplateColumn
                            Width="70"
                            CellStyle="{StaticResource DataGridTextCenterCellStyle}"
                            Header="操作"
                            HeaderStyle="{StaticResource DataGridCenterColumnHeaderStyle}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <hc:UniformSpacingPanel Orientation="Horizontal" Spacing="5">
                                        <Button
                                            HorizontalAlignment="Left"
                                            hc:IconElement.Geometry="{StaticResource GeometryEdit}"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Click="ColorSelected_Click"
                                            ToolTip="{ex:Language Key='Edit'}"
                                            Visibility="Visible" />
                                    </hc:UniformSpacingPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Grid>
    </Border>
</UserControl>
