<UserControl
    x:Class="RD3.Views.AuditView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ex="clr-namespace:LayUI.Wpf.Extensions;assembly=LayUI.Wpf.Extensions"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:local="clr-namespace:RD3.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:viewmodels="clr-namespace:RD3.ViewModels"
    xmlns:wpf="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
    Width="1300"
    Height="750"
    d:DataContext="{d:DesignInstance Type=viewmodels:AuditViewModel}"
    d:DesignHeight="1450"
    d:DesignWidth="1600"
    Background="{DynamicResource DefaultBrush}"
    TextElement.FontFamily="{DynamicResource AppFontFamily}"
    TextElement.FontSize="{DynamicResource TextFontSize}"
    TextElement.FontWeight="Regular"
    TextElement.Foreground="{DynamicResource MaterialDesignBody}"
    TextOptions.TextFormattingMode="Ideal"
    TextOptions.TextRenderingMode="Auto"
    mc:Ignorable="d">
    <prism:Dialog.WindowStyle>
        <Style TargetType="Window">
            <Setter Property="SizeToContent" Value="WidthAndHeight" />
            <Setter Property="ResizeMode" Value="NoResize" />
            <Setter Property="prism:Dialog.WindowStartupLocation" Value="CenterScreen" />
            <Setter Property="Width" Value="{Binding FormWidth, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <Setter Property="Height" Value="{Binding FormHeight, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <Setter Property="Left" Value="{Binding LeftLocation, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <Setter Property="Top" Value="{Binding TopLocation, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <Setter Property="ShowInTaskbar" Value="True" />
            <Setter Property="AllowsTransparency" Value="False" />
            <Setter Property="WindowStyle" Value="ThreeDBorderWindow" />
            <Setter Property="WindowState" Value="{Binding FormState, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <Setter Property="Background" Value="{StaticResource BackGroundBrush}" />
            <Setter Property="Opacity" Value="1" />
        </Style>
    </prism:Dialog.WindowStyle>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="auto" />
        </Grid.RowDefinitions>
        <hc:UniformSpacingPanel Orientation="Vertical" Spacing="10">
            <DockPanel HorizontalAlignment="Left" LastChildFill="False">
                <Border
                    Height="50"
                    Background="{DynamicResource BorderBrush}"
                    BorderThickness="0.5"
                    CornerRadius="8">
                    <hc:ButtonGroup
                        Name="ButtonGroup"
                        VerticalAlignment="Center"
                        Style="{StaticResource ButtonGroupSolid}">
                        <RadioButton
                            Width="100"
                            Height="40"
                            Margin="5,0,0,0"
                            hc:BorderElement.CornerRadius="8"
                            Background="{DynamicResource BorderBrush}"
                            Content="{ex:Language Key='Audit'}"
                            FontSize="{DynamicResource MediumFontSize}"
                            Foreground="{DynamicResource SecondaryTextBrush}"
                            IsChecked="True"
                            Tag="tabAction" />
                        <RadioButton
                            Width="100"
                            Height="40"
                            Margin="5,0,5,0"
                            hc:BorderElement.CornerRadius="8"
                            Background="{DynamicResource BorderBrush}"
                            Content="{ex:Language Key='Alarm'}"
                            FontSize="{DynamicResource MediumFontSize}"
                            Foreground="{DynamicResource SecondaryTextBrush}"
                            Tag="tabAlarm" />
                    </hc:ButtonGroup>
                </Border>
            </DockPanel>
            <DockPanel LastChildFill="False" Visibility="Collapsed">
                <hc:UniformSpacingPanel Orientation="Horizontal" Spacing="5">
                    <hc:SearchBar
                        Name="TxtSearch"
                        Width="240"
                        Height="35"
                        HorizontalAlignment="Center"
                        hc:InfoElement.ShowClearButton="True"
                        IsRealTime="True"
                        SearchStarted="TxtSearch_SearchStarted" />
                    <hc:DateTimePicker
                        Name="dtpStart"
                        Grid.Column="1"
                        Width="200"
                        Height="35"
                        hc:InfoElement.Placeholder="{ex:Language Key='Start time'}"
                        hc:InfoElement.ShowClearButton="True" />
                    <hc:DateTimePicker
                        Name="dtpEnd"
                        Width="200"
                        Height="35"
                        hc:InfoElement.Placeholder="{ex:Language Key='End time'}"
                        hc:InfoElement.ShowClearButton="True" />
                    <Button
                        Name="BtnExport"
                        Height="35"
                        HorizontalContentAlignment="Center"
                        hc:BorderElement.CornerRadius="{StaticResource DefaultCornerRadius}"
                        hc:IconElement.Geometry="{StaticResource GeometryExport}"
                        Command="{Binding ExportCommand}"
                        Content="{ex:Language Key='Export'}"
                        FontSize="{DynamicResource NormalFontSize}"
                        Visibility="Collapsed" />
                </hc:UniformSpacingPanel>
            </DockPanel>
        </hc:UniformSpacingPanel>
        <TabControl
            Name="tabControl"
            Grid.Row="1"
            Margin="0,10,0,10"
            BorderThickness="0"
            Loaded="TabControl_Loaded">
            <TabItem Name="tabAction">
                <DataGrid
                    Name="dataGrid"
                    hc:DataGridAttach.CanUnselectAllWithBlankArea="True"
                    hc:DataGridAttach.ShowSelectAllButton="False"
                    AutoGenerateColumns="False"
                    Background="Transparent"
                    ColumnWidth="SizeToCells"
                    HeadersVisibility="Column"
                    IsReadOnly="True"
                    ItemsSource="{Binding OperationCol}"
                    RowHeaderWidth="60"
                    ScrollViewer.HorizontalScrollBarVisibility="Auto"
                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                    SelectionMode="Extended">
                    <DataGrid.Columns>
                        <DataGridTextColumn
                            Width="100"
                            Binding="{Binding DeviceID}"
                            CellStyle="{StaticResource DataGridTextCenterCellStyle}"
                            Header="{ex:Language Key='反应器'}"
                            HeaderStyle="{StaticResource DataGridCenterColumnHeaderStyle}" />
                        <!--<DataGridTextColumn
                            Width="80"
                            Binding="{Binding Batch}"
                            CellStyle="{StaticResource DataGridTextCenterCellStyle}"
                            Header="{ex:Language Key='批次号'}"
                            HeaderStyle="{StaticResource DataGridCenterColumnHeaderStyle}" />-->
                        <!--<DataGridTextColumn
                            Width="200"
                            Binding="{Binding Module}"
                            CellStyle="{StaticResource DataGridTextCenterCellStyle}"
                            Header="{ex:Language Key='Module'}"
                            HeaderStyle="{StaticResource DataGridCenterColumnHeaderStyle}" />-->
                        <DataGridTextColumn
                            Width="400"
                            Binding="{Binding Remark}"
                            CellStyle="{StaticResource DataGridTextCenterCellStyle}"
                            Header="{ex:Language Key='操作详情'}"
                            HeaderStyle="{StaticResource DataGridCenterColumnHeaderStyle}" />
                        <DataGridTemplateColumn
                            Width="200"
                            CellStyle="{StaticResource DataGridTextCenterCellStyle}"
                            Header="{ex:Language Key='记录时间'}"
                            HeaderStyle="{StaticResource DataGridCenterColumnHeaderStyle}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DateTime, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <!--<DataGridTextColumn
                            Width="300"
                            Binding="{Binding Description}"
                            CellStyle="{StaticResource DataGridTextCenterCellStyle}"
                            Header="{ex:Language Key='Description'}"
                            HeaderStyle="{StaticResource DataGridCenterColumnHeaderStyle}" />-->
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Name="tabAlarm">
                <DataGrid
                    Name="dataGrid1"
                    hc:DataGridAttach.CanUnselectAllWithBlankArea="True"
                    hc:DataGridAttach.ShowRowNumber="True"
                    hc:DataGridAttach.ShowSelectAllButton="False"
                    AutoGenerateColumns="False"
                    Background="Transparent"
                    CanUserSortColumns="True"
                    ColumnWidth="SizeToCells"
                    FontSize="{DynamicResource NormalFontSize}"
                    HeadersVisibility="Column"
                    IsReadOnly="True"
                    ItemsSource="{Binding AlarmRecordCol}"
                    RowHeaderWidth="60"
                    ScrollViewer.HorizontalScrollBarVisibility="Auto"
                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                    SelectionMode="Extended"
                    Style="{StaticResource DataGridBaseStyle}">
                    <DataGrid.Columns>
                        <DataGridTextColumn
                            Width="100"
                            Binding="{Binding Reactor}"
                            CellStyle="{StaticResource DataGridTextCenterCellStyle}"
                            Header="{ex:Language Key='反应器'}"
                            HeaderStyle="{StaticResource DataGridCenterColumnHeaderStyle}" />
                        <DataGridTextColumn
                            Width="150"
                            Binding="{Binding Source}"
                            CellStyle="{StaticResource DataGridTextCenterCellStyle}"
                            Header="{ex:Language Key='报警源'}"
                            HeaderStyle="{StaticResource DataGridCenterColumnHeaderStyle}" />
                        <DataGridTextColumn
                            Width="150"
                            Binding="{Binding Module}"
                            CellStyle="{StaticResource DataGridTextCenterCellStyle}"
                            Header="{ex:Language Key='模块'}"
                            HeaderStyle="{StaticResource DataGridCenterColumnHeaderStyle}" />
                        <DataGridTextColumn
                            Width="100"
                            Binding="{Binding Grade}"
                            CellStyle="{StaticResource DataGridTextCenterCellStyle}"
                            Header="{ex:Language Key='等级'}"
                            HeaderStyle="{StaticResource DataGridCenterColumnHeaderStyle}" />
                        <DataGridTextColumn
                            Width="250"
                            Binding="{Binding Remark}"
                            CellStyle="{StaticResource DataGridTextCenterCellStyle}"
                            Header="{ex:Language Key='描述'}"
                            HeaderStyle="{StaticResource DataGridCenterColumnHeaderStyle}" />
                        <DataGridTemplateColumn
                            Width="200"
                            CellStyle="{StaticResource DataGridTextCenterCellStyle}"
                            Header="{ex:Language Key='报警时间'}"
                            HeaderStyle="{StaticResource DataGridCenterColumnHeaderStyle}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding AlarmTime, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn
                            Width="200"
                            CellStyle="{StaticResource DataGridTextCenterCellStyle}"
                            Header="{ex:Language Key='消除时间'}"
                            HeaderStyle="{StaticResource DataGridCenterColumnHeaderStyle}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding RemoveTime, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>
        <!--<hc:Pagination
            Name="pagination"
            Grid.Row="2"
            Margin="0,0,0,10"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            Background="Transparent"
            DataCountPerPage="{Binding DataCountPerPage}"
            IsJumpEnabled="True"
            MaxPageCount="{Binding PageCount}"
            MaxPageInterval="4"
            Visibility="Collapsed"
            PageIndex="{Binding PageIndex}">
            <hc:Interaction.Triggers>
                <hc:EventTrigger EventName="PageUpdated">
                    <hc:EventToCommand Command="{Binding PageUpdatedCommand}" PassEventArgsToCommand="True" />
                </hc:EventTrigger>
            </hc:Interaction.Triggers>
        </hc:Pagination>-->
    </Grid>
</UserControl>
