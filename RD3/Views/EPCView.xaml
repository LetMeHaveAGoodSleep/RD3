<UserControl
    x:Class="RD3.Views.EPCView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:local="clr-namespace:RD3.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:system="clr-namespace:System;assembly=netstandard"
    xmlns:viewmodels="clr-namespace:RD3.ViewModels"
    Width="165"
    Height="45"
    d:DataContext="{d:DesignInstance Type=viewmodels:EPCViewModel}"
    prism:ViewModelLocator.AutoWireViewModel="True"
    Background="Transparent"
    FontSize="{StaticResource NormalFontSize}"
    mc:Ignorable="d">
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="MouseUp">
            <i:InvokeCommandAction Command="{Binding EPCSettingCommand}" PassEventArgsToCommand="True" />
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <Border
        x:Name="borderMain"
        CornerRadius="24"
        Style="{StaticResource BorderHighlight}"
        Tag="{Binding CurrentDeviceParameter.EPCParam.RunningStr}">
        <StackPanel Margin="8,0,8,0" Orientation="Horizontal">
            <Image
                Width="18"
                Height="18"
                Source="/Images/Index/EPC.png" />
            <TextBlock
                Width="40"
                Margin="8,0,0,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontSize="{StaticResource NormalFontSize}"
                Text="EPC"
                TextWrapping="WrapWithOverflow" />
            <TextBlock
                Width="50"
                Margin="5,0,0,0"
                VerticalAlignment="Center"
                FontSize="{StaticResource SubHeadFontSize}"
                Text="{Binding CurrentDeviceParameter.EPCPressure}" />
            <TextBlock
                Margin="3,0,0,0"
                VerticalAlignment="Center"
                Text="psi" />
        </StackPanel>
    </Border>
</UserControl>
