<UserControl
    x:Class="RD3.Views.DOAssociateView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behavior="clr-namespace:RD3.Behaviors"
    xmlns:common="clr-namespace:RD3.Common"
    xmlns:cv="clr-namespace:RD3.Common.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ex="clr-namespace:LayUI.Wpf.Extensions;assembly=LayUI.Wpf.Extensions"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:local="clr-namespace:RD3.Views"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:share="clr-namespace:RD3.Shared;assembly=RD3.Shared"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    xmlns:vm="clr-namespace:RD3.ViewModels"
    xmlns:wpf="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
    Width="600"
    Height="300"
    d:DataContext="{d:DesignInstance Type=vm:DOAssociateViewModel}"
    Background="{StaticResource BackGroundBrush}"
    TextElement.FontFamily="{DynamicResource AppFontFamily}"
    TextElement.FontSize="{DynamicResource TextFontSize}"
    TextElement.FontWeight="Regular"
    TextElement.Foreground="{DynamicResource MaterialDesignBody}"
    TextOptions.TextFormattingMode="Ideal"
    TextOptions.TextRenderingMode="Auto"
    mc:Ignorable="d">
    <prism:Dialog.WindowStyle>
        <Style TargetType="Window">
            <Setter Property="SizeToContent" Value="WidthAndHeight" />
            <Setter Property="ResizeMode" Value="NoResize" />
            <Setter Property="prism:Dialog.WindowStartupLocation" Value="CenterOwner" />
            <Setter Property="Width" Value="{Binding FormWidth, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <Setter Property="Height" Value="{Binding FormHeight, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <Setter Property="Left" Value="{Binding LeftLocation, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <Setter Property="Top" Value="{Binding TopLocation, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <Setter Property="ShowInTaskbar" Value="True" />
            <Setter Property="AllowsTransparency" Value="False" />
            <Setter Property="WindowStyle" Value="SingleBorderWindow" />
            <Setter Property="WindowState" Value="{Binding FormState, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <Setter Property="Background" Value="{StaticResource BackGroundBrush}" />
            <Setter Property="Opacity" Value="1" />
            <Setter Property="Icon" Value="../Assets/logo.png" />
        </Style>
    </prism:Dialog.WindowStyle>
    <TabControl Style="{StaticResource TabControlInLine}">
        <TabItem Header="级联控制通气阶梯表">
            <Grid Margin="5">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="5" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <hc:UniformSpacingPanel Orientation="Vertical" Spacing="10">
                    <DockPanel LastChildFill="True">
                        <hc:UniformSpacingPanel
                            DockPanel.Dock="Right"
                            Orientation="Horizontal"
                            Spacing="5">
                            <DockPanel LastChildFill="False">
                                <Button
                                    Name="BtnAddRow"
                                    Height="30"
                                    VerticalAlignment="Bottom"
                                    hc:IconElement.Geometry="{StaticResource GeometryAdd}"
                                    Command="{Binding AddCommand}"
                                    Content="新增"
                                    Foreground="{StaticResource PrimaryBrush}" />
                            </DockPanel>
                            <DockPanel LastChildFill="False">
                                <Button
                                    Name="BtnDeleteRow"
                                    Height="30"
                                    VerticalAlignment="Bottom"
                                    hc:IconElement.Geometry="{StaticResource DeleteFillCircleGeometry}"
                                    Command="{Binding DeleteCommand}"
                                    CommandParameter="{Binding ElementName=dataGrid, Path=SelectedItem}"
                                    Content="删除"
                                    Foreground="{StaticResource PrimaryBrush}" />
                            </DockPanel>
                            <DockPanel LastChildFill="False">
                                <Button
                                    Name="BtnConfirm"
                                    Width="75"
                                    Height="30"
                                    VerticalAlignment="Bottom"
                                    Command="{Binding OKCommand}"
                                    Content="确定"
                                    Foreground="{StaticResource PrimaryBrush}" />
                            </DockPanel>
                        </hc:UniformSpacingPanel>
                        <hc:UniformSpacingPanel Orientation="Horizontal" Spacing="10">
                            <ComboBox
                                Width="100"
                                VerticalAlignment="Center"
                                hc:InfoElement.Title="{ex:Language Key='单位'}"
                                SelectedIndex="{Binding Param.Unit}"
                                Style="{StaticResource ComboBoxExtend}">
                                <ComboBoxItem Content="VVM" />
                                <ComboBoxItem Content="L/min" />
                            </ComboBox>
                            <TextBox
                                Width="100"
                                VerticalAlignment="Center"
                                hc:InfoElement.Title="{ex:Language Key='采样间隔(s)'}"
                                Style="{StaticResource TextBoxExtend}"
                                Text="{Binding Param.Interval, UpdateSourceTrigger=PropertyChanged}"
                                Visibility="Collapsed" />
                            <TextBox
                                Width="100"
                                VerticalAlignment="Center"
                                hc:InfoElement.Title="{ex:Language Key='死区'}"
                                Style="{StaticResource TextBoxExtend}"
                                Text="{Binding Param.DBand, UpdateSourceTrigger=PropertyChanged}"
                                Visibility="Collapsed" />
                            <TextBox
                                Width="100"
                                VerticalAlignment="Center"
                                hc:InfoElement.Title="{ex:Language Key='转速下限(rpm)'}"
                                Style="{StaticResource TextBoxExtend}"
                                Text="{Binding Param.AgitLowerLimit, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBox
                                Width="100"
                                VerticalAlignment="Center"
                                hc:InfoElement.Title="{ex:Language Key='转速上限(rpm)'}"
                                Style="{StaticResource TextBoxExtend}"
                                Text="{Binding Param.AgitUpperLimit, UpdateSourceTrigger=PropertyChanged}" />
                        </hc:UniformSpacingPanel>
                    </DockPanel>
                    <DockPanel LastChildFill="True" Visibility="Collapsed">
                        <CheckBox
                            Content="补料关联"
                            DockPanel.Dock="Right"
                            Style="{StaticResource MaterialDesignCheckBox}" />
                        <hc:UniformSpacingPanel Orientation="Horizontal" Spacing="10">
                            <CheckBox Content="温度关联" Style="{StaticResource MaterialDesignCheckBox}" />
                            <TextBox
                                Width="100"
                                hc:InfoElement.Title="{ex:Language Key='温度下限(℃)'}"
                                Style="{StaticResource TextBoxExtend}"
                                Text="{Binding Param.AgitUpperLimit, UpdateSourceTrigger=PropertyChanged}" />

                        </hc:UniformSpacingPanel>
                    </DockPanel>
                </hc:UniformSpacingPanel>
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="5" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <DataGrid
                        hc:DataGridAttach.CanUnselectAllWithBlankArea="False"
                        hc:DataGridAttach.ShowSelectAllButton="False"
                        AutoGenerateColumns="False"
                        Background="{StaticResource DefaultBrush}"
                        CanUserAddRows="False"
                        CanUserSortColumns="False"
                        ColumnWidth="SizeToHeader"
                        GridLinesVisibility="All"
                        HeadersVisibility="Column"
                        HorizontalGridLinesBrush="LightGray"
                        IsReadOnly="False"
                        ItemsSource="{Binding Param.AirCol}"
                        LoadingRow="DataGrid_LoadingRow"
                        RowHeaderWidth="0"
                        ScrollViewer.HorizontalScrollBarVisibility="Auto"
                        ScrollViewer.VerticalScrollBarVisibility="Auto"
                        SelectionMode="Single"
                        SelectionUnit="FullRow"
                        VerticalGridLinesBrush="LightGray">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Width="60" Header="序号">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding RelativeSource={RelativeSource AncestorType={x:Type DataGridRow}}, Path=Header}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn
                                Width="120"
                                Binding="{Binding VVM}"
                                CellStyle="{StaticResource DataGridTextCenterCellStyle}"
                                Header="通气量"
                                HeaderStyle="{StaticResource DataGridCenterColumnHeaderStyle}" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <DataGrid
                        Grid.Column="2"
                        hc:DataGridAttach.CanUnselectAllWithBlankArea="False"
                        hc:DataGridAttach.ShowSelectAllButton="False"
                        AutoGenerateColumns="False"
                        Background="{StaticResource DefaultBrush}"
                        CanUserAddRows="False"
                        CanUserSortColumns="False"
                        ColumnWidth="SizeToHeader"
                        GridLinesVisibility="All"
                        HeadersVisibility="Column"
                        HorizontalGridLinesBrush="LightGray"
                        IsReadOnly="False"
                        ItemsSource="{Binding Param.AirCol}"
                        LoadingRow="DataGrid_LoadingRow"
                        RowHeaderWidth="0"
                        ScrollViewer.HorizontalScrollBarVisibility="Auto"
                        ScrollViewer.VerticalScrollBarVisibility="Auto"
                        SelectionMode="Single"
                        SelectionUnit="FullRow"
                        VerticalGridLinesBrush="LightGray"
                        Visibility="Collapsed">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Width="60" Header="序号">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding RelativeSource={RelativeSource AncestorType={x:Type DataGridRow}}, Path=Header}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn
                                Width="120"
                                Binding="{Binding VVM}"
                                CellStyle="{StaticResource DataGridTextCenterCellStyle}"
                                Header="氧气量"
                                HeaderStyle="{StaticResource DataGridCenterColumnHeaderStyle}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Grid>
        </TabItem>
        <TabItem Header="Mid-ranging控制" Visibility="Collapsed">
            <hc:UniformSpacingPanel
                Margin="5"
                HorizontalAlignment="Center"
                Orientation="Vertical"
                Spacing="10">
                <DockPanel LastChildFill="False">
                    <TextBox
                        Width="100"
                        hc:InfoElement.Title="{ex:Language Key='时间常数'}"
                        Style="{StaticResource TextBoxExtend}"
                        Text="{Binding MidRanging.TempLowerLimit, UpdateSourceTrigger=PropertyChanged}" />
                    <CheckBox
                        Content="补料关联"
                        DockPanel.Dock="Right"
                        Style="{StaticResource MaterialDesignCheckBox}" />
                </DockPanel>
                <hc:UniformSpacingPanel Orientation="Horizontal" Spacing="10">
                    <TextBox
                        Width="100"
                        VerticalAlignment="Center"
                        hc:InfoElement.Title="{ex:Language Key='转速下限(rpm)'}"
                        Style="{StaticResource TextBoxExtend}"
                        Text="{Binding MidRanging.AgitLowerLimit, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBox
                        Width="100"
                        VerticalAlignment="Center"
                        hc:InfoElement.Title="{ex:Language Key='转速上限(rpm)'}"
                        Style="{StaticResource TextBoxExtend}"
                        Text="{Binding MidRanging.AgitUpperLimit, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBox
                        Width="100"
                        VerticalAlignment="Center"
                        hc:InfoElement.Title="{ex:Language Key='转速高限(rpm)'}"
                        Style="{StaticResource TextBoxExtend}"
                        Text="{Binding MidRanging.AgitHigh, UpdateSourceTrigger=PropertyChanged}" />
                </hc:UniformSpacingPanel>
                <hc:UniformSpacingPanel Orientation="Horizontal" Spacing="10">
                    <ComboBox
                        Width="100"
                        VerticalAlignment="Center"
                        hc:InfoElement.Title="{ex:Language Key='单位'}"
                        SelectedIndex="{Binding MidRanging.Unit}"
                        Style="{StaticResource ComboBoxExtend}">
                        <ComboBoxItem Content="VVM" />
                        <ComboBoxItem Content="L/min" />
                    </ComboBox>
                    <TextBox
                        Width="100"
                        VerticalAlignment="Center"
                        hc:InfoElement.Title="{ex:Language Key='通气下限'}"
                        Style="{StaticResource TextBoxExtend}"
                        Text="{Binding MidRanging.InitialAir, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBox
                        Width="100"
                        VerticalAlignment="Center"
                        hc:InfoElement.Title="{ex:Language Key='通气上限'}"
                        Style="{StaticResource TextBoxExtend}"
                        Text="{Binding MidRanging.AirUpperLimit, UpdateSourceTrigger=PropertyChanged}" />
                </hc:UniformSpacingPanel>
                <hc:UniformSpacingPanel Orientation="Horizontal" Spacing="10">
                    <CheckBox Content="氧气关联" Style="{StaticResource MaterialDesignCheckBox}" />
                    <TextBox
                        Width="100"
                        VerticalAlignment="Center"
                        hc:InfoElement.Title="{ex:Language Key='氧气下限'}"
                        Style="{StaticResource TextBoxExtend}"
                        Text="{Binding MidRanging.InitialAir, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBox
                        Width="100"
                        VerticalAlignment="Center"
                        hc:InfoElement.Title="{ex:Language Key='氧气上限'}"
                        Style="{StaticResource TextBoxExtend}"
                        Text="{Binding MidRanging.AirUpperLimit, UpdateSourceTrigger=PropertyChanged}" />
                </hc:UniformSpacingPanel>
                <DockPanel LastChildFill="False">
                    <hc:UniformSpacingPanel
                        DockPanel.Dock="Left"
                        Orientation="Horizontal"
                        Spacing="10">
                        <CheckBox Content="温度关联" Style="{StaticResource MaterialDesignCheckBox}" />
                        <TextBox
                            Width="100"
                            VerticalAlignment="Center"
                            hc:InfoElement.Title="{ex:Language Key='温度下限(℃)'}"
                            Style="{StaticResource TextBoxExtend}"
                            Text="{Binding MidRanging.TempLowerLimit, UpdateSourceTrigger=PropertyChanged}" />
                    </hc:UniformSpacingPanel>
                    <DockPanel
                        Margin="10,0,0,0"
                        DockPanel.Dock="Left"
                        LastChildFill="False">
                        <Button
                            Width="100"
                            Height="28"
                            VerticalAlignment="Bottom"
                            Command="{Binding OKCommand}"
                            Content="确定"
                            Style="{StaticResource ButtonPrimary}" />
                    </DockPanel>
                </DockPanel>
            </hc:UniformSpacingPanel>
        </TabItem>
    </TabControl>

</UserControl>
