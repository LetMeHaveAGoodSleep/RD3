<UserControl
    x:Class="RD3.Views.PHControlView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ex="clr-namespace:LayUI.Wpf.Extensions;assembly=LayUI.Wpf.Extensions"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:local="clr-namespace:RD3.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:rd3="clr-namespace:RD3"
    xmlns:viewmodels="clr-namespace:RD3.ViewModels"
    Width="340"
    Height="455"
    d:DataContext="{d:DesignInstance Type=viewmodels:PHControlViewModel}"
    rd3:DraggableUserControlAttach.IsDraggable="True"
    TextElement.FontFamily="{DynamicResource AppFontFamily}"
    TextElement.FontSize="{DynamicResource SubHeadFontSize}"
    TextElement.FontWeight="Regular"
    TextElement.Foreground="{DynamicResource MaterialDesignBody}"
    TextOptions.TextFormattingMode="Ideal"
    TextOptions.TextRenderingMode="Auto"
    mc:Ignorable="d">
    <prism:Dialog.WindowStyle>
        <Style TargetType="Window">
            <Setter Property="SizeToContent" Value="WidthAndHeight" />
            <Setter Property="ResizeMode" Value="NoResize" />
            <Setter Property="prism:Dialog.WindowStartupLocation" Value="CenterScreen" />
            <Setter Property="Width" Value="{Binding FormWidth, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <Setter Property="Height" Value="{Binding FormHeight, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <Setter Property="Left" Value="{Binding LeftLocation, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <Setter Property="Top" Value="{Binding TopLocation, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <Setter Property="ShowInTaskbar" Value="False" />
            <Setter Property="AllowsTransparency" Value="True" />
            <Setter Property="WindowStyle" Value="None" />
            <Setter Property="WindowState" Value="{Binding FormState, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <Setter Property="Background" Value="{StaticResource BackGroundBrush}" />
            <Setter Property="Opacity" Value="1" />
        </Style>
    </prism:Dialog.WindowStyle>
    <Border Background="{StaticResource CloudDrawingBrush}" Style="{StaticResource BorderForm}">
        <Grid Margin="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="30" />
                <RowDefinition Height="30" />
                <RowDefinition Height="30" />
                <RowDefinition Height="30" />
                <RowDefinition Height="30" />
                <RowDefinition Height="30" />
                <RowDefinition Height="30" />
                <RowDefinition Height="30" />
                <RowDefinition Height="30" />
                <RowDefinition Height="30" />
                <RowDefinition Height="30" />
                <RowDefinition Height="30" />
                <RowDefinition Height="30" />
                <RowDefinition Height="30" />
                <RowDefinition Height="30" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition Width="70" />
                </Grid.ColumnDefinitions>
                <Label Grid.Column="0" Width="90">酸</Label>
                <TextBox
                    Name="acidbufferName"
                    Grid.Column="1"
                    Width="80"
                    Margin="1"
                    Text="{Binding phInfo.acidbufferName}" />
                <TextBox
                    Name="acidbufferValue"
                    Grid.Column="2"
                    Width="80"
                    Margin="1"
                    Text="{Binding phInfo.acidbufferValue}" />
                <Label Grid.Column="3">mol/L</Label>

            </Grid>


            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition Width="70" />
                </Grid.ColumnDefinitions>
                <Label Grid.Column="0" Width="90">盐</Label>
                <TextBox
                    Name="saltbufferName"
                    Grid.Column="1"
                    Width="80"
                    Margin="1"
                    Text="{Binding phInfo.saltbufferName}" />
                <TextBox
                    Name="saltbufferValue"
                    Grid.Column="2"
                    Width="80"
                    Margin="1"
                    Text="{Binding phInfo.saltbufferValue}" />
                <Label Grid.Column="3">mol/L</Label>

            </Grid>
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition Width="70" />
                </Grid.ColumnDefinitions>
                <Label Grid.Column="0">工作温度</Label>
                <TextBox
                    Name="workTemp"
                    Grid.Column="1"
                    Width="80"
                    Margin="1"
                    Text="{Binding phInfo.workTemp}" />
                <Label Grid.Column="3" Width="70">℃</Label>

            </Grid>
            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition Width="70" />
                </Grid.ColumnDefinitions>
                <Label Grid.Column="0">发酵体积</Label>
                <TextBox
                    Name="V"
                    Grid.Column="1"
                    Width="80"
                    Margin="1"
                    Text="{Binding phInfo.V}" />
                <Label Grid.Column="3" Width="70">L</Label>

            </Grid>
            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition Width="70" />
                </Grid.ColumnDefinitions>
                <Label Grid.Column="0" Width="90">pka0</Label>
                <TextBox
                    Name="pka0"
                    Grid.Column="1"
                    Width="80"
                    Margin="1"
                    Text="{Binding phInfo.pka0}" />
            </Grid>
            <Grid Grid.Row="5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition Width="70" />
                </Grid.ColumnDefinitions>
                <Label Grid.Column="0" Width="90">pka0温度</Label>
                <TextBox
                    Name="pka0_temp"
                    Grid.Column="1"
                    Width="80"
                    Margin="1"
                    Text="{Binding phInfo.pka0_temp}" />
                <Label Grid.Column="3" Width="70">℃</Label>
            </Grid>
            <Grid Grid.Row="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition Width="70" />
                </Grid.ColumnDefinitions>
                <Label Grid.Column="0" Width="90">温度系数</Label>
                <TextBox
                    Name="tempCoefficient"
                    Grid.Column="1"
                    Width="80"
                    Margin="1"
                    Text="{Binding phInfo.tempCoefficient}" />
                <Label Grid.Column="2" Width="70">每度</Label>
            </Grid>
            <Grid Grid.Row="7">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition Width="70" />
                </Grid.ColumnDefinitions>
                <Label Grid.Column="0" Width="90">酸浓度</Label>
                <TextBox
                    Name="acidValue"
                    Grid.Column="1"
                    Width="80"
                    Margin="1"
                    Text="{Binding phInfo.acidValue}" />
                <Label Grid.Column="2" Width="70">mol/L</Label>
            </Grid>
            <Grid Grid.Row="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition Width="70" />
                </Grid.ColumnDefinitions>
                <Label Grid.Column="0" Width="90">碱浓度</Label>
                <TextBox
                    Name="alkaliValue"
                    Grid.Column="1"
                    Width="80"
                    Margin="1"
                    Text="{Binding phInfo.alkaliValue}" />
                <Label Grid.Column="2" Width="70">mol/L</Label>
            </Grid>
            <Grid Grid.Row="9">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="80" />
                </Grid.ColumnDefinitions>
                <Label Width="90">工作pH</Label>
                <TextBox
                    Name="ph0"
                    Grid.Column="1"
                    Grid.ColumnSpan="2"
                    Width="80"
                    Margin="1,1,1,1"
                    Text="{Binding phInfo.ph0}" />

            </Grid>
            <Grid Grid.Row="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="240" />
                </Grid.ColumnDefinitions>
                <Label Width="90">修订buffer</Label>
                <TextBox
                    Name="d_buffer"
                    Grid.Column="1"
                    Grid.ColumnSpan="2"
                    Width="230"
                    Margin="1"
                    Text="{Binding phInfo.d_buffer}" />

            </Grid>
            <Grid Grid.Row="11">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="240" />
                </Grid.ColumnDefinitions>
                <Label Grid.Column="0" Width="90">aslope</Label>
                <TextBox
                    Name="aslope"
                    Grid.Column="1"
                    Width="230"
                    Margin="1"
                    Text="{Binding phInfo.aslope}" />
            </Grid>
            <Grid Grid.Row="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="240" />
                </Grid.ColumnDefinitions>
                <Label Width="90">bslope</Label>
                <TextBox
                    Name="bslope"
                    Grid.Column="1"
                    Grid.ColumnSpan="2"
                    Width="230"
                    Margin="1"
                    Text="{Binding phInfo.bslope}" />
            </Grid>
            <Grid Grid.Row="13">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition Width="70" />
                </Grid.ColumnDefinitions>
                <Label Grid.Column="0" Width="90">T90</Label>
                <TextBox
                    Name="T90"
                    Grid.Column="1"
                    Grid.ColumnSpan="1"
                    Width="80"
                    Margin="1"
                    Text="{Binding phInfo.T90}" />
                <Label
                    Grid.Column="2"
                    Grid.ColumnSpan="2"
                    Width="70"
                    Margin="1">
                    分
                </Label>
            </Grid>
            <Grid Grid.Row="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40" />
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="100" />
                </Grid.ColumnDefinitions>
                <Button
                    Name="btnCalculate"
                    Grid.Column="1"
                    Width="90"
                    Click="btnCalculate_Click">
                    计算
                </Button>
                <Button
                    Name="btnSave"
                    Grid.Column="2"
                    Width="90"
                    Click="btnSave_Click">
                    保存
                </Button>
                <Button
                    Name="btnCancel"
                    Grid.Column="3"
                    Width="90"
                    Command="{Binding CancelCommand}">
                    关闭
                </Button>
            </Grid>
        </Grid>

    </Border>
</UserControl>
