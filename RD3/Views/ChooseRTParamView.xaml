<UserControl
    x:Class="RD3.Views.ChooseRTParamView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:local="clr-namespace:RD3.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:viewmodels="clr-namespace:RD3.ViewModels"
    Width="700"
    Height="450"
    d:DataContext="{d:DesignInstance Type=viewmodels:ChooseRTParamViewModel}"
    prism:ViewModelLocator.AutoWireViewModel="True"
    Background="{StaticResource RegionBackgroundBrush}"
    mc:Ignorable="d">
    <prism:Dialog.WindowStyle>
        <Style TargetType="Window">
            <Setter Property="SizeToContent" Value="WidthAndHeight" />
            <Setter Property="ResizeMode" Value="NoResize" />
            <Setter Property="prism:Dialog.WindowStartupLocation" Value="CenterScreen" />
            <Setter Property="Width" Value="{Binding FormWidth, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <Setter Property="Height" Value="{Binding FormHeight, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <Setter Property="Left" Value="{Binding LeftLocation, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <Setter Property="Top" Value="{Binding TopLocation, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <Setter Property="ShowInTaskbar" Value="True" />
            <Setter Property="AllowsTransparency" Value="False" />
            <Setter Property="WindowStyle" Value="ThreeDBorderWindow" />
            <Setter Property="WindowState" Value="{Binding FormState, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <Setter Property="Opacity" Value="1" />
            <Setter Property="Background" Value="{StaticResource RegionBackgroundBrush}" />
        </Style>
    </prism:Dialog.WindowStyle>
    <DockPanel Margin="10" LastChildFill="True">
        <DockPanel DockPanel.Dock="Top" LastChildFill="False">
            <hc:UniformSpacingPanel
                DockPanel.Dock="Right"
                Orientation="Horizontal"
                Spacing="10">
                <Button
                    Width="80"
                    Height="30"
                    Command="{Binding AddCommand}"
                    Content="新增"
                    Style="{StaticResource PrimaryCommonButton}" />
                <Button
                    Width="80"
                    Height="30"
                    Content="删除数据"
                    DockPanel.Dock="Right"
                    Style="{StaticResource PrimaryCommonButton}">
                    <i:Interaction.Triggers>
                        <i:EventTrigger EventName="Click">
                            <i:InvokeCommandAction Command="{Binding DeleteCommand}" CommandParameter="{Binding SelectedItem, ElementName=dataGrid}" />
                        </i:EventTrigger>
                    </i:Interaction.Triggers>
                </Button>
            </hc:UniformSpacingPanel>
        </DockPanel>
        <DataGrid
            Name="dataGrid"
            Grid.Row="1"
            AutoGenerateColumns="False"
            CanUserAddRows="False"
            CanUserSortColumns="False"
            CellStyle="{StaticResource DataGridTextCenterCellStyle}"
            ColumnHeaderHeight="30"
            ColumnWidth="SizeToHeader"
            GridLinesVisibility="All"
            HeadersVisibility="Column"
            HorizontalGridLinesBrush="LightGray"
            IsReadOnly="False"
            ItemsSource="{Binding ReportNodes}"
            RowHeaderWidth="100"
            RowHeight="35"
            RowStyle="{StaticResource PrimaryDataGridRowStyle}"
            ScrollViewer.HorizontalScrollBarVisibility="Auto"
            ScrollViewer.VerticalScrollBarVisibility="Auto"
            SelectionMode="Single"
            SelectionUnit="FullRow"
            VerticalGridLinesBrush="LightGray">
            <DataGrid.Columns>
                <!--  列表  -->
                <DataGridCheckBoxColumn
                    Width="100"
                    Binding="{Binding Used}"
                    CanUserSort="False"
                    Header="是否启用"
                    HeaderStyle="{StaticResource DataGridCenterColumnHeaderStyle}"
                    IsReadOnly="False" />
                <DataGridTextColumn
                    Width="120"
                    Binding="{Binding ShowName}"
                    CanUserSort="False"
                    Header="显示名称"
                    HeaderStyle="{StaticResource DataGridCenterColumnHeaderStyle}"
                    IsReadOnly="False" />
                <DataGridComboBoxColumn
                    x:Name="colFieldName"
                    Width="150"
                    CanUserSort="False"
                    Header="关联"
                    HeaderStyle="{StaticResource DataGridCenterColumnHeaderStyle}"
                    IsReadOnly="False"
                    SelectedValueBinding="{Binding FieldName, UpdateSourceTrigger=PropertyChanged}" />
                <DataGridTextColumn
                    Width="150"
                    Binding="{Binding TypeName}"
                    CanUserSort="False"
                    Header="数据类型"
                    HeaderStyle="{StaticResource DataGridCenterColumnHeaderStyle}"
                    IsReadOnly="False" />
                <DataGridTextColumn
                    Width="80"
                    Binding="{Binding Unit}"
                    CanUserSort="False"
                    Header="单位"
                    HeaderStyle="{StaticResource DataGridCenterColumnHeaderStyle}"
                    IsReadOnly="False" />
                <DataGridTextColumn
                    Width="60"
                    Binding="{Binding Width}"
                    CanUserSort="False"
                    Header="宽度"
                    HeaderStyle="{StaticResource DataGridCenterColumnHeaderStyle}"
                    IsReadOnly="False" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>

</UserControl>
