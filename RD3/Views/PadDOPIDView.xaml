<UserControl
    x:Class="RD3.Views.PadDOPIDView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:local="clr-namespace:RD3.Views"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:share="clr-namespace:RD3.Shared;assembly=RD3.Shared"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    xmlns:viewmodels="clr-namespace:RD3.ViewModels"
    Width="450"
    Height="550"
    d:DataContext="{d:DesignInstance Type=viewmodels:PadDOPIDViewModel}"
    prism:ViewModelLocator.AutoWireViewModel="True"
    Background="{StaticResource BackGroundBrush}"
    FontSize="{StaticResource SubHeadFontSize}"
    mc:Ignorable="d">
    <GroupBox
        Header="PID参数"
        Style="{StaticResource MaterialDesignGroupBox}"
        Visibility="{Binding CurrentDeviceParameter.PHParam.PHControlMode, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=PID, UpdateSourceTrigger=PropertyChanged}">
        <hc:UniformSpacingPanel Orientation="Vertical" Spacing="10">
            <GroupBox Header="正向(+)" Style="{StaticResource GroupBoxTab.Small}">
                <hc:UniformSpacingPanel Orientation="Horizontal" Spacing="10">
                    <TextBox
                        Width="90"
                        materialDesign:HintAssist.Hint="比例P"
                        Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                        Text="{Binding CurrentDeviceParameter.DOParam.DirectPID.P, StringFormat={}{0:F2}}" />
                    <TextBox
                        Width="90"
                        materialDesign:HintAssist.Hint="积分I"
                        Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                        Text="{Binding CurrentDeviceParameter.DOParam.DirectPID.I, StringFormat={}{0:F2}}" />
                    <TextBox
                        Width="90"
                        materialDesign:HintAssist.Hint="微分D"
                        Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                        Text="{Binding CurrentDeviceParameter.DOParam.DirectPID.D, StringFormat={}{0:F2}}" />
                    <TextBox
                        Width="90"
                        materialDesign:HintAssist.Hint="死区"
                        Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                        Text="{Binding CurrentDeviceParameter.DOParam.DirectPID.DeadArea, StringFormat={}{0:F2}}" />
                </hc:UniformSpacingPanel>
            </GroupBox>
            <GroupBox Header="反向(-)" Style="{StaticResource GroupBoxTab.Small}">
                <hc:UniformSpacingPanel Orientation="Horizontal" Spacing="10">
                    <TextBox
                        Width="90"
                        materialDesign:HintAssist.Hint="比例P"
                        Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                        Text="{Binding CurrentDeviceParameter.DOParam.ReversePID.P, StringFormat={}{0:F2}}" />
                    <TextBox
                        Width="90"
                        materialDesign:HintAssist.Hint="积分I"
                        Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                        Text="{Binding CurrentDeviceParameter.DOParam.ReversePID.I, StringFormat={}{0:F2}}" />
                    <TextBox
                        Width="90"
                        materialDesign:HintAssist.Hint="微分D"
                        Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                        Text="{Binding CurrentDeviceParameter.DOParam.ReversePID.D, StringFormat={}{0:F2}}" />
                    <TextBox
                        Width="90"
                        materialDesign:HintAssist.Hint="死区"
                        Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                        Text="{Binding CurrentDeviceParameter.DOParam.ReversePID.DeadArea, StringFormat={}{0:F2}}" />
                </hc:UniformSpacingPanel>
            </GroupBox>
        </hc:UniformSpacingPanel>
    </GroupBox>
</UserControl>
