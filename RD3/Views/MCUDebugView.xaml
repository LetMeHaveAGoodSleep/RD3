<UserControl
    x:Class="RD3.Views.MCUDebugView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behavior="clr-namespace:RD3.Behaviors"
    xmlns:common="clr-namespace:RD3.Common"
    xmlns:cv="clr-namespace:RD3.Common.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ex="clr-namespace:LayUI.Wpf.Extensions;assembly=LayUI.Wpf.Extensions"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:local="clr-namespace:RD3.Views"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:share="clr-namespace:RD3.Shared;assembly=RD3.Shared"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    xmlns:vm="clr-namespace:RD3.ViewModels"
    xmlns:wpf="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
    Width="1000"
    Height="800"
    d:DataContext="{d:DesignInstance Type=vm:MCUDebugViewModel}"
    d:DesignHeight="1900"
    d:DesignWidth="1440"
    TextElement.FontFamily="{DynamicResource AppFontFamily}"
    TextElement.FontSize="{DynamicResource TextFontSize}"
    TextElement.FontWeight="Regular"
    TextElement.Foreground="{DynamicResource MaterialDesignBody}"
    TextOptions.TextFormattingMode="Ideal"
    TextOptions.TextRenderingMode="Auto"
    mc:Ignorable="d">
    <prism:Dialog.WindowStyle>
        <Style TargetType="Window">
            <Setter Property="SizeToContent" Value="WidthAndHeight" />
            <Setter Property="ResizeMode" Value="NoResize" />
            <Setter Property="prism:Dialog.WindowStartupLocation" Value="CenterScreen" />
            <Setter Property="Width" Value="{Binding FormWidth, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <Setter Property="Height" Value="{Binding FormHeight, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <Setter Property="Left" Value="{Binding LeftLocation, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <Setter Property="Top" Value="{Binding TopLocation, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <Setter Property="ShowInTaskbar" Value="True" />
            <Setter Property="AllowsTransparency" Value="False" />
            <Setter Property="WindowStyle" Value="SingleBorderWindow" />
            <Setter Property="WindowState" Value="{Binding FormState, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <Setter Property="Background" Value="{StaticResource BackGroundBrush}" />
            <Setter Property="Opacity" Value="1" />
            <Setter Property="Icon" Value="../Assets/logo.png" />
        </Style>
    </prism:Dialog.WindowStyle>
    <UserControl.Resources>
        <ObjectDataProvider
            x:Key="DataFromEnum"
            MethodName="GetValues"
            ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="share:PumpControlMode" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
        <ObjectDataProvider
            x:Key="DataFromEnum1"
            MethodName="GetValues"
            ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="share:SwitchMode" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
        <ObjectDataProvider
            x:Key="DataFromEnum3"
            MethodName="GetValues"
            ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="share:MCUBoardType" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
        <ObjectDataProvider
            x:Key="DataFromEnum4"
            MethodName="GetValues"
            ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="share:ClearModule" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
        <ObjectDataProvider
            x:Key="DataFromEnum5"
            MethodName="GetValues"
            ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="share:DebugMode" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
        <ObjectDataProvider
            x:Key="DataFromEnum6"
            MethodName="GetValues"
            ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="share:SensorCorrectMode" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
        <ObjectDataProvider
            x:Key="DataFromEnum7"
            MethodName="GetValues"
            ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="share:TwoPointCorrectParam" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
        <ObjectDataProvider
            x:Key="DataFromEnum8"
            MethodName="GetValues"
            ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="share:PeristalticCalibrationParam" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
        <ObjectDataProvider
            x:Key="DataFromEnum9"
            MethodName="GetValues"
            ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="share:PeristalticPump" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
        <ObjectDataProvider
            x:Key="DataFromEnum10"
            MethodName="GetValues"
            ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="share:GasType" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
    </UserControl.Resources>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition />
        </Grid.RowDefinitions>
        <hc:UniformSpacingPanel
            Margin="0,0,0,5"
            Orientation="Horizontal"
            Spacing="10">
            <hc:CheckComboBox
                Name="CmbReactor"
                Width="400"
                hc:InfoElement.ShowClearButton="True"
                ItemsSource="{Binding Instruments}"
                SelectionChanged="CheckComboBox_SelectionChanged"
                SelectionMode="Multiple"
                ShowSelectAllButton="True" />
        </hc:UniformSpacingPanel>
        <TabControl Grid.Row="1">
            <TabItem Header="{ex:Language Key='Parameter Setting'}">
                <Border Effect="{StaticResource EffectShadow1}">
                    <hc:ScrollViewer
                        hc:ScrollViewerAttach.AutoHide="True"
                        hc:ScrollViewerAttach.Orientation="Vertical"
                        HorizontalScrollBarVisibility="Auto"
                        VerticalScrollBarVisibility="Auto">
                        <DockPanel LastChildFill="True">
                            <hc:UniformSpacingPanel Margin="5" Spacing="10">
                                <hc:UniformSpacingPanel
                                    ChildWrapping="Wrap"
                                    Orientation="Vertical"
                                    Spacing="20">
                                    <hc:UniformSpacingPanel Orientation="Horizontal" Spacing="10">
                                        <TextBox
                                            Width="100"
                                            hc:InfoElement.Title="{ex:Language Key='温度设定值'}"
                                            Style="{StaticResource TextBoxExtend}"
                                            Text="{Binding TempParam.Temp_PV}" />
                                        <CheckBox
                                            Margin="0,15,0,0"
                                            Content="温度使能"
                                            IsChecked="{Binding TempParam.IsEnable}" />
                                        <!--<TextBox
                                            Width="100"
                                            hc:InfoElement.Title="{ex:Language Key='Lower limit'}"
                                            Style="{StaticResource TextBoxExtend}"
                                            Text="{Binding TempParam.LowerLimit}" />
                                        <TextBox
                                            Width="100"
                                            hc:InfoElement.Title="{ex:Language Key='Upper limit'}"
                                            Style="{StaticResource TextBoxExtend}"
                                            Text="{Binding TempParam.UpperLimit}" />-->
                                        <Button
                                            Width="80"
                                            Height="30"
                                            Margin="0,20,0,0"
                                            hc:BorderElement.CornerRadius="{StaticResource DefaultCornerRadius}"
                                            Command="{Binding ReadCommand}"
                                            CommandParameter="1"
                                            Content="{ex:Language Key='Read'}" />
                                        <Button
                                            Width="80"
                                            Height="30"
                                            Margin="0,20,0,0"
                                            hc:BorderElement.CornerRadius="{StaticResource DefaultCornerRadius}"
                                            Command="{Binding SetCommand}"
                                            CommandParameter="1"
                                            Content="{ex:Language Key='Set'}" />
                                    </hc:UniformSpacingPanel>
                                    <hc:UniformSpacingPanel Orientation="Horizontal" Spacing="10">
                                        <TextBox
                                            Width="100"
                                            hc:InfoElement.Title="{ex:Language Key='转速设定值'}"
                                            Style="{StaticResource TextBoxExtend}"
                                            Text="{Binding AgitParam.Agit_PV}" />
                                        <Button
                                            Width="80"
                                            Height="30"
                                            Margin="0,20,0,0"
                                            hc:BorderElement.CornerRadius="{StaticResource DefaultCornerRadius}"
                                            Command="{Binding ReadCommand}"
                                            CommandParameter="2"
                                            Content="{ex:Language Key='Read'}" />
                                        <Button
                                            Width="80"
                                            Height="30"
                                            Margin="0,20,0,0"
                                            hc:BorderElement.CornerRadius="{StaticResource DefaultCornerRadius}"
                                            Command="{Binding SetCommand}"
                                            CommandParameter="2"
                                            Content="{ex:Language Key='Set'}" />
                                    </hc:UniformSpacingPanel>
                                    <GroupBox Header="{ex:Language Key='Peristaltic pump'}" Style="{StaticResource MaterialDesignCardGroupBox}">
                                        <hc:UniformSpacingPanel Orientation="Vertical" Spacing="10">
                                            <hc:UniformSpacingPanel Orientation="Horizontal" Spacing="10">
                                                <hc:UniformSpacingPanel Orientation="Horizontal" Spacing="10">
                                                    <hc:ComboBox
                                                        hc:InfoElement.Title="{ex:Language Key='Control Mode'}"
                                                        ItemsSource="{Binding Source={StaticResource DataFromEnum}}"
                                                        SelectedItem="{Binding AcidParam.ControlMode}" />
                                                    <TextBox
                                                        Width="100"
                                                        hc:InfoElement.Title="{ex:Language Key='泵1流速'}"
                                                        Style="{StaticResource TextBoxExtend}"
                                                        Text="{Binding AcidParam.FlowSpeed}" />
                                                    <TextBox
                                                        Width="100"
                                                        hc:InfoElement.Title="{ex:Language Key='总量'}"
                                                        Style="{StaticResource TextBoxExtend}"
                                                        Text="{Binding AcidParam.FlowCapacity}" />
                                                    <Button
                                                        Width="80"
                                                        Height="30"
                                                        Margin="0,20,0,0"
                                                        hc:BorderElement.CornerRadius="{StaticResource DefaultCornerRadius}"
                                                        Command="{Binding ReadCommand}"
                                                        CommandParameter="3,1"
                                                        Content="{ex:Language Key='Read'}" />
                                                    <Button
                                                        Width="80"
                                                        Height="30"
                                                        Margin="0,20,0,0"
                                                        hc:BorderElement.CornerRadius="{StaticResource DefaultCornerRadius}"
                                                        Command="{Binding SetCommand}"
                                                        CommandParameter="3,1"
                                                        Content="{ex:Language Key='Set'}" />
                                                </hc:UniformSpacingPanel>
                                                <hc:UniformSpacingPanel Orientation="Horizontal" Spacing="10">
                                                    <hc:ComboBox
                                                        hc:InfoElement.Title="{ex:Language Key='Control Mode'}"
                                                        ItemsSource="{Binding Source={StaticResource DataFromEnum}}"
                                                        SelectedItem="{Binding BaseParam.ControlMode}" />
                                                    <TextBox
                                                        Width="100"
                                                        hc:InfoElement.Title="{ex:Language Key='泵2流速'}"
                                                        Style="{StaticResource TextBoxExtend}"
                                                        Text="{Binding BaseParam.FlowSpeed}" />
                                                    <TextBox
                                                        Width="100"
                                                        hc:InfoElement.Title="{ex:Language Key='总量'}"
                                                        Style="{StaticResource TextBoxExtend}"
                                                        Text="{Binding BaseParam.FlowCapacity}" />
                                                    <Button
                                                        Width="80"
                                                        Height="30"
                                                        Margin="0,20,0,0"
                                                        hc:BorderElement.CornerRadius="{StaticResource DefaultCornerRadius}"
                                                        Command="{Binding ReadCommand}"
                                                        CommandParameter="3,2"
                                                        Content="{ex:Language Key='Read'}" />
                                                    <Button
                                                        Width="80"
                                                        Height="30"
                                                        Margin="0,20,0,0"
                                                        hc:BorderElement.CornerRadius="{StaticResource DefaultCornerRadius}"
                                                        Command="{Binding SetCommand}"
                                                        CommandParameter="3,2"
                                                        Content="{ex:Language Key='Set'}" />
                                                </hc:UniformSpacingPanel>
                                            </hc:UniformSpacingPanel>
                                            <hc:UniformSpacingPanel Orientation="Horizontal" Spacing="10">
                                                <hc:UniformSpacingPanel Orientation="Horizontal" Spacing="10">
                                                    <hc:ComboBox
                                                        hc:InfoElement.Title="{ex:Language Key='Control Mode'}"
                                                        ItemsSource="{Binding Source={StaticResource DataFromEnum}}"
                                                        SelectedItem="{Binding FeedParam.ControlMode}" />
                                                    <TextBox
                                                        Width="100"
                                                        hc:InfoElement.Title="{ex:Language Key='泵3流速'}"
                                                        Style="{StaticResource TextBoxExtend}"
                                                        Text="{Binding FeedParam.FlowSpeed}" />
                                                    <TextBox
                                                        Width="100"
                                                        hc:InfoElement.Title="{ex:Language Key='总量'}"
                                                        Style="{StaticResource TextBoxExtend}"
                                                        Text="{Binding FeedParam.FlowCapacity}" />
                                                    <Button
                                                        Width="80"
                                                        Height="30"
                                                        Margin="0,20,0,0"
                                                        hc:BorderElement.CornerRadius="{StaticResource DefaultCornerRadius}"
                                                        Command="{Binding ReadCommand}"
                                                        CommandParameter="3,3"
                                                        Content="{ex:Language Key='Read'}" />
                                                    <Button
                                                        Width="80"
                                                        Height="30"
                                                        Margin="0,20,0,0"
                                                        hc:BorderElement.CornerRadius="{StaticResource DefaultCornerRadius}"
                                                        Command="{Binding SetCommand}"
                                                        CommandParameter="3,3"
                                                        Content="{ex:Language Key='Set'}" />
                                                </hc:UniformSpacingPanel>
                                                <hc:UniformSpacingPanel Orientation="Horizontal" Spacing="10">
                                                    <hc:ComboBox
                                                        hc:InfoElement.Title="{ex:Language Key='Control Mode'}"
                                                        ItemsSource="{Binding Source={StaticResource DataFromEnum}}"
                                                        SelectedItem="{Binding AFParam.ControlMode}" />
                                                    <TextBox
                                                        Width="100"
                                                        hc:InfoElement.Title="{ex:Language Key='泵4流速'}"
                                                        Style="{StaticResource TextBoxExtend}"
                                                        Text="{Binding AFParam.FlowSpeed}" />
                                                    <TextBox
                                                        Width="100"
                                                        hc:InfoElement.Title="{ex:Language Key='总量'}"
                                                        Style="{StaticResource TextBoxExtend}"
                                                        Text="{Binding AFParam.FlowCapacity}" />
                                                    <Button
                                                        Width="80"
                                                        Height="30"
                                                        Margin="0,20,0,0"
                                                        hc:BorderElement.CornerRadius="{StaticResource DefaultCornerRadius}"
                                                        Command="{Binding ReadCommand}"
                                                        CommandParameter="3,4"
                                                        Content="{ex:Language Key='Read'}" />
                                                    <Button
                                                        Width="80"
                                                        Height="30"
                                                        Margin="0,20,0,0"
                                                        hc:BorderElement.CornerRadius="{StaticResource DefaultCornerRadius}"
                                                        Command="{Binding SetCommand}"
                                                        CommandParameter="3,4"
                                                        Content="{ex:Language Key='Set'}" />
                                                </hc:UniformSpacingPanel>
                                            </hc:UniformSpacingPanel>
                                            <hc:UniformSpacingPanel Orientation="Horizontal" Spacing="10">
                                                <hc:UniformSpacingPanel Orientation="Horizontal" Spacing="10">
                                                    <hc:ComboBox
                                                        hc:InfoElement.Title="{ex:Language Key='Control Mode'}"
                                                        ItemsSource="{Binding Source={StaticResource DataFromEnum}}"
                                                        SelectedItem="{Binding Pump5Param.ControlMode}" />
                                                    <TextBox
                                                        Width="100"
                                                        hc:InfoElement.Title="{ex:Language Key='泵5流速'}"
                                                        Style="{StaticResource TextBoxExtend}"
                                                        Text="{Binding Pump5Param.FlowSpeed}" />
                                                    <TextBox
                                                        Width="100"
                                                        hc:InfoElement.Title="{ex:Language Key='总量'}"
                                                        Style="{StaticResource TextBoxExtend}"
                                                        Text="{Binding Pump5Param.FlowCapacity}" />
                                                    <Button
                                                        Width="80"
                                                        Height="30"
                                                        Margin="0,20,0,0"
                                                        hc:BorderElement.CornerRadius="{StaticResource DefaultCornerRadius}"
                                                        Command="{Binding ReadCommand}"
                                                        CommandParameter="3,5"
                                                        Content="{ex:Language Key='Read'}" />
                                                    <Button
                                                        Width="80"
                                                        Height="30"
                                                        Margin="0,20,0,0"
                                                        hc:BorderElement.CornerRadius="{StaticResource DefaultCornerRadius}"
                                                        Command="{Binding SetCommand}"
                                                        CommandParameter="3,5"
                                                        Content="{ex:Language Key='Set'}" />
                                                </hc:UniformSpacingPanel>
                                                <hc:UniformSpacingPanel Orientation="Horizontal" Spacing="10">
                                                    <hc:ComboBox
                                                        hc:InfoElement.Title="{ex:Language Key='Control Mode'}"
                                                        ItemsSource="{Binding Source={StaticResource DataFromEnum}}"
                                                        SelectedItem="{Binding Pump6Param.ControlMode}" />
                                                    <TextBox
                                                        Width="100"
                                                        hc:InfoElement.Title="{ex:Language Key='泵6流速'}"
                                                        Style="{StaticResource TextBoxExtend}"
                                                        Text="{Binding Pump6Param.FlowSpeed}" />
                                                    <TextBox
                                                        Width="100"
                                                        hc:InfoElement.Title="{ex:Language Key='总量'}"
                                                        Style="{StaticResource TextBoxExtend}"
                                                        Text="{Binding Pump6Param.FlowCapacity}" />
                                                    <Button
                                                        Width="80"
                                                        Height="30"
                                                        Margin="0,20,0,0"
                                                        hc:BorderElement.CornerRadius="{StaticResource DefaultCornerRadius}"
                                                        Command="{Binding ReadCommand}"
                                                        CommandParameter="3,6"
                                                        Content="{ex:Language Key='Read'}" />
                                                    <Button
                                                        Width="80"
                                                        Height="30"
                                                        Margin="0,20,0,0"
                                                        hc:BorderElement.CornerRadius="{StaticResource DefaultCornerRadius}"
                                                        Command="{Binding SetCommand}"
                                                        CommandParameter="3,6"
                                                        Content="{ex:Language Key='Set'}" />
                                                </hc:UniformSpacingPanel>
                                            </hc:UniformSpacingPanel>
                                        </hc:UniformSpacingPanel>
                                    </GroupBox>
                                    <GroupBox Header="{ex:Language Key='消泡'}" Style="{StaticResource MaterialDesignCardGroupBox}">
                                        <hc:UniformSpacingPanel Orientation="Vertical" Spacing="10">
                                            <hc:UniformSpacingPanel Orientation="Horizontal" Spacing="10">
                                                <TextBox
                                                    Width="120"
                                                    hc:InfoElement.Title="{ex:Language Key='泵编号'}"
                                                    Style="{StaticResource TextBoxExtend}"
                                                    Text="{Binding DefoamingParam.PumpNo}" />
                                                <TextBox
                                                    Width="120"
                                                    hc:InfoElement.Title="{ex:Language Key='消泡速度'}"
                                                    Style="{StaticResource TextBoxExtend}"
                                                    Text="{Binding DefoamingParam.FlowSpeed}" />
                                                <TextBox
                                                    Width="120"
                                                    hc:InfoElement.Title="{ex:Language Key='检测周期'}"
                                                    Style="{StaticResource TextBoxExtend}"
                                                    Text="{Binding DefoamingParam.Cycle}" />
                                                <TextBox
                                                    Width="120"
                                                    hc:InfoElement.Title="{ex:Language Key='时间占比'}"
                                                    Style="{StaticResource TextBoxExtend}"
                                                    Text="{Binding DefoamingParam.TimeRatio}" />
                                                <CheckBox
                                                    Margin="0,15,0,0"
                                                    Content="泡沫传感器使能"
                                                    IsChecked="{Binding DefoamingParam.SensorEnable}" />
                                                <Button
                                                    Width="80"
                                                    Height="30"
                                                    Margin="0,20,0,0"
                                                    VerticalAlignment="Center"
                                                    hc:BorderElement.CornerRadius="{StaticResource DefaultCornerRadius}"
                                                    Command="{Binding ReadCommand}"
                                                    CommandParameter="4"
                                                    Content="{ex:Language Key='Read'}" />
                                                <Button
                                                    Width="80"
                                                    Height="30"
                                                    Margin="0,20,0,0"
                                                    hc:BorderElement.CornerRadius="{StaticResource DefaultCornerRadius}"
                                                    Command="{Binding SetCommand}"
                                                    CommandParameter="4"
                                                    Content="{ex:Language Key='Set'}" />
                                            </hc:UniformSpacingPanel>
                                        </hc:UniformSpacingPanel>

                                    </GroupBox>
                                    <GroupBox Header="{ex:Language Key='MFC'}" Style="{StaticResource MaterialDesignCardGroupBox}">
                                        <hc:UniformSpacingPanel Orientation="Vertical" Spacing="10">
                                            <hc:UniformSpacingPanel Orientation="Horizontal" Spacing="10">
                                                <hc:UniformSpacingPanel Orientation="Horizontal" Spacing="10">
                                                    <TextBox
                                                        Width="100"
                                                        hc:InfoElement.Title="{ex:Language Key='MFC1流量'}"
                                                        Style="{StaticResource TextBoxExtend}"
                                                        Text="{Binding AirParam.FlowSpeed}" />
                                                    <Button
                                                        Width="80"
                                                        Height="30"
                                                        Margin="0,20,0,0"
                                                        hc:BorderElement.CornerRadius="8"
                                                        Command="{Binding ReadCommand}"
                                                        CommandParameter="5,1"
                                                        Content="{ex:Language Key='Read'}" />
                                                    <Button
                                                        Width="80"
                                                        Height="30"
                                                        Margin="0,20,0,0"
                                                        hc:BorderElement.CornerRadius="8"
                                                        Command="{Binding SetCommand}"
                                                        CommandParameter="5,1"
                                                        Content="{ex:Language Key='Set'}" />
                                                </hc:UniformSpacingPanel>
                                                <hc:UniformSpacingPanel Orientation="Horizontal" Spacing="10">
                                                    <TextBox
                                                        Width="100"
                                                        hc:InfoElement.Title="{ex:Language Key='MFC2流量'}"
                                                        Style="{StaticResource TextBoxExtend}"
                                                        Text="{Binding O2Param.FlowSpeed}" />
                                                    <Button
                                                        Width="80"
                                                        Height="30"
                                                        Margin="0,20,0,0"
                                                        hc:BorderElement.CornerRadius="8"
                                                        Command="{Binding ReadCommand}"
                                                        CommandParameter="5,2"
                                                        Content="{ex:Language Key='Read'}" />
                                                    <Button
                                                        Width="80"
                                                        Height="30"
                                                        Margin="0,20,0,0"
                                                        hc:BorderElement.CornerRadius="8"
                                                        Command="{Binding SetCommand}"
                                                        CommandParameter="5,2"
                                                        Content="{ex:Language Key='Set'}" />
                                                </hc:UniformSpacingPanel>
                                            </hc:UniformSpacingPanel>
                                            <hc:UniformSpacingPanel Orientation="Horizontal" Spacing="10">
                                                <hc:UniformSpacingPanel Orientation="Horizontal" Spacing="10">
                                                    <TextBox
                                                        Width="100"
                                                        hc:InfoElement.Title="{ex:Language Key='MFC3流量'}"
                                                        Style="{StaticResource TextBoxExtend}"
                                                        Text="{Binding CO2Param.FlowSpeed}" />
                                                    <Button
                                                        Width="80"
                                                        Height="30"
                                                        Margin="0,20,0,0"
                                                        hc:BorderElement.CornerRadius="8"
                                                        Command="{Binding ReadCommand}"
                                                        CommandParameter="5,3"
                                                        Content="{ex:Language Key='Read'}" />
                                                    <Button
                                                        Width="80"
                                                        Height="30"
                                                        Margin="0,20,0,0"
                                                        hc:BorderElement.CornerRadius="8"
                                                        Command="{Binding SetCommand}"
                                                        CommandParameter="5,3"
                                                        Content="{ex:Language Key='Set'}" />
                                                </hc:UniformSpacingPanel>
                                                <hc:UniformSpacingPanel Orientation="Horizontal" Spacing="10">
                                                    <TextBox
                                                        Width="100"
                                                        hc:InfoElement.Title="{ex:Language Key='MFC4流量'}"
                                                        Style="{StaticResource TextBoxExtend}"
                                                        Text="{Binding N2Param.FlowSpeed}" />
                                                    <Button
                                                        Width="80"
                                                        Height="30"
                                                        Margin="0,20,0,0"
                                                        hc:BorderElement.CornerRadius="8"
                                                        Command="{Binding ReadCommand}"
                                                        CommandParameter="5,4"
                                                        Content="{ex:Language Key='Read'}" />
                                                    <Button
                                                        Width="80"
                                                        Height="30"
                                                        Margin="0,20,0,0"
                                                        hc:BorderElement.CornerRadius="8"
                                                        Command="{Binding SetCommand}"
                                                        CommandParameter="5,4"
                                                        Content="{ex:Language Key='Set'}" />
                                                </hc:UniformSpacingPanel>
                                            </hc:UniformSpacingPanel>
                                            <hc:UniformSpacingPanel Orientation="Horizontal" Spacing="10">
                                                <hc:UniformSpacingPanel Orientation="Horizontal" Spacing="10">
                                                    <TextBox
                                                        Width="100"
                                                        hc:InfoElement.Title="{ex:Language Key='MFC5流量'}"
                                                        Style="{StaticResource TextBoxExtend}"
                                                        Text="{Binding CO2Param.FlowSpeed}" />
                                                    <Button
                                                        Width="80"
                                                        Height="30"
                                                        Margin="0,20,0,0"
                                                        hc:BorderElement.CornerRadius="8"
                                                        Command="{Binding ReadCommand}"
                                                        CommandParameter="5,5"
                                                        Content="{ex:Language Key='Read'}" />
                                                    <Button
                                                        Width="80"
                                                        Height="30"
                                                        Margin="0,20,0,0"
                                                        hc:BorderElement.CornerRadius="8"
                                                        Command="{Binding SetCommand}"
                                                        CommandParameter="5,5"
                                                        Content="{ex:Language Key='Set'}" />
                                                </hc:UniformSpacingPanel>
                                            </hc:UniformSpacingPanel>
                                        </hc:UniformSpacingPanel>
                                    </GroupBox>
                                    <hc:UniformSpacingPanel Orientation="Horizontal" Spacing="10">
                                        <hc:ComboBox
                                            Width="200"
                                            hc:InfoElement.Title="{ex:Language Key='传感器种类'}"
                                            SelectedIndex="{Binding SelectedSensorKindIndex}"
                                            SelectionChanged="ComboBox_SelectionChanged">
                                            <ComboBoxItem Content="PH" />
                                            <ComboBoxItem Content="DO" />
                                        </hc:ComboBox>
                                        <hc:ComboBox
