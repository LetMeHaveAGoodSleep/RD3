<Window
    x:Class="RD3.Views.PadMainView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:RD3.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ex="clr-namespace:LayUI.Wpf.Extensions;assembly=LayUI.Wpf.Extensions"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:local="clr-namespace:RD3.Views"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:share="clr-namespace:RD3.Shared;assembly=RD3.Shared"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    xmlns:viewmodels="clr-namespace:RD3.ViewModels"
    xmlns:wpf="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
    Width="1920"
    Height="1200"
    d:DataContext="{d:DesignInstance Type=viewmodels:PadMainViewModel}"
    prism:ViewModelLocator.AutoWireViewModel="True"
    FontSize="{StaticResource SubHeadFontSize}"
    ResizeMode="CanMinimize"
    ShowInTaskbar="True"
    Topmost="False"
    UseLayoutRounding="True"
    WindowState="Maximized"
    mc:Ignorable="d">
    <Window.Resources>
        <ObjectDataProvider
            x:Key="DataFromEnum"
            MethodName="GetValues"
            ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="share:PeristalticPump" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border Height="50" Background="{DynamicResource PrimaryBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto" />
                    <ColumnDefinition Width="15" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="15" />
                    <ColumnDefinition Width="auto" />
                </Grid.ColumnDefinitions>
                <Image
                    Width="117"
                    Height="50"
                    Margin="5,0,0,0"
                    Source="/Images/NewReactor/logo.png" />
                <hc:UniformSpacingPanel
                    Grid.Column="2"
                    HorizontalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="10">
                    <Button
                        Height="36"
                        hc:IconElement.Geometry="{StaticResource GeometryStart}"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="ButtonStartExperiment_Click"
                        Command="{Binding StartExperimentCommand}"
                        Content="开始实验"
                        FontSize="{StaticResource HeadFontSize}"
                        Foreground="White"
                        Visibility="{Binding CurrentDeviceParameter.InExperimenting, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                    <Button
                        Height="36"
                        hc:IconElement.Geometry="{StaticResource GeometryStop}"
                        Background="Transparent"
                        BorderThickness="0"
                        Command="{Binding EndExperimentCommand}"
                        Content="结束实验"
                        FontSize="{StaticResource HeadFontSize}"
                        Foreground="White"
                        Visibility="{Binding CurrentDeviceParameter.InExperimenting, Converter={StaticResource Boolean2VisibilityConverter}}" />
                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            Width="320"
                            VerticalAlignment="Center"
                            FontSize="{StaticResource HeadFontSize}"
                            Foreground="White"
                            Text="{Binding CurrentDeviceParameter.FormattedTime, StringFormat='批次运行时间：{0}'}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            Width="250"
                            VerticalAlignment="Center"
                            FontSize="{StaticResource HeadFontSize}"
                            Foreground="White"
                            Text="{Binding CurrentDeviceParameter.BatchID, StringFormat='批次号：{0}'}" />
                    </StackPanel>
                </hc:UniformSpacingPanel>
                <hc:UniformSpacingPanel
                    Grid.Column="4"
                    FlowDirection="LeftToRight"
                    Orientation="Horizontal"
                    Spacing="5">
                    <DockPanel LastChildFill="False">
                        <TextBlock
                            Name="FormattedTime"
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource IconFont}"
                            FontSize="{StaticResource LargeFontSize}"
                            Foreground="White"
                            Text="2025-07-23 17:14:32" />
                    </DockPanel>
                    <Button
                        Name="btnDOSimulate"
                        Height="40"
                        hc:IconElement.Geometry="{StaticResource AskGeometry}"
                        hc:IconElement.Height="30"
                        hc:IconElement.Width="30"
                        materialDesign:RippleAssist.Feedback="#000000"
                        Background="Transparent"
                        BorderThickness="0"
                        Command="{Binding DODIYCommand}"
                        Content="模拟DO"
                        FontSize="{StaticResource HeadFontSize}"
                        Foreground="White" />
                    <Button
                        Name="btnpHSimulate"
                        Height="40"
                        hc:IconElement.Geometry="{StaticResource AskGeometry}"
                        hc:IconElement.Height="30"
                        hc:IconElement.Width="30"
                        materialDesign:RippleAssist.Feedback="#000000"
                        Background="Transparent"
                        BorderThickness="0"
                        Command="{Binding pHDIYCommand}"
                        Content="模拟pH"
                        FontSize="{StaticResource HeadFontSize}"
                        Foreground="White" />
                    <Button
                        Height="40"
                        hc:IconElement.Geometry="{StaticResource GeometryUserCircle}"
                        hc:IconElement.Height="30"
                        hc:IconElement.Width="30"
                        materialDesign:RippleAssist.Feedback="#000000"
                        Background="Transparent"
                        BorderThickness="0"
                        FontSize="{StaticResource HeadFontSize}"
                        Foreground="White" />
                    <Button
                        Height="40"
                        hc:IconElement.Geometry="{StaticResource GeometryArrowCollapseAll}"
                        hc:IconElement.Height="30"
                        hc:IconElement.Width="30"
                        materialDesign:RippleAssist.Feedback="#DD000000"
                        Background="Transparent"
                        BorderThickness="0"
                        Command="{Binding MinimizeCommand}"
                        FontSize="{StaticResource HeadFontSize}"
                        Foreground="White" />
                    <Button
                        Height="40"
                        hc:IconElement.Geometry="{StaticResource GeometryQuit}"
                        hc:IconElement.Height="30"
                        hc:IconElement.Width="30"
                        materialDesign:RippleAssist.Feedback="#DD000000"
                        Background="Transparent"
                        BorderThickness="0"
                        Command="{Binding ExitCommand}"
                        FontSize="{StaticResource HeadFontSize}"
                        Foreground="White" />
                </hc:UniformSpacingPanel>
            </Grid>
        </Border>
        <TabControl
            Name="tabMenu"
            Grid.Row="1"
            materialDesign:NavigationRailAssist.ShowSelectionBackground="True"
            SelectedIndex="{Binding SelectedMenuIndex}"
            SnapsToDevicePixels="True"
            Style="{StaticResource MaterialDesignNavigationRailTabControl}"
            TabStripPlacement="Right">
            <TabItem>
                <TabItem.Header>
                    <StackPanel Width="auto" Height="auto">
                        <materialDesign:PackIcon
                            Width="40"
                            Height="40"
                            HorizontalAlignment="Center"
                            Kind="Home" />
                        <TextBlock HorizontalAlignment="Center" Text="首页" />
                    </StackPanel>
                </TabItem.Header>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Canvas>
                        <StackPanel
                            Canvas.Left="0"
                            Canvas.Top="0"
                            Margin="5"
                            Orientation="Horizontal">
                            <Button
                                materialDesign:ButtonProgressAssist.IsIndeterminate="True"
                                materialDesign:ButtonProgressAssist.IsIndicatorVisible="True"
                                materialDesign:ButtonProgressAssist.Value="-1"
                                Content="连接中..."
                                Foreground="White"
                                Style="{StaticResource MaterialDesignRaisedButton}"
                                Visibility="{Binding Connecting, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <Button
                                Height="60"
                                Padding="15"
                                hc:IconElement.Geometry="{StaticResource GeometryNetworkReconnect}"
                                hc:IconElement.Height="30"
                                hc:IconElement.Width="30"
                                Background="Transparent"
                                BorderThickness="0"
                                Command="{Binding ReconnectCommand}"
                                DockPanel.Dock="Bottom"
                                Foreground="{DynamicResource FixedGradientBrush}">
                                <Button.Visibility>
                                    <MultiBinding Converter="{StaticResource AndBool2VisConverter}">
                                        <Binding Converter="{StaticResource InverseBooleanConverter}" Path="Connected" />
                                        <Binding Converter="{StaticResource InverseBooleanConverter}" Path="Connecting" />
                                    </MultiBinding>
                                </Button.Visibility>
                            </Button>
                        </StackPanel>
                        <Image
                            Canvas.Left="500"
                            Canvas.Top="40"
                            Width="200"
                            Height="650"
                            Source="/Images/NewReactor/ft.png">
                            <i:Interaction.Triggers>
                                <i:EventTrigger EventName="MouseDoubleClick">
                                    <i:InvokeCommandAction Command="{Binding DeviceSettingCommand}" />
                                </i:EventTrigger>
                            </i:Interaction.Triggers>
                        </Image>
                        <!--  泵的设置  -->
                        <hc:Divider
                            Canvas.Left="260"
                            Canvas.Top="133"
                            Width="295"
                            LineStroke="#FF7F7F7F"
                            LineStrokeThickness="2"
                            Orientation="Horizontal" />
                        <local:PumpView
                            x:Name="pump1"
                            Canvas.Left="140"
                            Canvas.Top="159" />
                        <local:PumpView
                            x:Name="pump2"
                            Canvas.Left="140"
                            Canvas.Top="238" />
                        <local:PumpView
                            x:Name="pump3"
                            Canvas.Left="140"
                            Canvas.Top="317" />
                        <local:PumpView
                            x:Name="pump4"
                            Canvas.Left="140"
                            Canvas.Top="396" />
                        <local:PumpView
                            x:Name="pump5"
                            Canvas.Left="140"
                            Canvas.Top="475" />
                        <local:PumpView
                            x:Name="pump6"
                            Canvas.Left="140"
                            Canvas.Top="554" />
                        <!--  MFC  -->
                        <hc:Divider
                            Canvas.Left="648"
                            Canvas.Top="305"
                            Width="155"
                            LineStroke="#FF7F7F7F"
                            LineStrokeThickness="2"
                            Orientation="Horizontal" />
                        <local:MFCView
                            x:Name="mfc1"
                            Canvas.Left="815"
                            Canvas.Top="281" />
                        <hc:Divider
                            Canvas.Left="740"
                            Canvas.Top="330"
                            Height="211"
                            LineStroke="#FF7F7F7F"
                            LineStrokeThickness="2"
                            Orientation="Vertical" />
                        <local:MFCView
                            x:Name="mfc2"
                            Canvas.Left="815"
                            Canvas.Top="351" />
                        <hc:Divider
                            Canvas.Left="747"
                            Canvas.Top="375"
                            Width="55"
                            LineStroke="#FF7F7F7F"
                            LineStrokeThickness="2"
                            Orientation="Horizontal" />
                        <local:MFCView
                            x:Name="mfc3"
                            Canvas.Left="815"
                            Canvas.Top="421" />
                        <hc:Divider
                            Canvas.Left="747"
                            Canvas.Top="445"
                            Width="55"
                            LineStroke="#FF7F7F7F"
                            LineStrokeThickness="2"
                            Orientation="Horizontal" />
                        <local:MFCView
                            x:Name="mfc4"
                            Canvas.Left="815"
                            Canvas.Top="491" />
                        <hc:Divider
                            Canvas.Left="747"
                            Canvas.Top="515"
                            Width="55"
                            LineStroke="#FF7F7F7F"
                            LineStrokeThickness="2"
                            Orientation="Horizontal" />
                        <StackPanel
                            Canvas.Left="527"
                            Canvas.Top="532"
                            Orientation="Vertical">
                            <Image
                                Width="144"
                                Source="/Images/NewReactor/罐加热（加热）.png"
                                Visibility="{Binding CurrentDeviceParameter.TempParam.IsControling, Converter={StaticResource Boolean2VisibilityConverter}}" />
                            <Image
                                Width="144"
                                Source="/Images/NewReactor/罐加热（制冷）.png"
                                Visibility="Collapsed" />
                            <Image
                                Width="144"
                                Source="/Images/NewReactor/罐加热（常规）.png"
                                Visibility="{Binding CurrentDeviceParameter.TempParam.IsControling, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                        </StackPanel>
                        <Image
                            Canvas.Left="543"
                            Canvas.Top="458"
                            Width="114"
                            Source="/Images/NewReactor/水.png" />
                        <Image
                            Name="mixPaddle"
                            Canvas.Left="575"
                            Canvas.Top="400"
                            Width="52"
                            Source="/Images/NewReactor/搅拌0.png" />
                        <!--  电机  -->
                        <hc:Divider
                            Canvas.Left="610"
                            Canvas.Top="47"
                            Height="130"
                            LineStroke="#FF7F7F7F"
                            LineStrokeThickness="2"
                            Orientation="Vertical" />
                        <hc:Divider
                            Canvas.Left="616"
                            Canvas.Top="21"
                            Width="215"
                            LineStroke="#FF7F7F7F"
                            LineStrokeThickness="2"
                            Orientation="Horizontal" />
                        <hc:UniformSpacingPanel
                            Canvas.Left="842"
                            Canvas.Top="10"
                            Orientation="Horizontal"
                            Spacing="5">
                            <DockPanel LastChildFill="False">
                                <hc:Badge
                                    BadgeMargin="5,5"
                                    Status="Processing"
                                    Style="{StaticResource BadgeSuccess}"
                                    Visibility="{Binding CurrentDeviceParameter.AgitParam.IsControling, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <Button
                                        Height="66"
                                        Padding="15"
                                        hc:IconElement.Geometry="{StaticResource GeometryAgit}"
                                        hc:IconElement.Height="36"
                                        hc:IconElement.Width="36"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Command="{Binding AgitSettingCommand}"
                                        DockPanel.Dock="Bottom"
                                        Foreground="{DynamicResource FixedGradientBrush}" />
                                </hc:Badge>
                                <Button
                                    Height="66"
                                    Padding="15"
                                    hc:IconElement.Geometry="{StaticResource GeometryAgit}"
                                    hc:IconElement.Height="36"
                                    hc:IconElement.Width="36"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Command="{Binding AgitSettingCommand}"
                                    DockPanel.Dock="Bottom"
                                    Foreground="{DynamicResource FixedGradientBrush}"
                                    Visibility="{Binding CurrentDeviceParameter.AgitParam.IsControling, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                            </DockPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBox
                                    Width="100"
                                    VerticalAlignment="Top"
                                    materialDesign:HintAssist.Hint="转速(rpm)"
                                    IsEnabled="False"
                                    Style="{StaticResource MaterialDesignFloatingHintTextBox}">
                                    <TextBox.Text>
                                        <MultiBinding StringFormat="{}{0:F0} / {1:F0}">
                                            <Binding Mode="TwoWay" Path="CurrentDeviceParameter.AgitParam.SP" />
                                            <Binding Mode="OneWay" Path="CurrentDeviceParameter.Agit" />
                                        </MultiBinding>
                                    </TextBox.Text>
                                </TextBox>
                            </StackPanel>
                        </hc:UniformSpacingPanel>
                        <!--  关键参数  -->
                        <hc:Divider
                            Canvas.Left="639"
                            Canvas.Top="164"
                            Width="192"
                            LineStroke="#FF7F7F7F"
                            LineStrokeThickness="2"
                            Orientation="Horizontal" />
                        <hc:Divider
                            Canvas.Left="746"
                            Canvas.Top="95"
                            Width="85"
                            LineStroke="#FF7F7F7F"
                            LineStrokeThickness="2"
                            Orientation="Horizontal" />
                        <hc:UniformSpacingPanel
                            Canvas.Left="842"
                            Canvas.Top="85"
                            Orientation="Horizontal"
                            Spacing="5">
                            <DockPanel LastChildFill="False">
                                <hc:Badge
                                    BadgeMargin="5,5"
                                    Status="Processing"
                                    Style="{StaticResource BadgeSuccess}"
                                    Visibility="{Binding CurrentDeviceParameter.DOParam.IsControling, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <Button
                                        Height="66"
                                        Padding="15"
                                        hc:IconElement.Geometry="{StaticResource GeometryDO}"
                                        hc:IconElement.Height="36"
                                        hc:IconElement.Width="36"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Command="{Binding DOSettingCommand}"
                                        DockPanel.Dock="Bottom"
                                        Foreground="{DynamicResource FixedGradientBrush}" />
                                </hc:Badge>
                                <Button
                                    Height="66"
                                    Padding="15"
                                    hc:IconElement.Geometry="{StaticResource GeometryDO}"
                                    hc:IconElement.Height="36"
                                    hc:IconElement.Width="36"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Command="{Binding DOSettingCommand}"
                                    DockPanel.Dock="Bottom"
                                    Foreground="{DynamicResource FixedGradientBrush}"
                                    Visibility="{Binding CurrentDeviceParameter.DOParam.IsControling, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                            </DockPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBox
                                    Width="100"
                                    VerticalAlignment="Top"
                                    materialDesign:HintAssist.Hint="溶氧(%)"
                                    IsEnabled="False"
                                    Style="{StaticResource MaterialDesignFloatingHintTextBox}">
                                    <TextBox.Text>
                                        <MultiBinding StringFormat="{}{0:F2} / {1:F2}">
                                            <Binding Mode="TwoWay" Path="CurrentDeviceParameter.DOParam.SP" />
                                            <Binding Mode="OneWay" Path="CurrentDeviceParameter.DO" />
                                        </MultiBinding>
                                    </TextBox.Text>
                                </TextBox>
                            </StackPanel>
                        </hc:UniformSpacingPanel>
                        <hc:Divider
                            Canvas.Left="740"
                            Canvas.Top="120"
                            Height="135"
                            LineStroke="#FF7F7F7F"
                            LineStrokeThickness="2"
                            Orientation="Vertical" />
                        <hc:UniformSpacingPanel
                            Canvas.Left="842"
                            Canvas.Top="150"
                            Orientation="Horizontal"
                            Spacing="5">
                            <DockPanel LastChildFill="False">
                                <hc:Badge
                                    BadgeMargin="5,5"
                                    Status="Processing"
                                    Style="{StaticResource BadgeSuccess}"
                                    Visibility="{Binding CurrentDeviceParameter.PHParam.IsControling, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <Button
                                        Height="66"
                                        Padding="15"
                                        hc:IconElement.Geometry="{StaticResource GeometrypH}"
                                        hc:IconElement.Height="36"
                                        hc:IconElement.Width="36"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Command="{Binding pHSettingCommand}"
                                        DockPanel.Dock="Bottom"
                                        Foreground="{DynamicResource FixedGradientBrush}" />
                                </hc:Badge>
                                <Button
                                    Height="66"
                                    Padding="15"
                                    hc:IconElement.Geometry="{StaticResource GeometrypH}"
                                    hc:IconElement.Height="36"
                                    hc:IconElement.Width="36"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Command="{Binding pHSettingCommand}"
                                    DockPanel.Dock="Bottom"
                                    Foreground="{DynamicResource FixedGradientBrush}"
                                    Visibility="{Binding CurrentDeviceParameter.PHParam.IsControling, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                            </DockPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBox
                                    Width="100"
                                    VerticalAlignment="Top"
                                    materialDesign:HintAssist.Hint="pH"
                                    IsEnabled="False"
                                    Style="{StaticResource MaterialDesignFloatingHintTextBox}">
                                    <TextBox.Text>
                                        <MultiBinding StringFormat="{}{0:F2} / {1:F2}">
                                            <Binding Mode="TwoWay" Path="CurrentDeviceParameter.PHParam.SP" />
                                            <Binding Mode="OneWay" Path="CurrentDeviceParameter.PH" />
                                        </MultiBinding>
                                    </TextBox.Text>
                                </TextBox>
                            </StackPanel>
                        </hc:UniformSpacingPanel>
                        <hc:Divider
                            Canvas.Left="746"
                            Canvas.Top="230"
                            Width="85"
                            LineStroke="#FF7F7F7F"
                            LineStrokeThickness="2"
                            Orientation="Horizontal" />
                        <hc:UniformSpacingPanel
                            Canvas.Left="842"
                            Canvas.Top="215"
                            Orientation="Horizontal"
                            Spacing="5">
                            <DockPanel LastChildFill="False">
                                <hc:Badge
                                    BadgeMargin="5,5"
                                    Status="Processing"
                                    Style="{StaticResource BadgeSuccess}"
                                    Visibility="{Binding CurrentDeviceParameter.TempParam.IsControling, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <Button
                                        Height="66"
                                        Padding="15"
                                        hc:IconElement.Geometry="{StaticResource GeometryTemp}"
                                        hc:IconElement.Height="36"
                                        hc:IconElement.Width="36"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Command="{Binding TempSettingCommand}"
                                        DockPanel.Dock="Bottom"
                                        Foreground="{DynamicResource FixedGradientBrush}" />
                                </hc:Badge>
                                <Button
                                    Height="66"
                                    Padding="15"
                                    hc:IconElement.Geometry="{StaticResource GeometryTemp}"
                                    hc:IconElement.Height="36"
                                    hc:IconElement.Width="36"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Command="{Binding TempSettingCommand}"
                                    DockPanel.Dock="Bottom"
                                    Foreground="{DynamicResource FixedGradientBrush}"
                                    Visibility="{Binding CurrentDeviceParameter.TempParam.IsControling, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                            </DockPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBox
                                    Width="100"
                                    VerticalAlignment="Top"
                                    materialDesign:HintAssist.Hint="温度(℃)"
                                    IsEnabled="False"
                                    Style="{StaticResource MaterialDesignFloatingHintTextBox}">
                                    <TextBox.Text>
                                        <MultiBinding StringFormat="{}{0:F2} / {1:F2}">
                                            <Binding Mode="TwoWay" Path="CurrentDeviceParameter.TempParam.SP" />
                                            <Binding Mode="OneWay" Path="CurrentDeviceParameter.Temp" />
                                        </MultiBinding>
                                    </TextBox.Text>
                                </TextBox>
                            </StackPanel>
                        </hc:UniformSpacingPanel>
                        <hc:UniformSpacingPanel
                            Canvas.Left="575"
                            Canvas.Top="665"
                            Orientation="Horizontal"
                            Spacing="3">
                            <TextBlock FontSize="{StaticResource SubHeadFontSize}" Text="{Binding CurrentDeviceParameter.JarWeight, StringFormat={}{0:F2}}" />
                            <TextBlock FontSize="{StaticResource SubHeadFontSize}" Text="g" />
                        </hc:UniformSpacingPanel>
                    </Canvas>
                </Grid>
            </TabItem>
            <TabItem Name="tabCurve">
                <TabItem.Header>
                    <StackPanel Width="auto" Height="auto">
                        <materialDesign:PackIcon
                            Width="40"
                            Height="40"
                            HorizontalAlignment="Center"
                            Kind="ChartBellCurveCumulative" />
                        <TextBlock HorizontalAlignment="Center" Text="曲线" />
                    </StackPanel>
                </TabItem.Header>
                <Grid Name="GridMain" Margin="5">
                    <Grid.RowDefinitions>
                        <RowDefinition
                            Name="rowGraph3"
                            Height="auto"
                            MaxHeight="60" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                        <WrapPanel Name="ChkGraphList3" Orientation="Horizontal" />
                    </ScrollViewer>
                    <wpf:WpfPlot Name="wpfPlot3" Grid.Row="2" />
                </Grid>
            </TabItem>
            <TabItem Name="tabBatch">
                <TabItem.Header>
                    <StackPanel Width="auto" Height="auto">
                        <materialDesign:PackIcon
                            Width="40"
                            Height="40"
                            HorizontalAlignment="Center"
                            Kind="Database" />
                        <TextBlock HorizontalAlignment="Center" Text="数据" />
                    </StackPanel>
                </TabItem.Header>
                <local:NewBatchView
                    x:Name="batchView"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top" />
            </TabItem>
            <TabItem>
                <TabItem.Header>
                    <StackPanel Width="auto" Height="auto">
                        <materialDesign:PackIcon
                            Width="40"
                            Height="40"
                            HorizontalAlignment="Center"
                            Kind="TimelineClockOutline" />
                        <TextBlock HorizontalAlignment="Center" Text="顺控" />
                    </StackPanel>
