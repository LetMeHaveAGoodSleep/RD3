                                            Width="80"
                                            hc:InfoElement.Title="更正系数"
                                            BorderBrush="{DynamicResource PrimaryBrush}"
                                            Style="{StaticResource TextBoxExtend}"
                                            Text="{Binding Pump5Param.Coefficient, UpdateSourceTrigger=LostFocus}" />
                                        <DockPanel>
                                            <Button
                                                Width="80"
                                                VerticalAlignment="Bottom"
                                                Command="{Binding CalibratePumpCommand}"
                                                CommandParameter="0,5"
                                                Content="{ex:Language Key='校准系数'}"
                                                Style="{StaticResource ButtonPrimary}" />
                                        </DockPanel>
                                    </hc:UniformSpacingPanel>
                                    <hc:UniformSpacingPanel
                                        IsEnabled="False"
                                        Orientation="Horizontal"
                                        Spacing="10">
                                        <TextBox
                                            Width="60"
                                            HorizontalContentAlignment="Center"
                                            hc:InfoElement.Title="{ex:Language Key='泵编号'}"
                                            BorderBrush="{DynamicResource PrimaryBrush}"
                                            IsEnabled="False"
                                            Style="{StaticResource TextBoxExtend}"
                                            Text="泵6" />
                                        <ComboBox
                                            Width="100"
                                            HorizontalContentAlignment="Center"
                                            hc:InfoElement.Title="{ex:Language Key='泵用途'}"
                                            BorderBrush="{DynamicResource PrimaryBrush}"
                                            ItemsSource="{Binding Source={StaticResource DataFromEnum}}"
                                            SelectedItem="{Binding Pump6Param.Pump}"
                                            Style="{StaticResource ComboBoxExtend}"
                                            Visibility="Collapsed">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Converter={StaticResource EnumToStringConverter}}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                            <i:Interaction.Triggers>
                                                <i:EventTrigger EventName="SelectionChanged">
                                                    <i:InvokeCommandAction Command="{Binding ChangePumpCommand}" PassEventArgsToCommand="True" />
                                                </i:EventTrigger>
                                            </i:Interaction.Triggers>
                                        </ComboBox>
                                        <TextBox
                                            Width="90"
                                            hc:InfoElement.Title="{ex:Language Key='流速（ml/h）'}"
                                            BorderBrush="{DynamicResource PrimaryBrush}"
                                            Style="{StaticResource TextBoxExtend}"
                                            Text="{Binding Pump6Param.Speed, UpdateSourceTrigger=LostFocus}" />
                                        <TextBox
                                            Width="80"
                                            hc:InfoElement.Title="{ex:Language Key='时间（min）'}"
                                            BorderBrush="{DynamicResource PrimaryBrush}"
                                            Style="{StaticResource TextBoxExtend}"
                                            Text="{Binding Pump6Param.Time, UpdateSourceTrigger=LostFocus}" />
                                        <TextBox
                                            Width="80"
                                            hc:InfoElement.Title="体积(mL)"
                                            BorderBrush="{DynamicResource PrimaryBrush}"
                                            IsEnabled="False"
                                            Style="{StaticResource TextBoxExtend}"
                                            Text="{Binding Pump6Param.TheoreticalVolume, UpdateSourceTrigger=LostFocus}" />
                                        <DockPanel>
                                            <Button
                                                Width="80"
                                                VerticalAlignment="Bottom"
                                                hc:BorderElement.CornerRadius="{StaticResource DefaultCornerRadius}"
                                                Command="{Binding CalibratePumpCommand}"
                                                CommandParameter="1,6"
                                                Content="{ex:Language Key='开始'}"
                                                Style="{StaticResource ButtonPrimary}" />
                                        </DockPanel>
                                        <TextBox
                                            Width="80"
                                            hc:InfoElement.Title="称重(g)"
                                            BorderBrush="{DynamicResource PrimaryBrush}"
                                            Style="{StaticResource TextBoxExtend}"
                                            Text="{Binding Pump6Param.Weigh, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBox
                                            Width="80"
                                            hc:InfoElement.Title="密度(g/mL)"
                                            BorderBrush="{DynamicResource PrimaryBrush}"
                                            Style="{StaticResource TextBoxExtend}"
                                            Text="{Binding Pump6Param.Density, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBox
                                            Width="90"
                                            hc:InfoElement.Title="实测体积(mL)"
                                            BorderBrush="{DynamicResource PrimaryBrush}"
                                            IsEnabled="False"
                                            Style="{StaticResource TextBoxExtend}"
                                            Text="{Binding Pump6Param.RealVolume, UpdateSourceTrigger=PropertyChanged}" />
                                        <DockPanel>
                                            <Button
                                                Width="80"
                                                VerticalAlignment="Bottom"
                                                Command="{Binding CalibratePumpCommand}"
                                                CommandParameter="3,6"
                                                Content="{ex:Language Key='写入'}"
                                                Style="{StaticResource ButtonPrimary}" />
                                        </DockPanel>
                                        <DockPanel>
                                            <Button
                                                Width="80"
                                                VerticalAlignment="Bottom"
                                                Command="{Binding CalibratePumpCommand}"
                                                CommandParameter="255,6"
                                                Content="{ex:Language Key='完成校准'}"
                                                Style="{StaticResource ButtonPrimary}" />
                                        </DockPanel>
                                        <TextBox
                                            Width="80"
                                            hc:InfoElement.Title="当前系数"
                                            BorderBrush="{DynamicResource PrimaryBrush}"
                                            IsEnabled="False"
                                            Style="{StaticResource TextBoxExtend}"
                                            Text="{Binding Pump6Param.OldCoefficient, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBox
                                            Width="80"
                                            hc:InfoElement.Title="更正系数"
                                            BorderBrush="{DynamicResource PrimaryBrush}"
                                            Style="{StaticResource TextBoxExtend}"
                                            Text="{Binding Pump6Param.Coefficient, UpdateSourceTrigger=LostFocus}" />
                                        <DockPanel>
                                            <Button
                                                Width="80"
                                                VerticalAlignment="Bottom"
                                                Command="{Binding CalibratePumpCommand}"
                                                CommandParameter="0,6"
                                                Content="{ex:Language Key='校准系数'}"
                                                Style="{StaticResource ButtonPrimary}" />
                                        </DockPanel>
                                    </hc:UniformSpacingPanel>
                                </hc:UniformSpacingPanel>
                            </ScrollViewer>
                        </GroupBox>
                    </hc:UniformSpacingPanel>
                </TabItem>
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Width="auto" Height="auto">
                            <materialDesign:PackIcon
                                Width="40"
                                Height="40"
                                HorizontalAlignment="Center"
                                Kind="Alarm" />
                            <TextBlock HorizontalAlignment="Center" Text="报警" />
                        </StackPanel>
                    </TabItem.Header>
                    <StackPanel Margin="16">
                        <TextBlock
                            Margin="0,0,0,8"
                            Style="{StaticResource MaterialDesignHeadline5TextBlock}"
                            Text="Sounds" />
                        <TextBlock>
                            <Run Text="tab 4 content. Default look and behaviors." />
                            <LineBreak />
                            <LineBreak />
                        </TextBlock>
                    </StackPanel>
                </TabItem>
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Width="auto" Height="auto">
                            <materialDesign:PackIcon
                                Width="40"
                                Height="40"
                                HorizontalAlignment="Center"
                                Kind="FileSign" />
                            <TextBlock HorizontalAlignment="Center" Text="审计" />
                        </StackPanel>
                    </TabItem.Header>
                    <StackPanel Margin="16" />
                </TabItem>
            </TabControl>
        </materialDesign:Card>
    </DockPanel>
</hc:GlowWindow>
