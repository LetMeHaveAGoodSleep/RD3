<hc:GlowWindow
    x:Class="RD3.Views.PadMainView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ex="clr-namespace:LayUI.Wpf.Extensions;assembly=LayUI.Wpf.Extensions"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:local="clr-namespace:RD3.Views"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:share="clr-namespace:RD3.Shared;assembly=RD3.Shared"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    xmlns:viewmodels="clr-namespace:RD3.ViewModels"
    Width="1920"
    Height="1200"
    d:DataContext="{d:DesignInstance Type=viewmodels:PadMainViewModel}"
    prism:ViewModelLocator.AutoWireViewModel="True"
    FontSize="{StaticResource SubHeadFontSize}"
    ResizeMode="NoResize"
    UseLayoutRounding="True"
    WindowStartupLocation="CenterScreen"
    WindowState="Maximized"
    WindowStyle="None"
    mc:Ignorable="d">
    <Window.Resources>
        <ObjectDataProvider
            x:Key="DataFromEnum"
            MethodName="GetValues"
            ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="share:PeristalticPump" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
    </Window.Resources>
    <DockPanel LastChildFill="True">
        <DockPanel Background="{DynamicResource PrimaryBrush}" DockPanel.Dock="Top">
            <Image
                Width="117"
                Margin="5,0,0,0"
                Source="/Images/NewReactor/logo.png" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="auto" />
                </Grid.ColumnDefinitions>
                <hc:UniformSpacingPanel
                    Margin="20,0,0,0"
                    HorizontalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="20">
                    <DockPanel LastChildFill="False">
                        <TextBox
                            materialDesign:HintAssist.FloatingScale="0.8"
                            materialDesign:HintAssist.Hint="批次运行时间"
                            materialDesign:TextFieldAssist.TextBoxViewMargin="1 0 1 0"
                            FontSize="{StaticResource HeadFontSize}"
                            Foreground="White"
                            IsEnabled="False"
                            IsReadOnly="False"
                            Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                            Text="00天00时00分00秒" />
                    </DockPanel>
                    <DockPanel LastChildFill="False">
                        <TextBox
                            materialDesign:HintAssist.FloatingScale="0.8"
                            materialDesign:HintAssist.Hint="批次号"
                            materialDesign:TextFieldAssist.TextBoxViewMargin="1 0 1 0"
                            FontSize="{StaticResource HeadFontSize}"
                            Foreground="White"
                            IsEnabled="False"
                            Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                            Text="Test-B01" />
                    </DockPanel>
                </hc:UniformSpacingPanel>
                <hc:UniformSpacingPanel
                    Grid.Column="1"
                    Margin="20,0,12,0"
                    FlowDirection="LeftToRight"
                    Orientation="Horizontal"
                    Spacing="10">
                    <DockPanel LastChildFill="False">
                        <TextBlock
                            Name="FormattedTime"
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource IconFont}"
                            FontSize="{StaticResource HeadFontSize}"
                            Foreground="White"
                            Text="2025-07-23 17:14:32" />
                    </DockPanel>
                    <Button
                        Height="40"
                        hc:IconElement.Geometry="{StaticResource GeometryUserCircle}"
                        hc:IconElement.Height="30"
                        hc:IconElement.Width="30"
                        materialDesign:RippleAssist.Feedback="#DD000000"
                        Background="Transparent"
                        BorderThickness="0"
                        FontSize="{StaticResource HeadFontSize}"
                        Foreground="White" />
                    <Button
                        Height="40"
                        hc:IconElement.Geometry="{StaticResource GeometryBackToHome}"
                        hc:IconElement.Height="30"
                        hc:IconElement.Width="30"
                        materialDesign:RippleAssist.Feedback="#DD000000"
                        Background="Transparent"
                        BorderThickness="0"
                        Command="{Binding ExitCommand}"
                        FontSize="{StaticResource HeadFontSize}"
                        Foreground="White" />
                </hc:UniformSpacingPanel>
            </Grid>
        </DockPanel>
        <materialDesign:Card>
            <TabControl
                SelectedIndex="{Binding SelectedMenuIndex}"
                SelectionChanged="TabControl_SelectionChanged"
                Style="{StaticResource MaterialDesignNavigationRailTabControl}"
                TabStripPlacement="Right">
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Width="auto" Height="auto">
                            <materialDesign:PackIcon
                                Width="40"
                                Height="40"
                                HorizontalAlignment="Center"
                                Kind="Home" />
                            <TextBlock HorizontalAlignment="Center" Text="首页" />
                        </StackPanel>
                    </TabItem.Header>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <DockPanel LastChildFill="False">
                            <hc:ButtonGroup
                                Margin="10,50,0,0"
                                Orientation="Vertical"
                                Visibility="Collapsed">
                                <RadioButton
                                    Content="G01"
                                    FontSize="{StaticResource LargeFontSize}"
                                    IsChecked="True" />
                                <RadioButton Content="G02" FontSize="{StaticResource LargeFontSize}" />
                                <RadioButton Content="G03" FontSize="{StaticResource LargeFontSize}" />
                                <RadioButton Content="G04" FontSize="{StaticResource LargeFontSize}" />
                            </hc:ButtonGroup>
                        </DockPanel>
                        <Canvas>
                            <Image
                                Canvas.Left="500"
                                Canvas.Top="40"
                                Width="200"
                                Height="650"
                                Source="/Images/NewReactor/ft.png">
                                <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="MouseDoubleClick">
                                        <i:InvokeCommandAction Command="{Binding DeviceSettingCommand}" />
                                    </i:EventTrigger>
                                </i:Interaction.Triggers>
                            </Image>
                            <!--  泵的设置  -->
                            <hc:Divider
                                Canvas.Left="260"
                                Canvas.Top="133"
                                Width="295"
                                LineStroke="#FF7F7F7F"
                                LineStrokeThickness="2"
                                Orientation="Horizontal" />
                            <local:PumpView
                                x:Name="pump1"
                                Canvas.Left="140"
                                Canvas.Top="159" />
                            <local:PumpView
                                x:Name="pump2"
                                Canvas.Left="140"
                                Canvas.Top="238" />
                            <local:PumpView
                                x:Name="pump3"
                                Canvas.Left="140"
                                Canvas.Top="317" />
                            <local:PumpView
                                x:Name="pump4"
                                Canvas.Left="140"
                                Canvas.Top="396" />
                            <local:PumpView
                                x:Name="pump5"
                                Canvas.Left="140"
                                Canvas.Top="475" />
                            <local:PumpView
                                x:Name="pump6"
                                Canvas.Left="140"
                                Canvas.Top="554" />
                            <!--  MFC  -->
                            <hc:Divider
                                Canvas.Left="648"
                                Canvas.Top="305"
                                Width="155"
                                LineStroke="#FF7F7F7F"
                                LineStrokeThickness="2"
                                Orientation="Horizontal" />
                            <local:MFCView
                                x:Name="mfc1"
                                Canvas.Left="815"
                                Canvas.Top="281" />
                            <hc:Divider
                                Canvas.Left="740"
                                Canvas.Top="330"
                                Height="211"
                                LineStroke="#FF7F7F7F"
                                LineStrokeThickness="2"
                                Orientation="Vertical" />
                            <local:MFCView
                                x:Name="mfc2"
                                Canvas.Left="815"
                                Canvas.Top="351" />
                            <hc:Divider
                                Canvas.Left="747"
                                Canvas.Top="375"
                                Width="55"
                                LineStroke="#FF7F7F7F"
                                LineStrokeThickness="2"
                                Orientation="Horizontal" />
                            <local:MFCView
                                x:Name="mfc3"
                                Canvas.Left="815"
                                Canvas.Top="421" />
                            <hc:Divider
                                Canvas.Left="747"
                                Canvas.Top="445"
                                Width="55"
                                LineStroke="#FF7F7F7F"
                                LineStrokeThickness="2"
                                Orientation="Horizontal" />
                            <local:MFCView
                                x:Name="mfc4"
                                Canvas.Left="815"
                                Canvas.Top="491" />
                            <hc:Divider
                                Canvas.Left="747"
                                Canvas.Top="515"
                                Width="55"
                                LineStroke="#FF7F7F7F"
                                LineStrokeThickness="2"
                                Orientation="Horizontal" />
                            <StackPanel
                                Canvas.Left="527"
                                Canvas.Top="532"
                                Orientation="Vertical">
                                <Image
                                    Width="144"
                                    Source="/Images/NewReactor/罐加热（加热）.png"
                                    Visibility="{Binding CurrentDeviceParameter.TempParam.IsControling, Converter={StaticResource Boolean2VisibilityConverter}}" />
                                <Image
                                    Width="144"
                                    Source="/Images/NewReactor/罐加热（制冷）.png"
                                    Visibility="Collapsed" />
                                <Image
                                    Width="144"
                                    Source="/Images/NewReactor/罐加热（常规）.png"
                                    Visibility="{Binding CurrentDeviceParameter.TempParam.IsControling, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                            </StackPanel>
                            <Image
                                Canvas.Left="543"
                                Canvas.Top="458"
                                Width="114"
                                Source="/Images/NewReactor/水.png" />
                            <Image
                                Name="mixPaddle"
                                Canvas.Left="575"
                                Canvas.Top="400"
                                Width="52"
                                Source="/Images/NewReactor/搅拌0.png" />
                            <!--  电机  -->
                            <hc:Divider
                                Canvas.Left="610"
                                Canvas.Top="47"
                                Height="130"
                                LineStroke="#FF7F7F7F"
                                LineStrokeThickness="2"
                                Orientation="Vertical" />
                            <hc:Divider
                                Canvas.Left="616"
                                Canvas.Top="21"
                                Width="215"
                                LineStroke="#FF7F7F7F"
                                LineStrokeThickness="2"
                                Orientation="Horizontal" />
                            <hc:UniformSpacingPanel
                                Canvas.Left="842"
                                Canvas.Top="10"
                                Orientation="Horizontal"
                                Spacing="15">
                                <DockPanel LastChildFill="False">
                                    <materialDesign:PackIcon
                                        Width="40"
                                        Height="40"
                                        DockPanel.Dock="Bottom"
                                        Foreground="{DynamicResource FixedGradientBrush}"
                                        Kind="AlphaMCircle">
                                        <i:Interaction.Triggers>
                                            <i:EventTrigger EventName="MouseLeftButtonDown">
                                                <i:InvokeCommandAction Command="{Binding AgitSettingCommand}" />
                                            </i:EventTrigger>
                                        </i:Interaction.Triggers>
                                    </materialDesign:PackIcon>
                                </DockPanel>
                                <TextBox
                                    Width="100"
                                    materialDesign:HintAssist.Hint="转速(rpm)"
                                    IsEnabled="False"
                                    Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                    Text="{Binding CurrentDeviceParameter.Agit, StringFormat={}{0:F0}}" />
                            </hc:UniformSpacingPanel>
                            <!--  关键参数  -->
                            <hc:Divider
                                Canvas.Left="639"
                                Canvas.Top="164"
                                Width="180"
                                LineStroke="#FF7F7F7F"
                                LineStrokeThickness="2"
                                Orientation="Horizontal" />
                            <hc:Divider
                                Canvas.Left="746"
                                Canvas.Top="95"
                                Width="75"
                                LineStroke="#FF7F7F7F"
                                LineStrokeThickness="2"
                                Orientation="Horizontal" />
                            <hc:UniformSpacingPanel
                                Canvas.Left="842"
                                Canvas.Top="85"
                                Orientation="Horizontal"
                                Spacing="10">
                                <DockPanel LastChildFill="False">
                                    <materialDesign:PackIcon
                                        Width="40"
                                        Height="40"
                                        DockPanel.Dock="Bottom"
                                        Foreground="{DynamicResource FixedGradientBrush}"
                                        Kind="AlphaDCircle">
                                        <i:Interaction.Triggers>
                                            <i:EventTrigger EventName="MouseLeftButtonDown">
                                                <i:InvokeCommandAction Command="{Binding DOSettingCommand}" />
                                            </i:EventTrigger>
                                        </i:Interaction.Triggers>
                                    </materialDesign:PackIcon>
                                </DockPanel>
                                <TextBox
                                    Width="100"
                                    materialDesign:HintAssist.Hint="溶氧(%)"
                                    IsEnabled="False"
                                    Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                    Text="{Binding CurrentDeviceParameter.DO, StringFormat={}{0:F2}}" />
                            </hc:UniformSpacingPanel>
                            <hc:Divider
                                Canvas.Left="740"
                                Canvas.Top="120"
                                Height="135"
                                LineStroke="#FF7F7F7F"
                                LineStrokeThickness="2"
                                Orientation="Vertical" />
                            <hc:UniformSpacingPanel
                                Canvas.Left="842"
                                Canvas.Top="150"
                                Orientation="Horizontal"
                                Spacing="10">
                                <DockPanel LastChildFill="False">
                                    <materialDesign:PackIcon
                                        Width="40"
                                        Height="40"
                                        DockPanel.Dock="Bottom"
                                        Foreground="{DynamicResource FixedGradientBrush}"
                                        Kind="AlphaPCircle">
                                        <i:Interaction.Triggers>
                                            <i:EventTrigger EventName="MouseLeftButtonDown">
                                                <i:InvokeCommandAction Command="{Binding pHSettingCommand}" />
                                            </i:EventTrigger>
                                        </i:Interaction.Triggers>
                                    </materialDesign:PackIcon>
                                </DockPanel>
                                <TextBox
                                    Width="100"
                                    materialDesign:HintAssist.Hint="pH"
                                    IsEnabled="False"
                                    Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                    Text="{Binding CurrentDeviceParameter.PH, StringFormat={}{0:F2}}" />
                            </hc:UniformSpacingPanel>
                            <hc:Divider
                                Canvas.Left="746"
                                Canvas.Top="230"
                                Width="75"
                                LineStroke="#FF7F7F7F"
                                LineStrokeThickness="2"
                                Orientation="Horizontal" />
                            <hc:UniformSpacingPanel
                                Canvas.Left="842"
                                Canvas.Top="215"
                                Orientation="Horizontal"
                                Spacing="15">
                                <DockPanel LastChildFill="False">
                                    <materialDesign:PackIcon
                                        Width="40"
                                        Height="40"
                                        DockPanel.Dock="Bottom"
                                        Foreground="{DynamicResource FixedGradientBrush}"
                                        Kind="AlphaTCircle">
                                        <i:Interaction.Triggers>
                                            <i:EventTrigger EventName="MouseLeftButtonDown">
                                                <i:InvokeCommandAction Command="{Binding TempSettingCommand}" />
                                            </i:EventTrigger>
                                        </i:Interaction.Triggers>
                                    </materialDesign:PackIcon>
                                </DockPanel>
                                <TextBox
                                    Width="100"
                                    materialDesign:HintAssist.Hint="温度(℃)"
                                    IsEnabled="False"
                                    Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                    Text="{Binding CurrentDeviceParameter.Temp, StringFormat={}{0:F2}}" />
                            </hc:UniformSpacingPanel>
                            <hc:UniformSpacingPanel
                                Canvas.Left="575"
                                Canvas.Top="665"
                                Orientation="Horizontal"
                                Spacing="3">
                                <TextBlock FontSize="{StaticResource SubHeadFontSize}" Text="{Binding CurrentDeviceParameter.JarWeight, StringFormat={}{0:F2}}" />
                                <TextBlock FontSize="{StaticResource SubHeadFontSize}" Text="g" />
                            </hc:UniformSpacingPanel>
                        </Canvas>
                    </Grid>
                </TabItem>
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Width="auto" Height="auto">
                            <materialDesign:PackIcon
                                Width="40"
                                Height="40"
                                HorizontalAlignment="Center"
                                Kind="Database" />
                            <TextBlock HorizontalAlignment="Center" Text="数据" />
                        </StackPanel>
                    </TabItem.Header>
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="5" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="auto" />
                        </Grid.RowDefinitions>
                        <Button
                            Width="100"
                            Height="40"
                            HorizontalAlignment="Right"
                            Click="ButtonDeleteBatch_Click"
                            Content="删除数据"
                            Style="{StaticResource ButtonPrimary}" />
                        <DataGrid
                            Name="dataGridBatch"
                            Grid.Row="2"
                            hc:DataGridAttach.CanUnselectAllWithBlankArea="True"
                            hc:DataGridAttach.ShowSelectAllButton="False"
                            AutoGenerateColumns="False"
                            Background="Transparent"
                            CanUserSortColumns="False"
                            ColumnWidth="SizeToCells"
                            FontSize="{DynamicResource NormalFontSize}"
                            HeadersVisibility="Column"
                            IsReadOnly="True"
                            ItemsSource="{Binding BatchCol}"
                            MouseRightButtonDown="DataGrid_MouseRightButtonDown"
                            RowHeaderWidth="60"
                            ScrollViewer.HorizontalScrollBarVisibility="Visible"
                            ScrollViewer.VerticalScrollBarVisibility="Visible"
                            SelectionMode="Extended"
                            SelectionUnit="FullRow">
                            <DataGrid.Columns>
                                <DataGridTextColumn
                                    Width="80"
                                    Binding="{Binding ID}"
                                    CellStyle="{StaticResource DataGridTextCenterCellStyle}"
                                    Header="ID"
                                    HeaderStyle="{StaticResource DataGridCenterColumnHeaderStyle}" />
                                <DataGridTextColumn
                                    Width="180"
                                    Binding="{Binding createTime}"
                                    CellStyle="{StaticResource DataGridTextCenterCellStyle}"
                                    Header="创建时间"
                                    HeaderStyle="{StaticResource DataGridCenterColumnHeaderStyle}" />
                                <DataGridTextColumn
                                    Width="80"
                                    Binding="{Binding devieceID}"
                                    CellStyle="{StaticResource DataGridTextCenterCellStyle}"
                                    Header="反应器"
                                    HeaderStyle="{StaticResource DataGridCenterColumnHeaderStyle}" />
                                <DataGridTextColumn
                                    Width="120"
                                    Binding="{Binding createUser}"
                                    CellStyle="{StaticResource DataGridTextCenterCellStyle}"
                                    Header="创建者"
                                    HeaderStyle="{StaticResource DataGridCenterColumnHeaderStyle}" />
                                <DataGridTextColumn
                                    Width="60"
                                    Binding="{Binding Status}"
                                    CellStyle="{StaticResource DataGridTextCenterCellStyle}"
                                    Header="状态"
                                    HeaderStyle="{StaticResource DataGridCenterColumnHeaderStyle}" />
                                <DataGridTextColumn
                                    Width="120"
                                    Binding="{Binding Strain}"
                                    CellStyle="{StaticResource DataGridTextCenterCellStyle}"
                                    Header="菌种信息"
                                    HeaderStyle="{StaticResource DataGridCenterColumnHeaderStyle}" />
                                <DataGridTextColumn
                                    Width="120"
                                    Binding="{Binding Tester}"
                                    CellStyle="{StaticResource DataGridTextCenterCellStyle}"
                                    Header="测试人员"
                                    HeaderStyle="{StaticResource DataGridCenterColumnHeaderStyle}" />
                                <DataGridTextColumn
                                    Width="300"
                                    Binding="{Binding description}"
                                    CellStyle="{StaticResource DataGridTextCenterCellStyle}"
                                    Header="备注"
                                    HeaderStyle="{StaticResource DataGridCenterColumnHeaderStyle}" />
                                <DataGridTemplateColumn
                                    Width="50"
                                    CellStyle="{StaticResource DataGridTextCenterCellStyle}"
                                    Header="操作"
                                    HeaderStyle="{StaticResource DataGridCenterColumnHeaderStyle}">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <hc:UniformSpacingPanel Orientation="Horizontal" Spacing="5">
                                                <Button
                                                    HorizontalAlignment="Left"
                                                    hc:IconElement.Geometry="{StaticResource GeometryLookDetail}"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Click="ButtonView_Click"
                                                    ToolTip="{ex:Language Key='View'}" />
                                            </hc:UniformSpacingPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <hc:Pagination
                            Name="pagination"
                            Grid.Row="2"
                            Margin="0,0,0,10"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Background="Transparent"
                            DataCountPerPage="{Binding DataCountPerPage}"
                            IsJumpEnabled="True"
                            MaxPageCount="{Binding PageCount}"
                            MaxPageInterval="4"
                            PageIndex="{Binding PageIndex}">
                            <hc:Interaction.Triggers>
                                <hc:EventTrigger EventName="PageUpdated">
                                    <hc:EventToCommand Command="{Binding PageUpdatedCommand}" PassEventArgsToCommand="True" />
                                </hc:EventTrigger>
                            </hc:Interaction.Triggers>
                        </hc:Pagination>
                    </Grid>
                </TabItem>
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Width="auto" Height="auto">
                            <materialDesign:PackIcon
                                Width="40"
                                Height="40"
                                HorizontalAlignment="Center"
                                Kind="Apps" />
                            <TextBlock HorizontalAlignment="Center" Text="设置" />
                        </StackPanel>
                    </TabItem.Header>
                    <local:PadConfigurationView HorizontalAlignment="Left" VerticalAlignment="Top" />
                </TabItem>
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Width="auto" Height="auto">
                            <materialDesign:PackIcon
                                Width="40"
                                Height="40"
                                HorizontalAlignment="Center"
                                Kind="AlphaCBoxOutline" />
                            <TextBlock HorizontalAlignment="Center" Text="标定" />
                        </StackPanel>
                    </TabItem.Header>
                    <local:PadCalibrationView
                        x:Name="calibrationView"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top" />
                </TabItem>
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Width="auto" Height="auto">
                            <materialDesign:PackIcon
                                Width="40"
                                Height="40"
                                HorizontalAlignment="Center"
                                Kind="Alarm" />
                            <TextBlock HorizontalAlignment="Center" Text="报警" />
                        </StackPanel>
                    </TabItem.Header>
                    <StackPanel Margin="16">
                        <TextBlock
                            Margin="0,0,0,8"
                            Style="{StaticResource MaterialDesignHeadline5TextBlock}"
                            Text="Sounds" />
                        <TextBlock>
                            <Run Text="tab 4 content. Default look and behaviors." />
                            <LineBreak />
                            <LineBreak />
                        </TextBlock>
                    </StackPanel>
                </TabItem>
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Width="auto" Height="auto">
                            <materialDesign:PackIcon
                                Width="40"
                                Height="40"
                                HorizontalAlignment="Center"
                                Kind="FileSign" />
                            <TextBlock HorizontalAlignment="Center" Text="审计" />
                        </StackPanel>
                    </TabItem.Header>
                    <StackPanel Margin="16" />
                </TabItem>
            </TabControl>
        </materialDesign:Card>
    </DockPanel>
</hc:GlowWindow>
