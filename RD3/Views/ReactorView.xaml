                                            Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType={x:Type ToggleButton}}}"
                                            Height="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType={x:Type ToggleButton}}}"
                                            BorderBrush="{DynamicResource PrimaryBrush}"
                                            BorderThickness="1"
                                            CornerRadius="{StaticResource DefaultCornerRadius}">
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Foreground="{DynamicResource PrimaryBrush}"
                                                Text="关闭" />
                                        </Border>
                                    </ToggleButton>
                                    <StackPanel VerticalAlignment="Bottom" Orientation="Vertical">
                                        <CheckBox
                                            Content="正向(+)"
                                            IsChecked="{Binding CurrentDeviceParameter.DOParam.IsDirect, UpdateSourceTrigger=PropertyChanged}"
                                            IsEnabled="{Binding CurrentDeviceParameter.DOParam.IsControling, Converter={StaticResource InverseBooleanConverter}}" />
                                        <CheckBox
                                            Content="反向(-)"
                                            IsChecked="{Binding CurrentDeviceParameter.DOParam.IsReverse, UpdateSourceTrigger=PropertyChanged}"
                                            IsEnabled="{Binding CurrentDeviceParameter.DOParam.IsControling, Converter={StaticResource InverseBooleanConverter}}" />
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBox
                                        Width="75"
                                        VerticalAlignment="Center"
                                        hc:InfoElement.Title="{ex:Language Key='转速(rpm)'}"
                                        BorderBrush="Gray"
                                        Style="{StaticResource TextBoxExtend}"
                                        Text="{Binding CurrentDeviceParameter.AgitParam.Agit_PV, StringFormat={}{0:F0}, UpdateSourceTrigger=LostFocus}">
