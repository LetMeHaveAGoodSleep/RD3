<UserControl
    x:Class="RD3.Views.pHSettingView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:control="clr-namespace:RD3.Controls"
    xmlns:controls="clr-namespace:RD3.Controls;assembly=RD3.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:local="clr-namespace:RD3.Views"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:share="clr-namespace:RD3.Shared;assembly=RD3.Shared"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    xmlns:viewmodels="clr-namespace:RD3.ViewModels"
    Width="800"
    Height="550"
    d:DataContext="{d:DesignInstance Type=viewmodels:pHSettingViewModel}"
    prism:ViewModelLocator.AutoWireViewModel="True"
    Background="{StaticResource RegionBackgroundBrush}"
    FontSize="{StaticResource SubHeadFontSize}"
    mc:Ignorable="d">
    <prism:Dialog.WindowStyle>
        <Style TargetType="Window">
            <Setter Property="SizeToContent" Value="WidthAndHeight" />
            <Setter Property="ResizeMode" Value="NoResize" />
            <Setter Property="prism:Dialog.WindowStartupLocation" Value="CenterScreen" />
            <Setter Property="Width" Value="{Binding FormWidth, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <Setter Property="Height" Value="{Binding FormHeight, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <Setter Property="Left" Value="{Binding LeftLocation, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <Setter Property="Top" Value="{Binding TopLocation, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <Setter Property="ShowInTaskbar" Value="True" />
            <Setter Property="AllowsTransparency" Value="False" />
            <Setter Property="WindowStyle" Value="SingleBorderWindow" />
            <Setter Property="WindowState" Value="{Binding FormState, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <Setter Property="Background" Value="{StaticResource RegionBackgroundBrush}" />
            <Setter Property="Opacity" Value="1" />
            <Setter Property="Icon" Value="../Assets/logo.png" />
        </Style>
    </prism:Dialog.WindowStyle>
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto" />
            <ColumnDefinition Width="auto" />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <local:TimeSeriesView
            x:Name="tsView"
            HorizontalAlignment="Left"
            VerticalAlignment="Top" />
        <GridSplitter
            Grid.Column="1"
            Width="5"
            Background="LightGray"
            IsEnabled="False" />
        <Grid Grid.Column="2" Margin="5,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="10" />
                <RowDefinition Height="auto" />
            </Grid.RowDefinitions>
            <WrapPanel Name="panelMethod" />
            <hc:UniformSpacingPanel
                Grid.Row="1"
                Orientation="Vertical"
                Spacing="15">
                <hc:UniformSpacingPanel Orientation="Horizontal" Spacing="10">
                    <control:TextBoxNoAutoKeyboard
                        Width="100"
                        materialDesign:HintAssist.Hint="pH下限"
                        materialDesign:TextFieldAssist.HasClearButton="True"
                        IsEnabled="{Binding CurrentDeviceParameter.PHParam.IsControling, Converter={StaticResource InverseBooleanConverter}}"
                        Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                        Text="{Binding CurrentDeviceParameter.PHParam.LowerLimit, StringFormat={}{0:F2}}">
                        <i:Interaction.Triggers>
                            <i:EventTrigger EventName="PreviewMouseLeftButtonDown">
                                <i:InvokeCommandAction Command="{Binding OpenNumberKeyBoardCommand}" />
                            </i:EventTrigger>
                        </i:Interaction.Triggers>
                    </control:TextBoxNoAutoKeyboard>
                    <control:TextBoxNoAutoKeyboard
                        Width="100"
                        materialDesign:HintAssist.Hint="pH上限"
                        materialDesign:TextFieldAssist.HasClearButton="True"
                        IsEnabled="{Binding CurrentDeviceParameter.PHParam.IsControling, Converter={StaticResource InverseBooleanConverter}}"
                        Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                        Text="{Binding CurrentDeviceParameter.PHParam.UpperLimit, StringFormat={}{0:F2}}">
                        <i:Interaction.Triggers>
                            <i:EventTrigger EventName="PreviewMouseLeftButtonDown">
                                <i:InvokeCommandAction Command="{Binding OpenNumberKeyBoardCommand}" />
                            </i:EventTrigger>
                        </i:Interaction.Triggers>
                    </control:TextBoxNoAutoKeyboard>
                    <control:TextBoxNoAutoKeyboard
                        Width="100"
                        materialDesign:HintAssist.Hint="pH当前值"
                        materialDesign:TextFieldAssist.HasClearButton="True"
                        IsEnabled="False"
                        Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                        Text="{Binding CurrentDeviceParameter.PH, StringFormat={}{0:F2}}"
                        Visibility="Collapsed">
                        <i:Interaction.Triggers>
                            <i:EventTrigger EventName="PreviewMouseLeftButtonDown">
                                <i:InvokeCommandAction Command="{Binding OpenNumberKeyBoardCommand}" />
                            </i:EventTrigger>
                        </i:Interaction.Triggers>
                    </control:TextBoxNoAutoKeyboard>
                </hc:UniformSpacingPanel>
                <GroupBox Style="{StaticResource GroupBoxTab}">
                    <GroupBox.Header>
                        <CheckBox
                            HorizontalAlignment="Center"
                            Content="关联酸(-)"
                            IsChecked="{Binding CurrentDeviceParameter.PHParam.AcidAssociated}" />
                    </GroupBox.Header>
                    <hc:UniformSpacingPanel Orientation="Horizontal" Spacing="10">
                        <control:TextBoxNoAutoKeyboard
                            Width="70"
                            materialDesign:HintAssist.Hint="比例P"
                            Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                            Text="{Binding CurrentDeviceParameter.PHParam.AcidPID.P, StringFormat={}{0:F2}}">
                            <i:Interaction.Triggers>
                                <i:EventTrigger EventName="PreviewMouseLeftButtonDown">
                                    <i:InvokeCommandAction Command="{Binding OpenNumberKeyBoardCommand}" />
                                </i:EventTrigger>
                            </i:Interaction.Triggers>
                        </control:TextBoxNoAutoKeyboard>
                        <control:TextBoxNoAutoKeyboard
                            Width="70"
                            materialDesign:HintAssist.Hint="积分I"
                            Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                            Text="{Binding CurrentDeviceParameter.PHParam.AcidPID.I, StringFormat={}{0:F2}}">
                            <i:Interaction.Triggers>
                                <i:EventTrigger EventName="PreviewMouseLeftButtonDown">
                                    <i:InvokeCommandAction Command="{Binding OpenNumberKeyBoardCommand}" />
                                </i:EventTrigger>
                            </i:Interaction.Triggers>
                        </control:TextBoxNoAutoKeyboard>
                        <control:TextBoxNoAutoKeyboard
                            Width="70"
                            materialDesign:HintAssist.Hint="微分D"
                            Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                            Text="{Binding CurrentDeviceParameter.PHParam.AcidPID.D, StringFormat={}{0:F2}}">
                            <i:Interaction.Triggers>
                                <i:EventTrigger EventName="PreviewMouseLeftButtonDown">
                                    <i:InvokeCommandAction Command="{Binding OpenNumberKeyBoardCommand}" />
                                </i:EventTrigger>
                            </i:Interaction.Triggers>
                        </control:TextBoxNoAutoKeyboard>
                        <control:TextBoxNoAutoKeyboard
                            Width="70"
                            materialDesign:HintAssist.Hint="死区"
                            Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                            Text="{Binding CurrentDeviceParameter.PHParam.AcidPID.deadArea, StringFormat={}{0:F2}}">
                            <i:Interaction.Triggers>
                                <i:EventTrigger EventName="PreviewMouseLeftButtonDown">
                                    <i:InvokeCommandAction Command="{Binding OpenNumberKeyBoardCommand}" />
                                </i:EventTrigger>
                            </i:Interaction.Triggers>
                        </control:TextBoxNoAutoKeyboard>
                    </hc:UniformSpacingPanel>
                </GroupBox>
                <GroupBox Style="{StaticResource GroupBoxTab.Small}">
                    <GroupBox.Header>
                        <CheckBox
                            HorizontalAlignment="Center"
                            Content="关联碱(+)"
                            IsChecked="{Binding CurrentDeviceParameter.PHParam.BaseAssociated}" />
                    </GroupBox.Header>
                    <hc:UniformSpacingPanel Orientation="Horizontal" Spacing="10">
                        <control:TextBoxNoAutoKeyboard
                            Width="70"
                            materialDesign:HintAssist.Hint="比例P"
                            Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                            Text="{Binding CurrentDeviceParameter.PHParam.BasePID.P, StringFormat={}{0:F2}}">
                            <i:Interaction.Triggers>
                                <i:EventTrigger EventName="PreviewMouseLeftButtonDown">
                                    <i:InvokeCommandAction Command="{Binding OpenNumberKeyBoardCommand}" />
                                </i:EventTrigger>
                            </i:Interaction.Triggers>
                        </control:TextBoxNoAutoKeyboard>
                        <control:TextBoxNoAutoKeyboard
                            Width="70"
                            materialDesign:HintAssist.Hint="积分I"
                            Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                            Text="{Binding CurrentDeviceParameter.PHParam.BasePID.I, StringFormat={}{0:F2}}">
                            <i:Interaction.Triggers>
                                <i:EventTrigger EventName="PreviewMouseLeftButtonDown">
                                    <i:InvokeCommandAction Command="{Binding OpenNumberKeyBoardCommand}" />
                                </i:EventTrigger>
                            </i:Interaction.Triggers>
                        </control:TextBoxNoAutoKeyboard>
                        <control:TextBoxNoAutoKeyboard
                            Width="70"
                            materialDesign:HintAssist.Hint="微分D"
                            Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                            Text="{Binding CurrentDeviceParameter.PHParam.BasePID.D, StringFormat={}{0:F2}}">
                            <i:Interaction.Triggers>
                                <i:EventTrigger EventName="PreviewMouseLeftButtonDown">
                                    <i:InvokeCommandAction Command="{Binding OpenNumberKeyBoardCommand}" />
                                </i:EventTrigger>
                            </i:Interaction.Triggers>
                        </control:TextBoxNoAutoKeyboard>
                        <control:TextBoxNoAutoKeyboard
                            Width="70"
                            materialDesign:HintAssist.Hint="死区"
                            Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                            Text="{Binding CurrentDeviceParameter.PHParam.BasePID.deadArea, StringFormat={}{0:F2}}">
                            <i:Interaction.Triggers>
                                <i:EventTrigger EventName="PreviewMouseLeftButtonDown">
                                    <i:InvokeCommandAction Command="{Binding OpenNumberKeyBoardCommand}" />
                                </i:EventTrigger>
                            </i:Interaction.Triggers>
                        </control:TextBoxNoAutoKeyboard>
                    </hc:UniformSpacingPanel>
                </GroupBox>
            </hc:UniformSpacingPanel>
            <hc:SimplePanel
                x:Name="panelContent"
                Grid.Row="2"
                Margin="0,10,0,0" />
            <DockPanel Grid.Row="4" LastChildFill="False">
                <hc:UniformSpacingPanel
                    DockPanel.Dock="Right"
                    Orientation="Horizontal"
                    Spacing="10">
                    <Button
                        Width="90"
                        Height="40"
                        Command="{Binding OpenCommand}"
                        Content="启动控制"
                        IsEnabled="{Binding CurrentDeviceParameter.PHParam.IsControling, Converter={StaticResource InverseBooleanConverter}}"
                        Style="{StaticResource PrimaryCommonButton}" />
                    <Button
                        Width="90"
                        Height="40"
                        Command="{Binding CloseCommand}"
                        Content="停止控制"
                        IsEnabled="{Binding CurrentDeviceParameter.PHParam.IsControling}"
                        Style="{StaticResource SecondaryCommonButton}" />
                </hc:UniformSpacingPanel>
            </DockPanel>
        </Grid>
    </Grid>
</UserControl>
