<UserControl
    x:Class="RD3.Views.DOEAnalyse3DView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:RD3.Controls;assembly=RD3.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ex="clr-namespace:LayUI.Wpf.Extensions;assembly=LayUI.Wpf.Extensions"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:helix="http://helix-toolkit.org/wpf"
    xmlns:local="clr-namespace:RD3.Views"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:rd3="clr-namespace:RD3"
    xmlns:shared="clr-namespace:RD3.Shared;assembly=RD3.Shared"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    xmlns:viewmodels="clr-namespace:RD3.ViewModels"
    xmlns:wpf="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
    Width="800"
    Height="800"
    d:DataContext="{d:DesignInstance Type=viewmodels:DOEAnalyse3DViewModel}"
    rd3:DraggableUserControlAttach.IsDraggable="True"
    TextElement.FontFamily="{DynamicResource AppFontFamily}"
    TextElement.FontSize="{DynamicResource TextFontSize}"
    TextElement.FontWeight="Regular"
    TextElement.Foreground="{DynamicResource MaterialDesignBody}"
    TextOptions.TextFormattingMode="Ideal"
    TextOptions.TextRenderingMode="Auto"
    mc:Ignorable="d">
    <prism:Dialog.WindowStyle>
        <Style TargetType="Window">
            <Setter Property="SizeToContent" Value="WidthAndHeight" />
            <Setter Property="ResizeMode" Value="NoResize" />
            <Setter Property="prism:Dialog.WindowStartupLocation" Value="CenterScreen" />
            <Setter Property="Width" Value="{Binding FormWidth, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <Setter Property="Height" Value="{Binding FormHeight, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <Setter Property="Left" Value="{Binding LeftLocation, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <Setter Property="Top" Value="{Binding TopLocation, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <Setter Property="ShowInTaskbar" Value="True" />
            <Setter Property="AllowsTransparency" Value="False" />
            <Setter Property="WindowStyle" Value="ThreeDBorderWindow" />
            <Setter Property="WindowState" Value="{Binding FormState, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <Setter Property="Opacity" Value="1" />
            <Setter Property="Background" Value="{StaticResource BackGroundBrush}" />
        </Style>
    </prism:Dialog.WindowStyle>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="1.5*" />
            <RowDefinition Height="10" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <DockPanel LastChildFill="True">
            <hc:UniformSpacingPanel
                DockPanel.Dock="Top"
                Orientation="Horizontal"
                Spacing="5">
                <TextBox
                    Name="txtOrder"
                    Width="70"
                    hc:InfoElement.Title="阶数:"
                    hc:InfoElement.TitlePlacement="Top"
                    Foreground="{StaticResource PrimaryBrush}"
                    Style="{StaticResource TextBoxExtend}"
                    Text="{Binding Order}" />
                <DockPanel LastChildFill="False">
                    <ComboBox
                        hc:InfoElement.Title="算法:"
                        DockPanel.Dock="Bottom"
                        IsReadOnly="True"
                        SelectedIndex="0"
                        Style="{StaticResource ComboBoxExtend}">
                        <ComboBoxItem Content="LM算法+LU分解" />
                    </ComboBox>
                </DockPanel>
                <TextBox
                    Name="txtMSE"
                    Width="90"
                    hc:InfoElement.Title="MSE:"
                    hc:InfoElement.TitlePlacement="Top"
                    Foreground="{StaticResource PrimaryBrush}"
                    IsReadOnly="True"
                    Style="{StaticResource TextBoxExtend}"
                    Text="{Binding MSE, StringFormat={}{0:F0}}" />
                <hc:NumericUpDown
                    Name="xFactorNumericUpDown"
                    hc:InfoElement.Title="X:"
                    hc:InfoElement.TitlePlacement="Top"
                    DecimalPlaces="2"
                    Increment="{Binding XFactor2DParam.Frequency}"
                    Maximum="{Binding XFactor2DParam.Maximum}"
                    Minimum="{Binding XFactor2DParam.Minimum}"
                    Style="{StaticResource NumericUpDownExtend}"
                    ValueChanged="NumericUpDown_ValueChanged"
                    Value="{Binding XFactor2DParam.CurrentValue}" />
                <hc:NumericUpDown
                    Name="yFactorNumericUpDown"
                    hc:InfoElement.Title="Y:"
                    hc:InfoElement.TitlePlacement="Top"
                    DecimalPlaces="2"
                    Increment="{Binding YFactor2DParam.Frequency}"
                    Maximum="{Binding YFactor2DParam.Maximum}"
                    Minimum="{Binding YFactor2DParam.Minimum}"
                    Style="{StaticResource NumericUpDownExtend}"
                    ValueChanged="NumericUpDown_ValueChanged"
                    Value="{Binding YFactor2DParam.CurrentValue}" />
                <TextBox
                    Name="txtAxesZ"
                    Width="70"
                    hc:InfoElement.Title="Z:"
                    hc:InfoElement.TitlePlacement="Top"
                    Foreground="{StaticResource PrimaryBrush}"
                    IsReadOnly="True"
                    Style="{StaticResource TextBoxExtend}"
                    Text="{Binding Prediction, StringFormat={}{0:F2}}" />
                <DockPanel LastChildFill="False">
                    <Button
                        Name="btnPredictMax"
                        Width="70"
                        Command="{Binding PredictMaxCommand}"
                        Content="最大"
                        DockPanel.Dock="Bottom"
                        Style="{StaticResource ButtonDefault}" />
                </DockPanel>
                <DockPanel LastChildFill="False">
                    <Button
                        Name="btnPredictMini"
                        Width="70"
                        Command="{Binding PredictMinCommand}"
                        Content="最小"
                        DockPanel.Dock="Bottom"
                        Style="{StaticResource ButtonDefault}" />
                </DockPanel>
            </hc:UniformSpacingPanel>
            <controls:HelixSurfaceView
                x:Name="helixSurfaceView"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch" />
        </DockPanel>
        <wpf:WpfPlot Name="wpfPlot" Grid.Row="2" />
    </Grid>
</UserControl>
