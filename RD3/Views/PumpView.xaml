<UserControl
    x:Class="RD3.Views.PumpView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:local="clr-namespace:RD3.Views"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:rd3="clr-namespace:RD3"
    xmlns:share="clr-namespace:RD3.Shared;assembly=RD3.Shared"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    xmlns:system="clr-namespace:System;assembly=netstandard"
    xmlns:vm="clr-namespace:RD3.ViewModels"
    Width="345"
    Height="45"
    d:DataContext="{d:DesignInstance Type=vm:PumpViewModel}"
    prism:ViewModelLocator.AutoWireViewModel="True"
    Background="Transparent"
    FontSize="{StaticResource SubHeadFontSize}"
    Foreground="Black"
    Visibility="{Binding PumpInfo.IsEnable, Converter={StaticResource Boolean2VisibilityConverter}}"
    mc:Ignorable="d">
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="MouseUp">
            <i:InvokeCommandAction Command="{Binding PumpSettingCommand}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <Border
        x:Name="borderMain"
        CornerRadius="24"
        Style="{StaticResource BorderHighlight}"
        Tag="{Binding PumpInfo.RunningStr}">
        <StackPanel
            Margin="8,0,8,0"
            VerticalAlignment="Center"
            Orientation="Horizontal">
            <Image
                x:Name="pumpState"
                Width="22"
                Height="22"
                Source="/Images/Index/PumpEnable.png" />
            <TextBlock
                x:Name="txtPumpName"
                Width="45"
                Margin="9,0,0,0"
                VerticalAlignment="Center"
                FontSize="{StaticResource MediumFontSize}"
                Text="{Binding PumpInfo.PumpName}" />
            <Border
                Width="55"
                Height="25"
                Margin="5,0,0,0"
                Background="#dee3e4"
                CornerRadius="4">
                <TextBlock
                    x:Name="txtPumpFlowrate_sp"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="{StaticResource SubHeadFontSize}"
                    Foreground="Black"
                    Text="{Binding PumpInfo.FlowRate_SP}" />
            </Border>
            <TextBlock
                x:Name="txtPumpFlowrate"
                Width="45"
                Margin="5,0,0,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontSize="{StaticResource SubHeadFontSize}"
                Text="{Binding PumpInfo.FlowRate}" />
            <TextBlock
                Margin="3,0,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Text="mL/h" />
            <Image
                x:Name="imgBottle"
                Width="12"
                Height="20"
                Margin="5,0,0,0"
                Source="/Images/NewReactor/小瓶.png"
                Visibility="{Binding PumpInfo.IsWeigh, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="MouseUp">
                        <i:InvokeCommandAction Command="{Binding PumpClearCommand}" PassEventArgsToCommand="True" />
                    </i:EventTrigger>
                </i:Interaction.Triggers>
            </Image>
            <Image
                x:Name="imgWeightBottle"
                Width="12"
                Height="20"
                Margin="5,0,0,0"
                Source="/Images/NewReactor/小瓶（称重）.png"
                Visibility="{Binding PumpInfo.IsWeigh, Converter={StaticResource Boolean2VisibilityConverter}}">
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="MouseUp">
                        <i:InvokeCommandAction Command="{Binding PumpClearCommand}" PassEventArgsToCommand="True" />
                    </i:EventTrigger>
                </i:Interaction.Triggers>
            </Image>
            <StackPanel
                Margin="3,0,0,0"
                VerticalAlignment="Center"
                Orientation="Vertical">
                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                    <TextBlock
                        x:Name="txtPumpCapacity"
                        Width="50"
                        HorizontalAlignment="Right"
                        FontSize="{StaticResource SubHeadFontSize}"
                        Text="{Binding PumpInfo.FlowCapacity}" />
                    <TextBlock
                        Margin="1,0,0,0"
                        HorizontalAlignment="Left"
                        Text="mL" />
                </StackPanel>
                <Separator x:Name="pumpSeparator" Visibility="Collapsed" />
                <!--  垂直分割线  -->
                <StackPanel
                    x:Name="panelWeight"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Visibility="Collapsed">
                    <TextBlock
                        x:Name="txtPumpWeight"
                        Width="50"
                        HorizontalAlignment="Center"
                        FontSize="{StaticResource SubHeadFontSize}" />
                    <TextBlock
                        Margin="1,0,0,0"
                        HorizontalAlignment="Left"
                        Text="g" />
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
