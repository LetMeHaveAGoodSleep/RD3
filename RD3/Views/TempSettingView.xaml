<UserControl
    x:Class="RD3.Views.TempSettingView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:control="clr-namespace:RD3.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:local="clr-namespace:RD3.Views"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:share="clr-namespace:RD3.Shared;assembly=RD3.Shared"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    xmlns:viewmodels="clr-namespace:RD3.ViewModels"
    Width="250"
    Height="500"
    d:DataContext="{d:DesignInstance Type=viewmodels:TempSettingViewModel}"
    prism:ViewModelLocator.AutoWireViewModel="True"
    Background="{StaticResource BackGroundBrush}"
    FontSize="{StaticResource SubHeadFontSize}"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ObjectDataProvider
            x:Key="DataFromEnum"
            MethodName="GetValues"
            ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="share:PeristalticPump" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
        <ObjectDataProvider
            x:Key="DataFromEnum1"
            MethodName="GetValues"
            ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="share:FeedControlMode" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
    </UserControl.Resources>
    <prism:Dialog.WindowStyle>
        <Style TargetType="Window">
            <Setter Property="SizeToContent" Value="WidthAndHeight" />
            <Setter Property="ResizeMode" Value="NoResize" />
            <Setter Property="prism:Dialog.WindowStartupLocation" Value="CenterScreen" />
            <Setter Property="Width" Value="{Binding FormWidth, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <Setter Property="Height" Value="{Binding FormHeight, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <Setter Property="Left" Value="{Binding LeftLocation, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <Setter Property="Top" Value="{Binding TopLocation, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <Setter Property="ShowInTaskbar" Value="True" />
            <Setter Property="AllowsTransparency" Value="False" />
            <Setter Property="WindowStyle" Value="SingleBorderWindow" />
            <Setter Property="WindowState" Value="{Binding FormState, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <Setter Property="Background" Value="{StaticResource BackGroundBrush}" />
            <Setter Property="Opacity" Value="1" />
            <Setter Property="Icon" Value="../Assets/logo.png" />
        </Style>
    </prism:Dialog.WindowStyle>
    <hc:UniformSpacingPanel
        Margin="10"
        Orientation="Vertical"
        Spacing="10">
        <GroupBox Header="基础参数" Style="{StaticResource MaterialDesignGroupBox}">
            <hc:UniformSpacingPanel Orientation="Vertical" Spacing="10">
                <hc:UniformSpacingPanel Orientation="Horizontal" Spacing="10">
                    <control:TextBoxNoAutoKeyboard
                        Width="100"
                        materialDesign:HintAssist.Hint="设定温度(℃)"
                        Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                        Text="{Binding CurrentDeviceParameter.TempParam.Temp_PV, StringFormat={}{0:F2}}">
                        <i:Interaction.Triggers>
                            <i:EventTrigger EventName="PreviewMouseLeftButtonDown">
                                <i:InvokeCommandAction Command="{Binding OpenNumberKeyBoardCommand}" />
                            </i:EventTrigger>
                        </i:Interaction.Triggers>
                    </control:TextBoxNoAutoKeyboard>
                    <TextBox
                        Width="100"
                        materialDesign:HintAssist.Hint="当前温度(℃)"
                        IsEnabled="False"
                        Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                        Text="{Binding CurrentDeviceParameter.Temp, StringFormat={}{0:F2}}" />
                </hc:UniformSpacingPanel>
                <hc:UniformSpacingPanel Orientation="Horizontal" Spacing="10">
                    <control:TextBoxNoAutoKeyboard
                        Width="100"
                        materialDesign:HintAssist.Hint="温度下限(℃)"
                        IsEnabled="{Binding CurrentDeviceParameter.TempParam.IsControling, Converter={StaticResource InverseBooleanConverter}}"
                        Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                        Text="{Binding CurrentDeviceParameter.TempParam.LowerLimit, StringFormat={}{0:F2}}">
                        <i:Interaction.Triggers>
                            <i:EventTrigger EventName="PreviewMouseLeftButtonDown">
                                <i:InvokeCommandAction Command="{Binding OpenNumberKeyBoardCommand}" />
                            </i:EventTrigger>
                        </i:Interaction.Triggers>
                    </control:TextBoxNoAutoKeyboard>
                    <control:TextBoxNoAutoKeyboard
                        Width="100"
                        materialDesign:HintAssist.Hint="温度上限(℃)"
                        IsEnabled="{Binding CurrentDeviceParameter.TempParam.IsControling, Converter={StaticResource InverseBooleanConverter}}"
                        Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                        Text="{Binding CurrentDeviceParameter.TempParam.UpperLimit, StringFormat={}{0:F2}}">
                        <i:Interaction.Triggers>
                            <i:EventTrigger EventName="PreviewMouseLeftButtonDown">
                                <i:InvokeCommandAction Command="{Binding OpenNumberKeyBoardCommand}" />
                            </i:EventTrigger>
                        </i:Interaction.Triggers>
                    </control:TextBoxNoAutoKeyboard>
                </hc:UniformSpacingPanel>
                <ToggleButton
                    Width="210"
                    Height="40"
                    IsChecked="{Binding CurrentDeviceParameter.TempParam.IsControling}"
                    Style="{StaticResource MaterialDesignSwitchLightToggleButton}" />
            </hc:UniformSpacingPanel>
        </GroupBox>
        <GroupBox
            Header="PID参数"
            Style="{StaticResource MaterialDesignGroupBox}"
            Visibility="{Binding CurrentDeviceParameter.PHParam.PHControlMode, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=PID, UpdateSourceTrigger=PropertyChanged}">
            <hc:UniformSpacingPanel Orientation="Vertical" Spacing="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <control:TextBoxNoAutoKeyboard
                        materialDesign:HintAssist.Hint="比例P"
                        Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                        Text="{Binding CurrentDeviceParameter.TempParam.PIDParam.P, StringFormat={}{0:F2}}">
                        <i:Interaction.Triggers>
                            <i:EventTrigger EventName="PreviewMouseLeftButtonDown">
                                <i:InvokeCommandAction Command="{Binding OpenNumberKeyBoardCommand}" />
                            </i:EventTrigger>
                        </i:Interaction.Triggers>
                    </control:TextBoxNoAutoKeyboard>
                    <control:TextBoxNoAutoKeyboard
                        Grid.Column="2"
                        materialDesign:HintAssist.Hint="积分I"
                        Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                        Text="{Binding CurrentDeviceParameter.TempParam.PIDParam.I, StringFormat={}{0:F2}}">
                        <i:Interaction.Triggers>
                            <i:EventTrigger EventName="PreviewMouseLeftButtonDown">
                                <i:InvokeCommandAction Command="{Binding OpenNumberKeyBoardCommand}" />
                            </i:EventTrigger>
                        </i:Interaction.Triggers>
                    </control:TextBoxNoAutoKeyboard>
                    <control:TextBoxNoAutoKeyboard
                        Grid.Row="2"
                        materialDesign:HintAssist.Hint="微分D"
                        Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                        Text="{Binding CurrentDeviceParameter.TempParam.PIDParam.D, StringFormat={}{0:F2}}">
                        <i:Interaction.Triggers>
                            <i:EventTrigger EventName="PreviewMouseLeftButtonDown">
                                <i:InvokeCommandAction Command="{Binding OpenNumberKeyBoardCommand}" />
                            </i:EventTrigger>
                        </i:Interaction.Triggers>
                    </control:TextBoxNoAutoKeyboard>
                    <control:TextBoxNoAutoKeyboard
                        Grid.Row="2"
                        Grid.Column="2"
                        materialDesign:HintAssist.Hint="系数K"
                        Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                        Text="{Binding CurrentDeviceParameter.TempParam.PIDParam.K, StringFormat={}{0:F2}}">
                        <i:Interaction.Triggers>
                            <i:EventTrigger EventName="PreviewMouseLeftButtonDown">
                                <i:InvokeCommandAction Command="{Binding OpenNumberKeyBoardCommand}" />
                            </i:EventTrigger>
                        </i:Interaction.Triggers>
                    </control:TextBoxNoAutoKeyboard>
                </Grid>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button
                        Width="100"
                        Height="35"
                        Command="{Binding ReadPIDCommand}"
                        Content="读取"
                        Style="{StaticResource ButtonInfo}" />
                    <DockPanel Grid.Column="2" LastChildFill="True">
                        <Button
                            Width="100"
                            Height="35"
                            Command="{Binding SetPIDCommand}"
                            Content="设置"
                            Style="{StaticResource ButtonPrimary}" />
                    </DockPanel>
                </Grid>
            </hc:UniformSpacingPanel>
        </GroupBox>
    </hc:UniformSpacingPanel>
</UserControl>

