<UserControl
    x:Class="RD3.Views.AlarmRecordView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ex="clr-namespace:LayUI.Wpf.Extensions;assembly=LayUI.Wpf.Extensions"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:local="clr-namespace:RD3.Views"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:viewmodels="clr-namespace:RD3.ViewModels"
    d:DataContext="{d:DesignInstance Type=viewmodels:AlarmRecordViewModel}"
    d:DesignHeight="700"
    d:DesignWidth="1350"
    prism:ViewModelLocator.AutoWireViewModel="True"
    Background="{StaticResource BackGroundBrush}"
    FontSize="{StaticResource HeadFontSize}"
    TextElement.FontFamily="{DynamicResource AppFontFamily}"
    TextElement.FontSize="{StaticResource SubHeadFontSize}"
    TextElement.FontWeight="Regular"
    TextElement.Foreground="{DynamicResource MaterialDesignBody}"
    TextOptions.TextFormattingMode="Ideal"
    TextOptions.TextRenderingMode="Auto"
    mc:Ignorable="d">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="5" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <DockPanel LastChildFill="False">
            <hc:SearchBar
                Name="txtSearch"
                Width="240"
                Height="40"
                hc:InfoElement.ShowClearButton="True"
                DockPanel.Dock="Left"
                IsRealTime="True">
                <hc:Interaction.Triggers>
                    <hc:EventTrigger EventName="SearchStarted">
                        <hc:EventToCommand Command="{Binding SearchCommand}" PassEventArgsToCommand="True" />
                    </hc:EventTrigger>
                </hc:Interaction.Triggers>
            </hc:SearchBar>
            <hc:Pagination
                Background="Transparent"
                DataCountPerPage="{Binding DataCountPerPage}"
                DockPanel.Dock="Right"
                IsJumpEnabled="True"
                MaxPageCount="{Binding PageCount}"
                MaxPageInterval="4"
                PageIndex="{Binding PageIndex}">
                <hc:Interaction.Triggers>
                    <hc:EventTrigger EventName="PageUpdated">
                        <hc:EventToCommand Command="{Binding PageUpdatedCommand}" PassEventArgsToCommand="True" />
                    </hc:EventTrigger>
                </hc:Interaction.Triggers>
            </hc:Pagination>
        </DockPanel>
        <DataGrid
            Grid.Row="2"
            hc:DataGridAttach.CanUnselectAllWithBlankArea="True"
            hc:DataGridAttach.ShowRowNumber="True"
            hc:DataGridAttach.ShowSelectAllButton="False"
            AutoGenerateColumns="False"
            Background="Transparent"
            CanUserSortColumns="True"
            ColumnWidth="SizeToCells"
            EnableColumnVirtualization="True"
            EnableRowVirtualization="True"
            HeadersVisibility="Column"
            IsReadOnly="True"
            ItemsSource="{Binding AlarmRecordCol}"
            RowHeaderWidth="60"
            ScrollViewer.HorizontalScrollBarVisibility="Auto"
            ScrollViewer.VerticalScrollBarVisibility="Auto"
            SelectionMode="Extended"
            Style="{StaticResource DataGridBaseStyle}"
            VirtualizingStackPanel.VirtualizationMode="Recycling">
            <DataGrid.Columns>
                <DataGridTextColumn
                    Width="100"
                    Binding="{Binding Reactor}"
                    CellStyle="{StaticResource DataGridTextCenterCellStyle}"
                    Header="{ex:Language Key='反应器'}"
                    HeaderStyle="{StaticResource DataGridCenterColumnHeaderStyle}"
                    Visibility="Collapsed" />
                <DataGridTextColumn
                    Width="150"
                    Binding="{Binding Source}"
                    CellStyle="{StaticResource DataGridTextCenterCellStyle}"
                    Header="{ex:Language Key='报警源'}"
                    HeaderStyle="{StaticResource DataGridCenterColumnHeaderStyle}" />
                <DataGridTextColumn
                    Width="150"
                    Binding="{Binding Module}"
                    CellStyle="{StaticResource DataGridTextCenterCellStyle}"
                    Header="{ex:Language Key='模块'}"
                    HeaderStyle="{StaticResource DataGridCenterColumnHeaderStyle}" />
                <DataGridTextColumn
                    Width="100"
                    Binding="{Binding Grade}"
                    CellStyle="{StaticResource DataGridTextCenterCellStyle}"
                    Header="{ex:Language Key='等级'}"
                    HeaderStyle="{StaticResource DataGridCenterColumnHeaderStyle}" />
                <DataGridTextColumn
                    Width="250"
                    Binding="{Binding Remark}"
                    CellStyle="{StaticResource DataGridTextCenterCellStyle}"
                    Header="{ex:Language Key='描述'}"
                    HeaderStyle="{StaticResource DataGridCenterColumnHeaderStyle}" />
                <DataGridTemplateColumn
                    Width="200"
                    CellStyle="{StaticResource DataGridTextCenterCellStyle}"
                    Header="{ex:Language Key='报警时间'}"
                    HeaderStyle="{StaticResource DataGridCenterColumnHeaderStyle}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding AlarmTime, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn
                    Width="200"
                    CellStyle="{StaticResource DataGridTextCenterCellStyle}"
                    Header="{ex:Language Key='消除时间'}"
                    HeaderStyle="{StaticResource DataGridCenterColumnHeaderStyle}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding RemoveTime, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
