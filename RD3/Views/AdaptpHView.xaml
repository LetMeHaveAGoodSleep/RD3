<UserControl
    x:Class="RD3.Views.AdaptpHView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behavior="clr-namespace:RD3.Behaviors"
    xmlns:common="clr-namespace:RD3.Common"
    xmlns:cv="clr-namespace:RD3.Common.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ex="clr-namespace:LayUI.Wpf.Extensions;assembly=LayUI.Wpf.Extensions"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:local="clr-namespace:RD3.Views"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:share="clr-namespace:RD3.Shared;assembly=RD3.Shared"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    xmlns:vm="clr-namespace:RD3.ViewModels"
    xmlns:wpf="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
    Width="550"
    Height="250"
    d:DataContext="{d:DesignInstance Type=vm:AdaptpHViewModel}"
    TextElement.FontFamily="{DynamicResource AppFontFamily}"
    TextElement.FontSize="{DynamicResource TextFontSize}"
    TextElement.FontWeight="Regular"
    TextElement.Foreground="{DynamicResource MaterialDesignBody}"
    TextOptions.TextFormattingMode="Ideal"
    TextOptions.TextRenderingMode="Auto"
    mc:Ignorable="d">
    <prism:Dialog.WindowStyle>
        <Style TargetType="Window">
            <Setter Property="SizeToContent" Value="WidthAndHeight" />
            <Setter Property="ResizeMode" Value="NoResize" />
            <Setter Property="prism:Dialog.WindowStartupLocation" Value="CenterOwner" />
            <Setter Property="Width" Value="{Binding FormWidth, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <Setter Property="Height" Value="{Binding FormHeight, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <Setter Property="Left" Value="{Binding LeftLocation, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <Setter Property="Top" Value="{Binding TopLocation, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <Setter Property="ShowInTaskbar" Value="True" />
            <Setter Property="AllowsTransparency" Value="False" />
            <Setter Property="WindowStyle" Value="SingleBorderWindow" />
            <Setter Property="WindowState" Value="{Binding FormState, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <Setter Property="Background" Value="{StaticResource BackGroundBrush}" />
            <Setter Property="Opacity" Value="1" />
            <Setter Property="Icon" Value="../Assets/logo.png" />
        </Style>
    </prism:Dialog.WindowStyle>
    <ScrollViewer
        Margin="10"
        HorizontalScrollBarVisibility="Auto"
        VerticalScrollBarVisibility="Auto">
        <hc:UniformSpacingPanel Orientation="Vertical" Spacing="10">
            <hc:UniformSpacingPanel Orientation="Horizontal" Spacing="10">
                <TextBox
                    Width="120"
                    VerticalAlignment="Center"
                    hc:InfoElement.Title="{ex:Language Key='死区'}"
                    Style="{StaticResource TextBoxExtend}"
                    Text="{Binding AdaptivepHParameter.DeadZone, UpdateSourceTrigger=LostFocus}" />
                <TextBox
                    Width="120"
                    VerticalAlignment="Center"
                    hc:InfoElement.Title="{ex:Language Key='单次最大添加量(mL)'}"
                    Style="{StaticResource TextBoxExtend}"
                    Text="{Binding AdaptivepHParameter.MaxDosingVolume, UpdateSourceTrigger=LostFocus}" />
                <TextBox
                    Width="120"
                    VerticalAlignment="Center"
                    hc:InfoElement.Title="{ex:Language Key='单次最小添加量(mL)'}"
                    Style="{StaticResource TextBoxExtend}"
                    Text="{Binding AdaptivepHParameter.MinDosingVolume, UpdateSourceTrigger=LostFocus}" />
                <TextBox
                    Width="120"
                    VerticalAlignment="Center"
                    hc:InfoElement.Title="{ex:Language Key='基础添加量(mL)'}"
                    Style="{StaticResource TextBoxExtend}"
                    Text="{Binding AdaptivepHParameter.BaseAdjustmentFactor, UpdateSourceTrigger=LostFocus}"
                    ToolTip="基础调节系数 表示每偏离目标pH 1.0时需要添加的试剂体积" />
            </hc:UniformSpacingPanel>
            <hc:UniformSpacingPanel Orientation="Horizontal" Spacing="10">
                <TextBox
                    Width="120"
                    VerticalAlignment="Center"
                    hc:InfoElement.Title="{ex:Language Key='初始衰减系数'}"
                    Style="{StaticResource TextBoxExtend}"
                    Text="{Binding AdaptivepHParameter.InitialDecayFactor, UpdateSourceTrigger=LostFocus}"
                    ToolTip="值越小调节越保守，防过冲能力越强 建议启动时设为0.5-0.7" />
                <TextBox
                    Width="120"
                    VerticalAlignment="Center"
                    hc:InfoElement.Title="{ex:Language Key='参数学习速率'}"
                    Style="{StaticResource TextBoxExtend}"
                    Text="{Binding AdaptivepHParameter.LearningRate, UpdateSourceTrigger=LostFocus}"
                    ToolTip="影响自适应参数的调整速度 值越大响应越快但可能不稳定" />
                <TextBox
                    Width="120"
                    VerticalAlignment="Center"
                    hc:InfoElement.Title="{ex:Language Key='历史数据窗口大小'}"
                    Style="{StaticResource TextBoxExtend}"
                    Text="{Binding AdaptivepHParameter.HistoryWindowSize, UpdateSourceTrigger=LostFocus}"
                    ToolTip="用于计算误差趋势 值越大系统响应越平缓" />
            </hc:UniformSpacingPanel>
            <hc:UniformSpacingPanel Orientation="Horizontal" Spacing="10">
                <TextBox
                    Width="120"
                    VerticalAlignment="Center"
                    hc:InfoElement.Title="{ex:Language Key='搅拌转速影响系数'}"
                    Style="{StaticResource TextBoxExtend}"
                    Text="{Binding AdaptivepHParameter.StirringCoeff, UpdateSourceTrigger=LostFocus}"
                    ToolTip="公式：混合效率 += StirringCoeff * RPM 典型值：0.0003-0.001" />
                <TextBox
                    Width="120"
                    VerticalAlignment="Center"
                    hc:InfoElement.Title="{ex:Language Key='溶液体积影响系数'}"
                    Style="{StaticResource TextBoxExtend}"
                    Text="{Binding AdaptivepHParameter.VolumeCoeff, UpdateSourceTrigger=LostFocus}"
                    ToolTip="公式：混合效率 += VolumeCoeff / 体积(L) 典型值：0.05-0.3" />
            </hc:UniformSpacingPanel>
        </hc:UniformSpacingPanel>
    </ScrollViewer>
</UserControl>
