<UserControl
    x:Class="RD3.Views.DOSettingView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behavior="clr-namespace:RD3.Behaviors"
    xmlns:common="clr-namespace:RD3.Common"
    xmlns:control="clr-namespace:RD3.Controls"
    xmlns:cv="clr-namespace:RD3.Common.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ex="clr-namespace:LayUI.Wpf.Extensions;assembly=LayUI.Wpf.Extensions"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:local="clr-namespace:RD3.Views"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:rd3="clr-namespace:RD3"
    xmlns:share="clr-namespace:RD3.Shared;assembly=RD3.Shared"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    xmlns:vm="clr-namespace:RD3.ViewModels"
    xmlns:wpf="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
    Width="800"
    Height="550"
    d:DataContext="{d:DesignInstance Type=vm:DOSettingViewModel}"
    Background="{StaticResource RegionBackgroundBrush}"
    TextElement.FontFamily="{DynamicResource AppFontFamily}"
    TextElement.FontSize="{DynamicResource SubHeadFontSize}"
    TextElement.FontWeight="Regular"
    TextOptions.TextFormattingMode="Ideal"
    TextOptions.TextRenderingMode="Auto"
    mc:Ignorable="d">
    <prism:Dialog.WindowStyle>
        <Style TargetType="Window">
            <Setter Property="SizeToContent" Value="WidthAndHeight" />
            <Setter Property="ResizeMode" Value="NoResize" />
            <Setter Property="prism:Dialog.WindowStartupLocation" Value="CenterOwner" />
            <Setter Property="Width" Value="{Binding FormWidth, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <Setter Property="Height" Value="{Binding FormHeight, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <Setter Property="Left" Value="{Binding LeftLocation, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <Setter Property="Top" Value="{Binding TopLocation, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <Setter Property="ShowInTaskbar" Value="True" />
            <Setter Property="AllowsTransparency" Value="False" />
            <Setter Property="WindowStyle" Value="SingleBorderWindow" />
            <Setter Property="WindowState" Value="{Binding FormState, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <Setter Property="Background" Value="{StaticResource RegionBackgroundBrush}" />
            <Setter Property="Opacity" Value="1" />
            <Setter Property="Icon" Value="../Assets/logo.png" />
        </Style>
    </prism:Dialog.WindowStyle>
    <UserControl.Resources>
        <ObjectDataProvider
            x:Key="DataFromEnum"
            MethodName="GetValues"
            ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="share:DOControlFactor" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
        <Style
            x:Key="CustomTransferStyle"
            BasedOn="{StaticResource Transfer.CheckBox.Small}"
            TargetType="hc:Transfer" />
        <rd3:BindingProxy x:Key="proxy" Data="{Binding Param}" />
    </UserControl.Resources>
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto" />
            <ColumnDefinition Width="auto" />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <local:TimeSeriesView
            x:Name="tsView"
            HorizontalAlignment="Left"
            VerticalAlignment="Top" />
        <GridSplitter
            Grid.Column="1"
            Width="5"
            Background="LightGray"
            IsEnabled="False" />
        <Grid Grid.Column="2" Margin="5,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="10" />
                <RowDefinition Height="auto" />
            </Grid.RowDefinitions>
            <WrapPanel Name="panelMethod" IsEnabled="{Binding BasicParam.IsControling, Converter={StaticResource InverseBooleanConverter}}">
                <RadioButton
                    Width="90"
                    Height="35"
                    Margin="0,5,5,5"
                    Content="{ex:Language Key='阶梯级联'}"
                    IsChecked="{Binding CurrentDeviceParameter.DOParam.ControlStrategy, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Step}"
                    Style="{StaticResource RadioButtonCustomPrimary}" />
                <RadioButton
                    Width="90"
                    Height="35"
                    Margin="5"
                    Content="{ex:Language Key='中位级联'}"
                    IsChecked="{Binding CurrentDeviceParameter.DOParam.ControlStrategy, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Midranging}"
                    Style="{StaticResource RadioButtonCustomPrimary}" />
                <RadioButton
                    Width="90"
                    Height="35"
                    Margin="5"
                    Content="{ex:Language Key='周期控制'}"
                    IsChecked="{Binding CurrentDeviceParameter.DOParam.ControlStrategy, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Cycle}"
                    Style="{StaticResource RadioButtonCustomPrimary}" />
            </WrapPanel>
            <hc:UniformSpacingPanel
                Grid.Row="1"
                IsEnabled="{Binding BasicParam.IsControling, Converter={StaticResource InverseBooleanConverter}}"
                Orientation="Horizontal"
                Spacing="10">
                <control:TextBoxNoAutoKeyboard
                    Width="90"
                    materialDesign:HintAssist.Hint="DO下限"
                    materialDesign:TextFieldAssist.HasClearButton="True"
                    IsEnabled="{Binding CurrentDeviceParameter.DOParam.IsControling, Converter={StaticResource InverseBooleanConverter}}"
                    Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                    Text="{Binding CurrentDeviceParameter.DOParam.LowerLimit, StringFormat={}{0:F2}}">
                    <i:Interaction.Triggers>
                        <i:EventTrigger EventName="PreviewMouseLeftButtonDown">
                            <i:InvokeCommandAction Command="{Binding OpenNumberKeyBoardCommand}" />
                        </i:EventTrigger>
                    </i:Interaction.Triggers>
                </control:TextBoxNoAutoKeyboard>
                <control:TextBoxNoAutoKeyboard
                    Width="90"
                    materialDesign:HintAssist.Hint="DO上限"
                    materialDesign:TextFieldAssist.HasClearButton="True"
                    IsEnabled="{Binding CurrentDeviceParameter.DOParam.IsControling, Converter={StaticResource InverseBooleanConverter}}"
                    Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                    Text="{Binding CurrentDeviceParameter.DOParam.UpperLimit, StringFormat={}{0:F2}}">
                    <i:Interaction.Triggers>
                        <i:EventTrigger EventName="PreviewMouseLeftButtonDown">
                            <i:InvokeCommandAction Command="{Binding OpenNumberKeyBoardCommand}" />
                        </i:EventTrigger>
                    </i:Interaction.Triggers>
                </control:TextBoxNoAutoKeyboard>
                <StackPanel Orientation="Vertical">
                    <CheckBox
                        Margin="5"
                        Content="正向(+)"
                        IsChecked="{Binding CurrentDeviceParameter.DOParam.IsDirect}" />
                    <CheckBox
                        Margin="5"
                        Content="反向(-)"
                        IsChecked="{Binding CurrentDeviceParameter.DOParam.IsReverse}" />
                </StackPanel>
                <DockPanel LastChildFill="False">
                    <Button
                        hc:IconElement.Geometry="{StaticResource GeometryPID}"
                        Command="{Binding PIDSettingCommand}"
                        Content="PID设置"
                        DockPanel.Dock="Bottom"
                        Style="{StaticResource ButtonDashedPrimary}" />
                </DockPanel>
            </hc:UniformSpacingPanel>
            <GroupBox Style="{StaticResource GroupBoxTab}" Visibility="Collapsed">
                <GroupBox.Header>
                    <CheckBox
                        HorizontalAlignment="Center"
                        Content="正向(+)"
                        IsChecked="{Binding CurrentDeviceParameter.DOParam.IsDirect}" />
                </GroupBox.Header>
                <hc:UniformSpacingPanel Orientation="Horizontal" Spacing="10">
                    <control:TextBoxNoAutoKeyboard
                        Width="70"
                        materialDesign:HintAssist.Hint="比例P"
                        Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                        Text="{Binding CurrentDeviceParameter.DOParam.DirectPID.P, StringFormat={}{0:F2}}">
                        <i:Interaction.Triggers>
                            <i:EventTrigger EventName="PreviewMouseLeftButtonDown">
                                <i:InvokeCommandAction Command="{Binding OpenNumberKeyBoardCommand}" />
                            </i:EventTrigger>
                        </i:Interaction.Triggers>
                    </control:TextBoxNoAutoKeyboard>
                    <control:TextBoxNoAutoKeyboard
                        Width="70"
                        materialDesign:HintAssist.Hint="积分I"
                        Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                        Text="{Binding CurrentDeviceParameter.DOParam.DirectPID.I, StringFormat={}{0:F2}}">
                        <i:Interaction.Triggers>
                            <i:EventTrigger EventName="PreviewMouseLeftButtonDown">
                                <i:InvokeCommandAction Command="{Binding OpenNumberKeyBoardCommand}" />
                            </i:EventTrigger>
                        </i:Interaction.Triggers>
                    </control:TextBoxNoAutoKeyboard>
                    <control:TextBoxNoAutoKeyboard
                        Width="70"
                        materialDesign:HintAssist.Hint="微分D"
                        Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                        Text="{Binding CurrentDeviceParameter.DOParam.DirectPID.D, StringFormat={}{0:F2}}">
                        <i:Interaction.Triggers>
                            <i:EventTrigger EventName="PreviewMouseLeftButtonDown">
                                <i:InvokeCommandAction Command="{Binding OpenNumberKeyBoardCommand}" />
                            </i:EventTrigger>
                        </i:Interaction.Triggers>
                    </control:TextBoxNoAutoKeyboard>
                    <control:TextBoxNoAutoKeyboard
                        Width="70"
                        materialDesign:HintAssist.Hint="死区"
                        Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                        Text="{Binding CurrentDeviceParameter.DOParam.DirectPID.DeadArea, StringFormat={}{0:F2}}">
                        <i:Interaction.Triggers>
                            <i:EventTrigger EventName="PreviewMouseLeftButtonDown">
                                <i:InvokeCommandAction Command="{Binding OpenNumberKeyBoardCommand}" />
                            </i:EventTrigger>
                        </i:Interaction.Triggers>
                    </control:TextBoxNoAutoKeyboard>
                </hc:UniformSpacingPanel>
            </GroupBox>
            <GroupBox Style="{StaticResource GroupBoxTab}" Visibility="Collapsed">
                <GroupBox.Header>
                    <CheckBox
                        HorizontalAlignment="Center"
                        Content="反向(-)"
                        IsChecked="{Binding CurrentDeviceParameter.DOParam.IsReverse}" />
                </GroupBox.Header>
                <hc:UniformSpacingPanel Orientation="Horizontal" Spacing="10">
                    <control:TextBoxNoAutoKeyboard
                        Width="70"
                        materialDesign:HintAssist.Hint="比例P"
                        Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                        Text="{Binding CurrentDeviceParameter.DOParam.ReversePID.P, StringFormat={}{0:F2}}">
                        <i:Interaction.Triggers>
                            <i:EventTrigger EventName="PreviewMouseLeftButtonDown">
                                <i:InvokeCommandAction Command="{Binding OpenNumberKeyBoardCommand}" />
                            </i:EventTrigger>
                        </i:Interaction.Triggers>
                    </control:TextBoxNoAutoKeyboard>
                    <control:TextBoxNoAutoKeyboard
                        Width="70"
                        materialDesign:HintAssist.Hint="积分I"
                        Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                        Text="{Binding CurrentDeviceParameter.DOParam.ReversePID.I, StringFormat={}{0:F2}}">
                        <i:Interaction.Triggers>
                            <i:EventTrigger EventName="PreviewMouseLeftButtonDown">
                                <i:InvokeCommandAction Command="{Binding OpenNumberKeyBoardCommand}" />
                            </i:EventTrigger>
                        </i:Interaction.Triggers>
                    </control:TextBoxNoAutoKeyboard>
                    <control:TextBoxNoAutoKeyboard
                        Width="70"
                        materialDesign:HintAssist.Hint="微分D"
                        Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                        Text="{Binding CurrentDeviceParameter.DOParam.ReversePID.D, StringFormat={}{0:F2}}">
                        <i:Interaction.Triggers>
                            <i:EventTrigger EventName="PreviewMouseLeftButtonDown">
                                <i:InvokeCommandAction Command="{Binding OpenNumberKeyBoardCommand}" />
                            </i:EventTrigger>
                        </i:Interaction.Triggers>
                    </control:TextBoxNoAutoKeyboard>
                    <control:TextBoxNoAutoKeyboard
                        Width="70"
                        materialDesign:HintAssist.Hint="死区"
                        Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                        Text="{Binding CurrentDeviceParameter.DOParam.ReversePID.DeadArea, StringFormat={}{0:F2}}">
                        <i:Interaction.Triggers>
                            <i:EventTrigger EventName="PreviewMouseLeftButtonDown">
                                <i:InvokeCommandAction Command="{Binding OpenNumberKeyBoardCommand}" />
                            </i:EventTrigger>
                        </i:Interaction.Triggers>
                    </control:TextBoxNoAutoKeyboard>
                </hc:UniformSpacingPanel>
            </GroupBox>
            <hc:SimplePanel
                x:Name="panelContent"
                Grid.Row="2"
                Margin="0,10,0,0">
                <hc:ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <GroupBox
                        MaxHeight="450"
                        Style="{StaticResource GroupBoxTab}"
                        Visibility="{Binding CurrentDeviceParameter.DOParam.ControlStrategy, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=Step}">
                        <GroupBox.Header>
                            <TextBlock Foreground="Gray" Text="阶梯级联策略参数" />
                        </GroupBox.Header>
                        <TabControl Style="{StaticResource TabControlInLine}">
                            <TabItem Header="基础参数">
                                <hc:UniformSpacingPanel
                                    Margin="5"
                                    Orientation="Vertical"
                                    Spacing="10">
                                    <StackPanel IsEnabled="{Binding CurrentDeviceParameter.DOParam.IsControling, Converter={StaticResource InverseBooleanConverter}}" Orientation="Horizontal">
                                        <CheckBox
                                            Margin="5"
                                            materialDesign:CheckBoxAssist.CheckBoxSize="24"
                                            Content="空气"
                                            IsChecked="{Binding Param.AirEnable}"
                                            Style="{StaticResource MaterialDesignCheckBox}" />
                                        <CheckBox
                                            Margin="5"
                                            materialDesign:CheckBoxAssist.CheckBoxSize="24"
                                            Content="氧气"
                                            IsChecked="{Binding Param.O2Enable}"
                                            Style="{StaticResource MaterialDesignCheckBox}" />
                                        <CheckBox
                                            Margin="5"
                                            materialDesign:CheckBoxAssist.CheckBoxSize="24"
                                            Content="温度"
                                            IsChecked="{Binding Param.TempEnable}"
                                            Style="{StaticResource MaterialDesignCheckBox}" />
                                        <CheckBox
                                            Margin="5"
                                            materialDesign:CheckBoxAssist.CheckBoxSize="24"
                                            Content="补料"
                                            IsChecked="{Binding Param.FeedEnable}"
                                            Style="{StaticResource MaterialDesignCheckBox}" />
                                    </StackPanel>
                                    <ListBox
                                        Name="listBoxCascadeFactor"
                                        AllowDrop="True"
                                        FontSize="{StaticResource SubHeadFontSize}"
                                        IsEnabled="{Binding CurrentDeviceParameter.DOParam.IsControling, Converter={StaticResource InverseBooleanConverter}}"
                                        ItemsSource="{Binding Param.FactorCol}"
                                        Style="{StaticResource ListBoxBaseStyle}">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="5,0,0,0" Orientation="Horizontal">
                                                    <TextBlock VerticalAlignment="Center" Text="{Binding Converter={StaticResource EnumToStringConverter}}" />
                                                    <hc:UniformSpacingPanel
                                                        Margin="20,0,0,0"
                                                        Orientation="Horizontal"
                                                        Spacing="5">
                                                        <Button
                                                            Padding="5"
                                                            hc:IconElement.Geometry="{StaticResource UpGeometry}"
                                                            hc:IconElement.Width="16"
                                                            Background="Transparent"
                                                            BorderThickness="0"
                                                            Command="{Binding DataContext.FactorUpCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                            CommandParameter="{Binding}"
                                                            ToolTip="提升执行顺序" />
                                                        <Button
                                                            Padding="5"
                                                            hc:IconElement.Geometry="{StaticResource DownGeometry}"
                                                            hc:IconElement.Width="16"
                                                            Background="Transparent"
                                                            BorderThickness="0"
                                                            Command="{Binding DataContext.FactorDownCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                            CommandParameter="{Binding}"
                                                            ToolTip="降低执行顺序" />
                                                    </hc:UniformSpacingPanel>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <hc:UniformSpacingPanel
                                        IsEnabled="{Binding BasicParam.IsControling, Converter={StaticResource InverseBooleanConverter}}"
                                        Orientation="Horizontal"
                                        Spacing="10">
                                        <ComboBox
                                            Width="100"
                                            materialDesign:ComboBoxAssist.ShowSelectedItem="True"
                                            materialDesign:HintAssist.Hint="气体单位"
                                            SelectedIndex="{Binding Param.Unit}"
                                            Style="{StaticResource MaterialDesignFloatingHintComboBox}">
                                            <ComboBoxItem Content="VVM" />
                                            <ComboBoxItem Content="L/min" />
                                        </ComboBox>
                                        <TextBox
                                            Width="100"
                                            VerticalAlignment="Center"
                                            materialDesign:HintAssist.HelperText="单位:分钟"
                                            materialDesign:HintAssist.Hint="持续时间"
                                            Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                            Text="{Binding Param.GasWaitTime, UpdateSourceTrigger=LostFocus}" />
                                    </hc:UniformSpacingPanel>
                                </hc:UniformSpacingPanel>
                            </TabItem>
                            <TabItem Header="级联参数">
                                <hc:ScrollViewer
                                    Margin="5"
                                    HorizontalScrollBarVisibility="Auto"
                                    VerticalScrollBarVisibility="Auto">
                                    <hc:UniformSpacingPanel
                                        IsEnabled="{Binding BasicParam.IsControling, Converter={StaticResource InverseBooleanConverter}}"
                                        Orientation="Vertical"
                                        Spacing="5">
                                        <hc:UniformSpacingPanel
                                            DockPanel.Dock="Left"
                                            Orientation="Horizontal"
                                            Spacing="5">
                                            <DockPanel LastChildFill="False">
                                                <Button
                                                    Height="30"
                                                    VerticalAlignment="Bottom"
                                                    hc:IconElement.Geometry="{StaticResource GeometryAdd}"
                                                    Command="{Binding AddCascadeCommand}"
                                                    Content="新增"
                                                    Foreground="{StaticResource PrimaryBrush}"
                                                    IsEnabled="{Binding Param.FactorCol.Count, Converter={StaticResource GreaterThanConverter}, ConverterParameter=0}" />
                                            </DockPanel>
                                            <DockPanel LastChildFill="False">
                                                <Button
                                                    Height="30"
                                                    VerticalAlignment="Bottom"
                                                    hc:IconElement.Geometry="{StaticResource DeleteFillCircleGeometry}"
                                                    Command="{Binding DeleteCascadeCommand}"
                                                    CommandParameter="{Binding ElementName=gridCascade, Path=SelectedItem}"
                                                    Content="删除"
                                                    Foreground="{StaticResource PrimaryBrush}"
                                                    IsEnabled="{Binding Param.FactorCol.Count, Converter={StaticResource GreaterThanConverter}, ConverterParameter=0}" />
                                            </DockPanel>
                                        </hc:UniformSpacingPanel>
                                        <hc:ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                                            <DataGrid
                                                Name="gridCascade"
                                                hc:DataGridAttach.CanUnselectAllWithBlankArea="False"
                                                hc:DataGridAttach.ShowSelectAllButton="False"
                                                AutoGenerateColumns="False"
                                                CanUserAddRows="False"
                                                CanUserSortColumns="False"
                                                CellStyle="{StaticResource DataGridTextCenterCellStyle}"
                                                ColumnWidth="SizeToHeader"
                                                GridLinesVisibility="All"
                                                HeadersVisibility="Column"
                                                HorizontalGridLinesBrush="LightGray"
                                                IsReadOnly="False"
                                                ItemsSource="{Binding Param.CascadeCol}"
                                                LoadingRow="DataGrid_LoadingRow"
                                                RowHeight="35"
                                                RowStyle="{StaticResource PrimaryDataGridRowStyle}"
                                                ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                                ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                SelectionMode="Single"
                                                SelectionUnit="FullRow"
                                                VerticalGridLinesBrush="LightGray">
                                                <DataGrid.Columns>
                                                    <DataGridTemplateColumn
                                                        Width="auto"
                                                        Header="序号"
                                                        HeaderStyle="{StaticResource DataGridCenterColumnHeaderStyle}">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Text="{Binding RelativeSource={RelativeSource AncestorType={x:Type DataGridRow}}, Path=Header}" />
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                    <DataGridTemplateColumn
                                                        Width="auto"
                                                        Header="空气"
                                                        HeaderStyle="{StaticResource DataGridCenterColumnHeaderStyle}"
                                                        Visibility="{Binding Source={StaticResource proxy}, Path=Data.AirEnable, Converter={StaticResource Boolean2VisibilityConverter}}">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <control:TextBoxNoAutoKeyboard Style="{StaticResource DataTextBoxStyle}" Text="{Binding AirFlowRate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                                                    <i:Interaction.Triggers>
                                                                        <i:EventTrigger EventName="PreviewMouseLeftButtonDown">
                                                                            <i:InvokeCommandAction Command="{Binding DataContext.OpenNumberKeyBoardCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                                                                        </i:EventTrigger>
                                                                    </i:Interaction.Triggers>
                                                                </control:TextBoxNoAutoKeyboard>
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                    <DataGridTemplateColumn
                                                        Width="auto"
                                                        Header="氧气"
                                                        HeaderStyle="{StaticResource DataGridCenterColumnHeaderStyle}"
                                                        Visibility="{Binding Source={StaticResource proxy}, Path=Data.O2Enable, Converter={StaticResource Boolean2VisibilityConverter}}">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <control:TextBoxNoAutoKeyboard Style="{StaticResource DataTextBoxStyle}" Text="{Binding O2FlowRate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                                                    <i:Interaction.Triggers>
                                                                        <i:EventTrigger EventName="PreviewMouseLeftButtonDown">
                                                                            <i:InvokeCommandAction Command="{Binding DataContext.OpenNumberKeyBoardCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                                                                        </i:EventTrigger>
                                                                    </i:Interaction.Triggers>
                                                                </control:TextBoxNoAutoKeyboard>
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                    <DataGridTemplateColumn
                                                        Width="auto"
                                                        Header="温度"
                                                        HeaderStyle="{StaticResource DataGridCenterColumnHeaderStyle}"
                                                        Visibility="{Binding Source={StaticResource proxy}, Path=Data.TempEnable, Converter={StaticResource Boolean2VisibilityConverter}}">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <control:TextBoxNoAutoKeyboard Style="{StaticResource DataTextBoxStyle}" Text="{Binding Temp, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                                                    <i:Interaction.Triggers>
                                                                        <i:EventTrigger EventName="PreviewMouseLeftButtonDown">
                                                                            <i:InvokeCommandAction Command="{Binding DataContext.OpenNumberKeyBoardCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                                                                        </i:EventTrigger>
                                                                    </i:Interaction.Triggers>
                                                                </control:TextBoxNoAutoKeyboard>
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                    <DataGridTemplateColumn
                                                        Width="auto"
                                                        Header="补料速率（%）"
                                                        HeaderStyle="{StaticResource DataGridCenterColumnHeaderStyle}"
                                                        Visibility="{Binding Source={StaticResource proxy}, Path=Data.FeedEnable, Converter={StaticResource Boolean2VisibilityConverter}}">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <control:TextBoxNoAutoKeyboard Style="{StaticResource DataTextBoxStyle}" Text="{Binding FeedFlowRate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                                                    <i:Interaction.Triggers>
                                                                        <i:EventTrigger EventName="PreviewMouseLeftButtonDown">
                                                                            <i:InvokeCommandAction Command="{Binding DataContext.OpenNumberKeyBoardCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                                                                        </i:EventTrigger>
                                                                    </i:Interaction.Triggers>
                                                                </control:TextBoxNoAutoKeyboard>
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </hc:ScrollViewer>
                                    </hc:UniformSpacingPanel>
                                </hc:ScrollViewer>
                            </TabItem>
                        </TabControl>
                    </GroupBox>
                </hc:ScrollViewer>
                <GroupBox Style="{StaticResource GroupBoxTab}" Visibility="{Binding CurrentDeviceParameter.DOParam.ControlStrategy, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=Midranging}">
                    <GroupBox.Header>
                        <TextBlock Foreground="Gray" Text="中位级联策略参数" />
                    </GroupBox.Header>
                    <hc:UniformSpacingPanel
                        Margin="5"
                        Orientation="Vertical"
                        Spacing="5">
                        <hc:UniformSpacingPanel
                            IsEnabled="{Binding CurrentDeviceParameter.DOParam.IsControling, Converter={StaticResource InverseBooleanConverter}}"
                            Orientation="Horizontal"
                            Spacing="15">
                            <CheckBox
                                materialDesign:CheckBoxAssist.CheckBoxSize="24"
                                Content="空气"
                                IsChecked="{Binding MidRanging.AirEnable}"
                                Style="{StaticResource MaterialDesignCheckBox}" />
                            <CheckBox
                                materialDesign:CheckBoxAssist.CheckBoxSize="24"
                                Content="氧气"
                                IsChecked="{Binding MidRanging.O2Enable}"
                                Style="{StaticResource MaterialDesignCheckBox}" />
                            <CheckBox
                                materialDesign:CheckBoxAssist.CheckBoxSize="24"
                                Content="温度"
                                IsChecked="{Binding MidRanging.TempEnable}"
                                Style="{StaticResource MaterialDesignCheckBox}" />
                            <CheckBox
                                materialDesign:CheckBoxAssist.CheckBoxSize="24"
                                Content="补料"
                                IsChecked="{Binding MidRanging.FeedEnable}"
                                Style="{StaticResource MaterialDesignCheckBox}" />
                        </hc:UniformSpacingPanel>
                        <ListBox
                            Name="listBoxMidrangingFactor"
                            AllowDrop="True"
                            FontSize="{StaticResource SubHeadFontSize}"
                            IsEnabled="{Binding CurrentDeviceParameter.DOParam.IsControling, Converter={StaticResource InverseBooleanConverter}}"
                            ItemsSource="{Binding MidRanging.FactorCol}"
                            Style="{StaticResource ListBoxBaseStyle}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="5,0,0,0" Orientation="Horizontal">
                                        <TextBlock VerticalAlignment="Center" Text="{Binding Converter={StaticResource EnumToStringConverter}}" />
                                        <hc:UniformSpacingPanel
                                            Margin="20,0,0,0"
                                            Orientation="Horizontal"
                                            Spacing="5">
                                            <Button
                                                Padding="5"
                                                hc:IconElement.Geometry="{StaticResource UpGeometry}"
                                                hc:IconElement.Width="16"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Command="{Binding DataContext.FactorUpCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="提升执行顺序" />
                                            <Button
                                                Padding="5"
                                                hc:IconElement.Geometry="{StaticResource DownGeometry}"
                                                hc:IconElement.Width="16"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Command="{Binding DataContext.FactorDownCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="降低执行顺序" />
                                        </hc:UniformSpacingPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <hc:UniformSpacingPanel
                            IsEnabled="{Binding BasicParam.IsControling, Converter={StaticResource InverseBooleanConverter}}"
                            Orientation="Vertical"
                            Spacing="15">
                            <hc:UniformSpacingPanel Orientation="Horizontal" Spacing="10">
                                <control:TextBoxNoAutoKeyboard
                                    Width="100"
                                    materialDesign:HintAssist.HelperText="单位:rpm"
                                    materialDesign:HintAssist.Hint="转速高限"
                                    Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                    Text="{Binding MidRanging.AgitHigh, UpdateSourceTrigger=LostFocus}">
                                    <i:Interaction.Triggers>
                                        <i:EventTrigger EventName="PreviewMouseLeftButtonDown">
                                            <i:InvokeCommandAction Command="{Binding OpenNumberKeyBoardCommand}" />
                                        </i:EventTrigger>
                                    </i:Interaction.Triggers>
                                </control:TextBoxNoAutoKeyboard>
                                <control:TextBoxNoAutoKeyboard
                                    Width="100"
                                    materialDesign:HintAssist.HelperText="单位:℃"
                                    materialDesign:HintAssist.Hint="温度下限"
                                    Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                    Text="{Binding CurrentDeviceParameter.TempDOLowerLimit, UpdateSourceTrigger=LostFocus}">
                                    <i:Interaction.Triggers>
                                        <i:EventTrigger EventName="PreviewMouseLeftButtonDown">
                                            <i:InvokeCommandAction Command="{Binding OpenNumberKeyBoardCommand}" />
                                        </i:EventTrigger>
                                    </i:Interaction.Triggers>
                                </control:TextBoxNoAutoKeyboard>
                                <control:TextBoxNoAutoKeyboard
                                    Width="100"
                                    materialDesign:HintAssist.HelperText="单位:mL/h"
                                    materialDesign:HintAssist.Hint="补料下限"
                                    Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                    Text="{Binding CurrentDeviceParameter.FeedDOLowerLimit, UpdateSourceTrigger=LostFocus}">
                                    <i:Interaction.Triggers>
                                        <i:EventTrigger EventName="PreviewMouseLeftButtonDown">
                                            <i:InvokeCommandAction Command="{Binding OpenNumberKeyBoardCommand}" />
                                        </i:EventTrigger>
                                    </i:Interaction.Triggers>
                                </control:TextBoxNoAutoKeyboard>
                            </hc:UniformSpacingPanel>
                            <hc:UniformSpacingPanel Orientation="Horizontal" Spacing="10">
                                <ComboBox
                                    Width="100"
                                    materialDesign:ComboBoxAssist.ShowSelectedItem="True"
                                    materialDesign:HintAssist.Hint="气体单位"
                                    SelectedIndex="{Binding MidRanging.Unit}"
                                    Style="{StaticResource MaterialDesignFloatingHintComboBox}">
                                    <ComboBoxItem Content="VVM" />
                                    <ComboBoxItem Content="L/min" />
                                </ComboBox>
                                <control:TextBoxNoAutoKeyboard
                                    Width="100"
                                    materialDesign:HintAssist.Hint="气体下限"
                                    Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                    Text="{Binding MidRanging.InitialAir, UpdateSourceTrigger=LostFocus}">
                                    <i:Interaction.Triggers>
                                        <i:EventTrigger EventName="PreviewMouseLeftButtonDown">
                                            <i:InvokeCommandAction Command="{Binding OpenNumberKeyBoardCommand}" />
                                        </i:EventTrigger>
                                    </i:Interaction.Triggers>
                                </control:TextBoxNoAutoKeyboard>
                                <control:TextBoxNoAutoKeyboard
                                    Width="100"
                                    materialDesign:HintAssist.Hint="气体上限"
                                    Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                    Text="{Binding MidRanging.AirUpperLimit, UpdateSourceTrigger=LostFocus}">
                                    <i:Interaction.Triggers>
                                        <i:EventTrigger EventName="PreviewMouseLeftButtonDown">
                                            <i:InvokeCommandAction Command="{Binding OpenNumberKeyBoardCommand}" />
                                        </i:EventTrigger>
                                    </i:Interaction.Triggers>
                                </control:TextBoxNoAutoKeyboard>
                            </hc:UniformSpacingPanel>
                        </hc:UniformSpacingPanel>
                    </hc:UniformSpacingPanel>
                </GroupBox>
                <hc:UniformSpacingPanel
                    IsEnabled="{Binding BasicParam.IsControling, Converter={StaticResource InverseBooleanConverter}}"
                    Orientation="Vertical"
                    Spacing="10"
                    Visibility="{Binding CurrentDeviceParameter.DOParam.ControlStrategy, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=Cycle}">
                    <hc:UniformSpacingPanel Orientation="Horizontal" Spacing="10">
                        <control:TextBoxNoAutoKeyboard
                            Width="100"
                            materialDesign:HintAssist.Hint="转速下限"
                            Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                            Text="{Binding CurrentDeviceParameter.DOParam.AgitCycle.LowerLimit, UpdateSourceTrigger=LostFocus}">
                            <i:Interaction.Triggers>
                                <i:EventTrigger EventName="PreviewMouseLeftButtonDown">
                                    <i:InvokeCommandAction Command="{Binding OpenNumberKeyBoardCommand}" />
                                </i:EventTrigger>
                            </i:Interaction.Triggers>
                        </control:TextBoxNoAutoKeyboard>
                        <control:TextBoxNoAutoKeyboard
                            Width="100"
                            materialDesign:HintAssist.Hint="转速上限"
                            Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                            Text="{Binding CurrentDeviceParameter.DOParam.AgitCycle.UpperLimit, UpdateSourceTrigger=LostFocus}">
                            <i:Interaction.Triggers>
                                <i:EventTrigger EventName="PreviewMouseLeftButtonDown">
                                    <i:InvokeCommandAction Command="{Binding OpenNumberKeyBoardCommand}" />
                                </i:EventTrigger>
                            </i:Interaction.Triggers>
                        </control:TextBoxNoAutoKeyboard>
                    </hc:UniformSpacingPanel>
                    <GroupBox Style="{StaticResource GroupBoxTab}">
                        <GroupBox.Header>
                            <TextBlock Foreground="Gray" Text="转速(+)" />
                        </GroupBox.Header>
                        <hc:UniformSpacingPanel Orientation="Vertical" Spacing="10">
                            <hc:UniformSpacingPanel Orientation="Horizontal" Spacing="10">
                                <control:TextBoxNoAutoKeyboard
                                    Width="100"
                                    materialDesign:HintAssist.Hint="间隔(秒)"
                                    Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                    Text="{Binding CurrentDeviceParameter.DOParam.AgitCycle.DirectInterval, UpdateSourceTrigger=LostFocus}">
                                    <i:Interaction.Triggers>
                                        <i:EventTrigger EventName="PreviewMouseLeftButtonDown">
                                            <i:InvokeCommandAction Command="{Binding OpenNumberKeyBoardCommand}" />
                                        </i:EventTrigger>
                                    </i:Interaction.Triggers>
                                </control:TextBoxNoAutoKeyboard>
                                <control:TextBoxNoAutoKeyboard
                                    Width="100"
                                    materialDesign:HintAssist.Hint="转速步长(+)"
                                    Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                    Text="{Binding CurrentDeviceParameter.DOParam.AgitCycle.DirectStep, UpdateSourceTrigger=LostFocus}">
                                    <i:Interaction.Triggers>
                                        <i:EventTrigger EventName="PreviewMouseLeftButtonDown">
                                            <i:InvokeCommandAction Command="{Binding OpenNumberKeyBoardCommand}" />
                                        </i:EventTrigger>
                                    </i:Interaction.Triggers>
                                </control:TextBoxNoAutoKeyboard>
                            </hc:UniformSpacingPanel>
                        </hc:UniformSpacingPanel>
                    </GroupBox>
                    <GroupBox Style="{StaticResource GroupBoxTab}">
                        <GroupBox.Header>
                            <TextBlock Foreground="Gray" Text="转速(-)" />
                        </GroupBox.Header>
                        <hc:UniformSpacingPanel Orientation="Vertical" Spacing="10">
                            <hc:UniformSpacingPanel Orientation="Horizontal" Spacing="10">
                                <control:TextBoxNoAutoKeyboard
                                    Width="100"
                                    materialDesign:HintAssist.Hint="间隔(秒)"
                                    Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                    Text="{Binding CurrentDeviceParameter.DOParam.AgitCycle.ReverseInterval, UpdateSourceTrigger=LostFocus}">
                                    <i:Interaction.Triggers>
                                        <i:EventTrigger EventName="PreviewMouseLeftButtonDown">
                                            <i:InvokeCommandAction Command="{Binding OpenNumberKeyBoardCommand}" />
                                        </i:EventTrigger>
                                    </i:Interaction.Triggers>
                                </control:TextBoxNoAutoKeyboard>
                                <control:TextBoxNoAutoKeyboard
                                    Width="100"
                                    materialDesign:HintAssist.Hint="转速步长(-)"
                                    Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                    Text="{Binding CurrentDeviceParameter.DOParam.AgitCycle.ReverseStep, UpdateSourceTrigger=LostFocus}">
                                    <i:Interaction.Triggers>
                                        <i:EventTrigger EventName="PreviewMouseLeftButtonDown">
                                            <i:InvokeCommandAction Command="{Binding OpenNumberKeyBoardCommand}" />
                                        </i:EventTrigger>
                                    </i:Interaction.Triggers>
                                </control:TextBoxNoAutoKeyboard>
                            </hc:UniformSpacingPanel>
                        </hc:UniformSpacingPanel>
                    </GroupBox>
                </hc:UniformSpacingPanel>
            </hc:SimplePanel>
            <DockPanel Grid.Row="4" LastChildFill="False">
                <hc:UniformSpacingPanel
                    DockPanel.Dock="Right"
                    Orientation="Horizontal"
                    Spacing="10">
                    <Button
                        Width="90"
                        Height="40"
                        Command="{Binding OpenCommand}"
                        Content="启动控制"
                        IsEnabled="{Binding CurrentDeviceParameter.DOParam.IsControling, Converter={StaticResource InverseBooleanConverter}}"
                        Style="{StaticResource PrimaryCommonButton}" />
                    <Button
                        Width="90"
                        Height="40"
                        Command="{Binding CloseCommand}"
                        Content="停止控制"
                        IsEnabled="{Binding CurrentDeviceParameter.DOParam.IsControling}"
                        Style="{StaticResource SecondaryCommonButton}" />
                </hc:UniformSpacingPanel>
            </DockPanel>
        </Grid>
    </Grid>
</UserControl>
