<UserControl
    x:Class="RD3.Views.PIDView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ex="clr-namespace:LayUI.Wpf.Extensions;assembly=LayUI.Wpf.Extensions"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:local="clr-namespace:RD3"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:share="clr-namespace:RD3.Shared;assembly=RD3.Shared"
    xmlns:sys="clr-namespace:System;assembly=netstandard"
    xmlns:viewmodels="clr-namespace:RD3.ViewModels"
    Width="1350"
    Height="700"
    d:DataContext="{d:DesignInstance Type=viewmodels:PIDViewModel}"
    Background="{StaticResource BackGroundBrush}"
    TextElement.FontFamily="{DynamicResource AppFontFamily}"
    TextElement.FontSize="{DynamicResource TextFontSize}"
    TextElement.FontWeight="Regular"
    TextElement.Foreground="{DynamicResource MaterialDesignBody}"
    TextOptions.TextFormattingMode="Ideal"
    TextOptions.TextRenderingMode="Auto"
    mc:Ignorable="d">
    <prism:Dialog.WindowStyle>
        <Style TargetType="Window">
            <Setter Property="SizeToContent" Value="WidthAndHeight" />
            <Setter Property="ResizeMode" Value="NoResize" />
            <Setter Property="prism:Dialog.WindowStartupLocation" Value="CenterScreen" />
            <Setter Property="Width" Value="{Binding FormWidth, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <Setter Property="Height" Value="{Binding FormHeight, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <Setter Property="Left" Value="{Binding LeftLocation, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <Setter Property="Top" Value="{Binding TopLocation, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <Setter Property="ShowInTaskbar" Value="True" />
            <Setter Property="AllowsTransparency" Value="False" />
            <Setter Property="WindowStyle" Value="ThreeDBorderWindow" />
            <Setter Property="WindowState" Value="{Binding FormState, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <Setter Property="Background" Value="{StaticResource BackGroundBrush}" />
            <Setter Property="Opacity" Value="1" />
        </Style>
    </prism:Dialog.WindowStyle>
    <UserControl.Resources>
        <ObjectDataProvider
            x:Key="DataFromEnum"
            MethodName="GetValues"
            ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="share:PIDFactor" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
    </UserControl.Resources>
    <Border Background="{StaticResource BackGroundBrush}" CornerRadius="{StaticResource DefaultCornerRadius}">
        <Grid Margin="5">
            <Grid.RowDefinitions>
                <!--  操作按钮  -->
                <RowDefinition Height="auto" />
                <RowDefinition Height="10" />
                <!--  数据表格  -->
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <DockPanel LastChildFill="False">
                <hc:UniformSpacingPanel
                    DockPanel.Dock="Right"
                    Orientation="Horizontal"
                    Spacing="10">
                    <Button
                        Width="80"
                        Height="30"
                        Command="{Binding AddCommand}"
                        Content="新增"
                        Style="{StaticResource ButtonPrimary}"
                        Visibility="Collapsed" />
                    <Button
                        Width="80"
                        Height="30"
                        Command="{Binding SaveCommand}"
                        Content="保存"
                        Style="{StaticResource ButtonPrimary}" />
                </hc:UniformSpacingPanel>

            </DockPanel>
            <DataGrid
                Name="dataGrid"
                Grid.Row="2"
                hc:DataGridAttach.CanUnselectAllWithBlankArea="False"
                hc:DataGridAttach.ShowSelectAllButton="False"
                AutoGenerateColumns="False"
                Background="{StaticResource DefaultBrush}"
                CanUserAddRows="True"
                CanUserSortColumns="False"
                ColumnWidth="SizeToHeader"
                GridLinesVisibility="All"
                HeadersVisibility="Column"
                HorizontalGridLinesBrush="LightGray"
                IsReadOnly="False"
                ItemsSource="{Binding PidInfos}"
                RowHeaderWidth="100"
                ScrollViewer.HorizontalScrollBarVisibility="Auto"
                ScrollViewer.VerticalScrollBarVisibility="Auto"
                SelectionMode="Single"
                SelectionUnit="Cell"
                VerticalGridLinesBrush="LightGray">
                <DataGrid.Columns>
                    <DataGridTextColumn
                        Width="80"
                        Binding="{Binding deviceID}"
                        CanUserSort="False"
                        CellStyle="{StaticResource DataGridTextCenterCellStyle}"
                        Header="反应器"
                        HeaderStyle="{StaticResource DataGridCenterColumnHeaderStyle}"
                        IsReadOnly="True" />
                    <DataGridComboBoxColumn
                        Width="120"
                        CellStyle="{StaticResource DataGridTextCenterCellStyle}"
                        Header="作用对象"
                        HeaderStyle="{StaticResource DataGridCenterColumnHeaderStyle}"
                        ItemsSource="{Binding Source={StaticResource DataFromEnum}}"
                        SelectedItemBinding="{Binding Factor}">
                        <!--  显示 Description 而非枚举值  -->
                        <DataGridComboBoxColumn.ElementStyle>
                            <Style TargetType="ComboBox">
                                <Setter Property="ItemTemplate">
                                    <Setter.Value>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Converter={StaticResource EnumToStringConverter}}" />
                                        </DataTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </DataGridComboBoxColumn.ElementStyle>

                        <DataGridComboBoxColumn.EditingElementStyle>
                            <Style TargetType="ComboBox">
                                <Setter Property="ItemTemplate">
                                    <Setter.Value>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Converter={StaticResource EnumToStringConverter}}" />
                                        </DataTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </DataGridComboBoxColumn.EditingElementStyle>
                    </DataGridComboBoxColumn>
                    <DataGridTextColumn
                        Width="100"
                        Binding="{Binding PidName}"
                        CanUserSort="False"
                        CellStyle="{StaticResource DataGridTextCenterCellStyle}"
                        Header="名称"
                        HeaderStyle="{StaticResource DataGridCenterColumnHeaderStyle}"
                        IsReadOnly="True" />
                    <DataGridTextColumn
                        Width="100"
                        Binding="{Binding P}"
                        CanUserSort="False"
                        CellStyle="{StaticResource DataGridTextCenterCellStyle}"
                        Header="P"
                        HeaderStyle="{StaticResource DataGridCenterColumnHeaderStyle}"
                        IsReadOnly="False" />
                    <DataGridTextColumn
                        Width="100"
                        Binding="{Binding I}"
                        CanUserSort="False"
                        CellStyle="{StaticResource DataGridTextCenterCellStyle}"
                        Header="I"
                        HeaderStyle="{StaticResource DataGridCenterColumnHeaderStyle}"
                        IsReadOnly="False" />
                    <DataGridTextColumn
                        Width="100"
                        Binding="{Binding D}"
                        CanUserSort="False"
                        CellStyle="{StaticResource DataGridTextCenterCellStyle}"
                        Header="D"
                        HeaderStyle="{StaticResource DataGridCenterColumnHeaderStyle}"
                        IsReadOnly="False" />
                    <DataGridTextColumn
                        Width="100"
                        Binding="{Binding Threshold}"
                        CanUserSort="False"
                        CellStyle="{StaticResource DataGridTextCenterCellStyle}"
                        Header="阈值"
                        HeaderStyle="{StaticResource DataGridCenterColumnHeaderStyle}"
                        IsReadOnly="False" />
                    <DataGridTextColumn
                        Width="120"
                        Binding="{Binding Interval}"
                        CanUserSort="False"
                        CellStyle="{StaticResource DataGridTextCenterCellStyle}"
                        Header="采样间隔（s）"
                        HeaderStyle="{StaticResource DataGridCenterColumnHeaderStyle}"
                        IsReadOnly="False" />
                    <DataGridTextColumn
                        Width="100"
                        Binding="{Binding deadArea}"
                        CanUserSort="False"
                        CellStyle="{StaticResource DataGridTextCenterCellStyle}"
                        Header="死区"
                        HeaderStyle="{StaticResource DataGridCenterColumnHeaderStyle}"
                        IsReadOnly="False" />
                    <DataGridTextColumn
                        Width="100"
                        Binding="{Binding maxSpeed}"
                        CanUserSort="False"
                        CellStyle="{StaticResource DataGridTextCenterCellStyle}"
                        Header="上限"
                        HeaderStyle="{StaticResource DataGridCenterColumnHeaderStyle}"
                        IsReadOnly="False" />
                    <DataGridTemplateColumn
                        MinWidth="100"
                        CellStyle="{StaticResource DataGridTextCenterCellStyle}"
                        Header="模式"
                        HeaderStyle="{StaticResource DataGridCenterColumnHeaderStyle}"
                        Visibility="Collapsed">
                        <!--<DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <hc:UniformSpacingPanel Orientation="Horizontal" Spacing="5">
                                    <Button Content="手动" Name="btnExcuteType" Width="0" Click="btnExcuteType_Click"/>
                                </hc:UniformSpacingPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>-->
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <hc:UniformSpacingPanel Orientation="Horizontal" Spacing="5">
                                    <Button
                                        Name="btnExcuteType"
                                        Width="70"
                                        Click="btnExcuteType_Click"
                                        Content="{Binding excuteType}" />
                                </hc:UniformSpacingPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn
                        MinWidth="100"
                        CellStyle="{StaticResource DataGridTextCenterCellStyle}"
                        Header="操作"
                        HeaderStyle="{StaticResource DataGridCenterColumnHeaderStyle}"
                        Visibility="Collapsed">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <hc:UniformSpacingPanel Orientation="Horizontal" Spacing="5">
                                    <Button
                                        Name="btnExcute"
                                        Width="70"
                                        Click="btn_excute_Click"
                                        Content="开始" />
                                </hc:UniformSpacingPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Border>
</UserControl>
