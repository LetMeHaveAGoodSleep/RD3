<UserControl
    x:Class="RD3.Views.RealTimeDataView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:local="clr-namespace:RD3.Views"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:rd3="clr-namespace:RD3"
    xmlns:scottPlot="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
    xmlns:viewmodels="clr-namespace:RD3.ViewModels"
    Width="800"
    Height="550"
    d:DataContext="{d:DesignInstance Type=viewmodels:RealTimeDataViewModel}"
    prism:ViewModelLocator.AutoWireViewModel="True"
    Background="{StaticResource RegionBackgroundBrush}"
    mc:Ignorable="d">
    <prism:Dialog.WindowStyle>
        <Style TargetType="Window">
            <Setter Property="SizeToContent" Value="WidthAndHeight" />
            <Setter Property="ResizeMode" Value="NoResize" />
            <Setter Property="prism:Dialog.WindowStartupLocation" Value="CenterScreen" />
            <Setter Property="Width" Value="{Binding FormWidth, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <Setter Property="Height" Value="{Binding FormHeight, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <Setter Property="Left" Value="{Binding LeftLocation, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <Setter Property="Top" Value="{Binding TopLocation, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <Setter Property="ShowInTaskbar" Value="True" />
            <Setter Property="AllowsTransparency" Value="False" />
            <Setter Property="WindowStyle" Value="ThreeDBorderWindow" />
            <Setter Property="WindowState" Value="{Binding FormState, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <Setter Property="Opacity" Value="1" />
            <Setter Property="Background" Value="{StaticResource RegionBackgroundBrush}" />
        </Style>
    </prism:Dialog.WindowStyle>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="10" />
            <RowDefinition Height="*" />
            <RowDefinition Height="10" />
            <RowDefinition Height="auto" />
        </Grid.RowDefinitions>
        <hc:UniformSpacingPanel Orientation="Horizontal" Spacing="30">
            <hc:UniformSpacingPanel Orientation="Horizontal" Spacing="10">
                <ComboBox
                    Width="100"
                    materialDesign:ComboBoxAssist.ShowSelectedItem="True"
                    materialDesign:HintAssist.Hint="反应器"
                    ItemsSource="{Binding Fermentors}"
                    SelectedItem="{Binding CurrentFermentor}"
                    Style="{StaticResource MaterialDesignFloatingHintComboBox}"
                    Visibility="Collapsed">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Device.Name}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <DatePicker
                    Width="150"
                    materialDesign:HintAssist.Hint="开始时间"
                    SelectedDate="{Binding StartTime}"
                    SelectedDateFormat="Long"
                    Style="{StaticResource MaterialDesignFloatingHintDatePicker}" />
                <DatePicker
                    Width="150"
                    materialDesign:HintAssist.Hint="结束时间"
                    SelectedDate="{Binding EndTime}"
                    SelectedDateFormat="Long"
                    Style="{StaticResource MaterialDesignFloatingHintDatePicker}" />
            </hc:UniformSpacingPanel>
            <hc:UniformSpacingPanel Orientation="Horizontal" Spacing="10">
                <DockPanel LastChildFill="False">
                    <Button
                        Width="80"
                        Height="30"
                        Command="{Binding QueryCommand}"
                        Content="查询"
                        DockPanel.Dock="Bottom"
                        Style="{StaticResource PrimaryCommonButton}" />
                </DockPanel>
                <DockPanel LastChildFill="False">
                    <Button
                        Width="80"
                        Height="30"
                        Command="{Binding ChooseColumnCommand}"
                        Content="参数选择"
                        DockPanel.Dock="Bottom"
                        Style="{StaticResource PrimaryCommonButton}" />
                </DockPanel>
                <DockPanel LastChildFill="False">
                    <Button
                        Width="80"
                        Height="30"
                        Command="{Binding ExportCommand}"
                        Content="数据导出"
                        DockPanel.Dock="Bottom"
                        Style="{StaticResource PrimaryCommonButton}" />
                </DockPanel>
            </hc:UniformSpacingPanel>
        </hc:UniformSpacingPanel>
        <DataGrid
            Name="dataGrid"
            Grid.Row="2"
            hc:DataGridAttach.ShowRowNumber="True"
            hc:DataGridAttach.ShowSelectAllButton="False"
            rd3:DataGridColumnsAttach.ColumnsSource="{Binding ReportNodes}"
            AutoGenerateColumns="False"
            CanUserAddRows="False"
            CanUserSortColumns="False"
            CellStyle="{StaticResource DataGridTextCenterCellStyle}"
            ColumnHeaderHeight="35"
            ColumnWidth="SizeToHeader"
            GridLinesVisibility="All"
            HeadersVisibility="Column"
            HorizontalGridLinesBrush="LightGray"
            IsReadOnly="False"
            ItemsSource="{Binding RealTimeParamCol}"
            RowHeaderWidth="100"
            RowHeight="35"
            RowStyle="{StaticResource PrimaryDataGridRowStyle}"
            ScrollViewer.HorizontalScrollBarVisibility="Auto"
            ScrollViewer.VerticalScrollBarVisibility="Auto"
            SelectionMode="Single"
            SelectionUnit="FullRow"
            Style="{StaticResource DataGridBaseStyle}"
            VerticalGridLinesBrush="LightGray">
            <DataGrid.Columns />
        </DataGrid>
        <hc:Pagination
            Grid.Row="4"
            HorizontalAlignment="Right"
            Background="Transparent"
            DataCountPerPage="{Binding DataCountPerPage}"
            DockPanel.Dock="Right"
            FontSize="{StaticResource SubHeadFontSize}"
            IsJumpEnabled="True"
            MaxPageCount="{Binding PageCount}"
            MaxPageInterval="4"
            PageIndex="{Binding PageIndex}">
            <hc:Interaction.Triggers>
                <hc:EventTrigger EventName="PageUpdated">
                    <hc:EventToCommand Command="{Binding PageUpdatedCommand}" PassEventArgsToCommand="True" />
                </hc:EventTrigger>
            </hc:Interaction.Triggers>
        </hc:Pagination>
    </Grid>
</UserControl>
