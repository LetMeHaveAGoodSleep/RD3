<UserControl
    x:Class="RD3.Views.OffLineDatasView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Selector="clr-namespace:RD3"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ex="clr-namespace:LayUI.Wpf.Extensions;assembly=LayUI.Wpf.Extensions"
    xmlns:ext="clr-namespace:RD3.Extensions"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:local="clr-namespace:RD3"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:viewmodels="clr-namespace:RD3.ViewModels"
    xmlns:wpf="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
    Width="1400"
    Height="880"
    d:DataContext="{d:DesignInstance Type=viewmodels:OffLineDatasViewModel}"
    prism:ViewModelLocator.AutoWireViewModel="True"
    Background="Transparent"
    TextElement.FontFamily="{DynamicResource AppFontFamily}"
    TextElement.FontWeight="Regular"
    TextElement.Foreground="{DynamicResource MaterialDesignBody}"
    TextOptions.TextFormattingMode="Ideal"
    TextOptions.TextRenderingMode="Auto"
    mc:Ignorable="d">
    <Border Background="{StaticResource BackGroundBrush}" CornerRadius="{StaticResource DefaultCornerRadius}">
        <Grid>
            <Grid.RowDefinitions>
                <!--  操作按钮  -->
                <RowDefinition Height="70" />
                <!--  数据表格  -->
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Name="controlButtons">
                <!--  操作按钮  -->
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200" />
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="120" />
                </Grid.ColumnDefinitions>
                <DockPanel Grid.Column="0">
                    <TextBox
                        Name="colName"
                        Width="100"
                        Height="40"
                        Padding="5,5,5,5" />
                    <Button
                        Name="AddColumn"
                        Width="80"
                        Height="40"
                        Background="SkyBlue"
                        Click="AddColumn_Click"
                        Content="添加数据" />
                </DockPanel>

                <Button
                    Name="DeleteColumn"
                    Grid.Column="1"
                    Width="80"
                    Height="40"
                    Background="SkyBlue"
                    Click="DeleteColumn_Click"
                    Content="删除数据" />
                <Button
                    Name="InputColumn"
                    Grid.Column="2"
                    Width="80"
                    Height="40"
                    Background="SkyBlue"
                    Click="InputColumn_Click"
                    Content="导入数据" />
                <Button
                    Name="DeleteRow"
                    Grid.Column="3"
                    Width="80"
                    Height="40"
                    Background="SkyBlue"
                    Click="DeleteRow_Click"
                    Content="删除样品" />
                <!--  Command="{Binding SaveCommand}"  -->
                <Button
                    Name="SaveColumn"
                    Grid.Column="5"
                    Width="80"
                    Height="40"
                    Background="SkyBlue"
                    Click="SaveColumn_Click"
                    Content="保存数据" />
            </Grid>
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="270" />
                    <ColumnDefinition Width="270" />
                </Grid.ColumnDefinitions>
                <DataGrid
                    Name="dataGrid"
                    Grid.Column="0"
                    hc:DataGridAttach.CanUnselectAllWithBlankArea="False"
                    hc:DataGridAttach.ShowSelectAllButton="False"
                    AutoGenerateColumns="False"
                    Background="{StaticResource DefaultBrush}"
                    CanUserAddRows="True"
                    CanUserSortColumns="False"
                    ColumnWidth="SizeToHeader"
                    GridLinesVisibility="All"
                    HeadersVisibility="Column"
                    HorizontalGridLinesBrush="LightGray"
                    IsReadOnly="False"
                    ItemsSource="{Binding DataTable}"
                    RowHeaderWidth="100"
                    ScrollViewer.HorizontalScrollBarVisibility="Auto"
                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                    SelectionMode="Single"
                    SelectionUnit="Cell"
                    VerticalGridLinesBrush="LightGray">
                    <DataGrid.Columns>
                        <!--  设备列表  -->
                        <DataGridTextColumn
                            Width="180"
                            Binding="{Binding sampletime}"
                            CanUserSort="True"
                            Header="采样时间"
                            IsReadOnly="False" />
                        <DataGridTextColumn
                            Width="100"
                            Binding="{Binding sampleNo}"
                            CanUserSort="False"
                            Header="样品序列号"
                            IsReadOnly="False" />
                    </DataGrid.Columns>
                </DataGrid>
                <DockPanel Grid.Column="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="70" />
                            <RowDefinition Height="70" />
                            <RowDefinition Height="70" />
                            <RowDefinition Height="70" />
                        </Grid.RowDefinitions>
                        <StackPanel
                            Grid.Row="0"
                            Background="SkyBlue"
                            Orientation="Horizontal">
                            <Label
                                Width="60"
                                Background="Transparent"
                                BorderBrush="Transparent">
                                接种
                            </Label>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Orientation="Horizontal">
                            <Label
                                Width="60"
                                Background="Transparent"
                                BorderBrush="Transparent">
                                时间
                            </Label>
                            <hc:DateTimePicker
                                Name="vaccinateTime"
                                Width="200"
                                Height="40"
                                Text="{Binding VaccinateInof.vaccinateTime}" />
                        </StackPanel>
                        <StackPanel Grid.Row="2" Orientation="Horizontal">
                            <Label
                                Width="60"
                                Background="Transparent"
                                BorderBrush="Transparent">
                                体积
                            </Label>
                            <TextBox
                                Name="vaccinateV"
                                Width="200"
                                Height="40"
                                Text="{Binding VaccinateInof.vaccinateV}" />
                        </StackPanel>
                        <StackPanel Grid.Row="3" Orientation="Horizontal">
                            <Label
                                Width="60"
                                Background="Transparent"
                                BorderBrush="Transparent">
                                OD
                            </Label>
                            <TextBox
                                Name="ODValue"
                                Width="200"
                                Height="40"
                                Text="{Binding VaccinateInof.ODValue}" />
                        </StackPanel>
                    </Grid>
                </DockPanel>
                <DockPanel Grid.Column="2">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="70" />
                            <RowDefinition Height="70" />
                            <RowDefinition Height="70" />
                            <RowDefinition Height="70" />
                        </Grid.RowDefinitions>
                        <StackPanel
                            Grid.Row="0"
                            Background="Aqua"
                            Orientation="Horizontal">
                            <Label
                                Width="60"
                                Background="Transparent"
                                BorderBrush="Transparent">
                                诱导
                            </Label>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Orientation="Horizontal">
                            <Label
                                Width="60"
                                Background="Transparent"
                                BorderBrush="Transparent">
                                时间
                            </Label>
                            <hc:DateTimePicker
                                Name="induceTime"
                                Width="200"
                                Height="40"
                                Text="{Binding InduceInof.induceTime}" />
                        </StackPanel>
                        <StackPanel Grid.Row="2" Orientation="Horizontal">
                            <Label
                                Width="60"
                                Background="Transparent"
                                BorderBrush="Transparent">
                                体积
                            </Label>
                            <TextBox
                                Name="induceV"
                                Width="200"
                                Height="40"
                                Text="{Binding InduceInof.induceV}" />
                        </StackPanel>
                        <StackPanel Grid.Row="3" Orientation="Horizontal">
                            <Label
                                Width="60"
                                Background="Transparent"
                                BorderBrush="Transparent">
                                浓度
                            </Label>
                            <TextBox
                                Name="inducedensity"
                                Width="200"
                                Height="40"
                                Text="{Binding InduceInof.inducedensity}" />
                        </StackPanel>
                    </Grid>
                </DockPanel>
            </Grid>
        </Grid>

    </Border>
</UserControl>
