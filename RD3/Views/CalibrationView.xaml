<UserControl
    x:Class="RD3.Views.CalibrationView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behavior="clr-namespace:RD3.Behaviors"
    xmlns:common="clr-namespace:RD3.Common"
    xmlns:cv="clr-namespace:RD3.Common.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ex="clr-namespace:LayUI.Wpf.Extensions;assembly=LayUI.Wpf.Extensions"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:local="clr-namespace:RD3.Views"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:share="clr-namespace:RD3.Shared;assembly=RD3.Shared"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    xmlns:vm="clr-namespace:RD3.ViewModels"
    xmlns:wpf="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
    Width="1440"
    Height="700"
    d:DataContext="{d:DesignInstance Type=vm:CalibrateViewModel}"
    d:DesignHeight="600"
    d:DesignWidth="1500"
    prism:ViewModelLocator.AutoWireViewModel="True"
    Background="{StaticResource BackGroundBrush}"
    TextElement.FontFamily="{DynamicResource AppFontFamily}"
    TextElement.FontSize="{DynamicResource TextFontSize}"
    TextElement.FontWeight="Regular"
    TextElement.Foreground="{DynamicResource MaterialDesignBody}"
    TextOptions.TextFormattingMode="Ideal"
    TextOptions.TextRenderingMode="Auto"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ObjectDataProvider
            x:Key="DataFromEnum"
            MethodName="GetValues"
            ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="share:PeristalticPump" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
    </UserControl.Resources>
    <prism:Dialog.WindowStyle>
        <Style TargetType="Window">
            <Setter Property="SizeToContent" Value="WidthAndHeight" />
            <Setter Property="ResizeMode" Value="NoResize" />
            <Setter Property="prism:Dialog.WindowStartupLocation" Value="CenterOwner" />
            <Setter Property="Width" Value="{Binding FormWidth, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <Setter Property="Height" Value="{Binding FormHeight, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <Setter Property="Left" Value="{Binding LeftLocation, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <Setter Property="Top" Value="{Binding TopLocation, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <Setter Property="ShowInTaskbar" Value="True" />
            <Setter Property="AllowsTransparency" Value="False" />
            <Setter Property="WindowStyle" Value="SingleBorderWindow" />
            <Setter Property="WindowState" Value="{Binding FormState, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <Setter Property="Background" Value="{StaticResource BackGroundBrush}" />
            <Setter Property="Opacity" Value="1" />
            <Setter Property="Icon" Value="../Assets/logo.png" />
        </Style>
    </prism:Dialog.WindowStyle>
    <DockPanel LastChildFill="True">
        <TreeView
            Name="TreeReactor"
            Width="120"
            Margin="5"
            DockPanel.Dock="Left"
            ScrollViewer.HorizontalScrollBarVisibility="Visible"
            ScrollViewer.VerticalScrollBarVisibility="Visible"
            SelectedItemChanged="TreeReactor_SelectedItemChanged"
            Style="{StaticResource TreeViewBaseStyle}" />
        <hc:UniformSpacingPanel
            Margin="5"
            Orientation="Vertical"
            Spacing="20">
            <GroupBox Header="{ex:Language Key='传感器校准'}" Style="{StaticResource MaterialDesignCardGroupBox}">
                <hc:UniformSpacingPanel Orientation="Vertical" Spacing="30">
                    <hc:UniformSpacingPanel Orientation="Vertical" Spacing="10">
                        <DockPanel LastChildFill="False">
                            <Border
                                Height="45"
                                Background="{DynamicResource BorderBrush}"
                                BorderThickness="0.5"
                                CornerRadius="8">
                                <hc:ButtonGroup VerticalAlignment="Center" Style="{StaticResource ButtonGroupSolid}">
                                    <RadioButton
                                        Width="auto"
                                        Height="35"
                                        Margin="5,0,0,0"
                                        hc:BorderElement.CornerRadius="8"
                                        Background="{DynamicResource BorderBrush}"
                                        Content="{ex:Language Key='温度传感器'}"
                                        FontSize="{DynamicResource MediumFontSize}"
                                        Foreground="{DynamicResource SecondaryTextBrush}"
                                        IsChecked="{Binding SensorType, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=PT100}" />
                                    <RadioButton
                                        Width="auto"
                                        Height="35"
                                        Margin="5,0,5,0"
                                        hc:BorderElement.CornerRadius="8"
                                        Background="{DynamicResource BorderBrush}"
                                        Content="{ex:Language Key='pH传感器'}"
                                        FontSize="{DynamicResource MediumFontSize}"
                                        Foreground="{DynamicResource SecondaryTextBrush}"
                                        IsChecked="{Binding SensorType, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=pH}" />
                                    <RadioButton
                                        Width="auto"
                                        Height="35"
                                        Margin="5,0,5,0"
                                        hc:BorderElement.CornerRadius="8"
                                        Background="{DynamicResource BorderBrush}"
                                        Content="{ex:Language Key='DO传感器'}"
                                        FontSize="{DynamicResource MediumFontSize}"
                                        Foreground="{DynamicResource SecondaryTextBrush}"
                                        IsChecked="{Binding SensorType, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=DO}" />
                                    <RadioButton
                                        Width="auto"
                                        Height="35"
                                        Margin="5,0,5,0"
                                        hc:BorderElement.CornerRadius="8"
                                        Background="{DynamicResource BorderBrush}"
                                        Content="{ex:Language Key='称重1'}"
                                        FontSize="{DynamicResource MediumFontSize}"
                                        Foreground="{DynamicResource SecondaryTextBrush}"
                                        IsChecked="{Binding SensorType, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=JarWeight}" />
                                    <RadioButton
                                        Width="auto"
                                        Height="35"
                                        Margin="5,0,5,0"
                                        hc:BorderElement.CornerRadius="8"
                                        Background="{DynamicResource BorderBrush}"
                                        Content="{ex:Language Key='称重2'}"
                                        FontSize="{DynamicResource MediumFontSize}"
                                        Foreground="{DynamicResource SecondaryTextBrush}"
                                        IsChecked="{Binding SensorType, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Bottle1Weight}" />
                                    <RadioButton
                                        Width="auto"
                                        Height="35"
                                        Margin="5,0,5,0"
                                        hc:BorderElement.CornerRadius="8"
                                        Background="{DynamicResource BorderBrush}"
                                        Content="{ex:Language Key='称重3'}"
                                        FontSize="{DynamicResource SubHeadFontSize}"
                                        Foreground="{DynamicResource SecondaryTextBrush}"
                                        IsChecked="{Binding SensorType, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Bottle2Weight}" />
                                    <RadioButton
                                        Width="auto"
                                        Height="35"
                                        Margin="5,0,5,0"
                                        hc:BorderElement.CornerRadius="8"
                                        Background="{DynamicResource BorderBrush}"
                                        Content="{ex:Language Key='pH传感器温度'}"
                                        FontSize="{DynamicResource MediumFontSize}"
                                        Foreground="{DynamicResource SecondaryTextBrush}"
                                        IsChecked="{Binding SensorType, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=pHTemp}"
                                        Visibility="Collapsed" />
                                    <RadioButton
                                        Width="auto"
                                        Height="35"
                                        Margin="5,0,5,0"
                                        hc:BorderElement.CornerRadius="8"
                                        Background="{DynamicResource BorderBrush}"
                                        Content="{ex:Language Key='DO传感器温度'}"
                                        FontSize="{DynamicResource MediumFontSize}"
                                        Foreground="{DynamicResource SecondaryTextBrush}"
                                        IsChecked="{Binding SensorType, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=DOTemp}"
                                        Visibility="Collapsed" />
                                </hc:ButtonGroup>
                            </Border>
                        </DockPanel>
                        <DockPanel LastChildFill="False" Visibility="Collapsed">
                            <Border
                                Height="45"
                                Background="{DynamicResource BorderBrush}"
                                BorderThickness="0.5"
                                CornerRadius="8">
                                <hc:ButtonGroup VerticalAlignment="Center" Style="{StaticResource ButtonGroupSolid}">
                                    <RadioButton
                                        Width="auto"
                                        Height="35"
                                        Margin="5,0,0,0"
                                        hc:BorderElement.CornerRadius="8"
                                        Background="{DynamicResource BorderBrush}"
                                        Content="{ex:Language Key='温控NTC1冷面'}"
                                        FontSize="{DynamicResource MediumFontSize}"
                                        Foreground="{DynamicResource SecondaryTextBrush}"
                                        IsChecked="{Binding SensorType, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=TempControlNTC1}" />
                                    <RadioButton
                                        Width="auto"
                                        Height="35"
                                        Margin="5,0,5,0"
                                        hc:BorderElement.CornerRadius="8"
                                        Background="{DynamicResource BorderBrush}"
                                        Content="{ex:Language Key='温控NTC1热面'}"
                                        FontSize="{DynamicResource MediumFontSize}"
                                        Foreground="{DynamicResource SecondaryTextBrush}"
                                        IsChecked="{Binding SensorType, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=TempControlNTC2}" />
                                    <RadioButton
                                        Width="auto"
                                        Height="35"
                                        Margin="5,0,0,0"
                                        hc:BorderElement.CornerRadius="8"
                                        Background="{DynamicResource BorderBrush}"
                                        Content="{ex:Language Key='冷凝NTC1冷面'}"
                                        FontSize="{DynamicResource MediumFontSize}"
                                        Foreground="{DynamicResource SecondaryTextBrush}"
                                        IsChecked="{Binding SensorType, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=CoolingModuleNTC1}" />
                                    <RadioButton
                                        Width="auto"
                                        Height="35"
                                        Margin="5,0,5,0"
                                        hc:BorderElement.CornerRadius="8"
                                        Background="{DynamicResource BorderBrush}"
                                        Content="{ex:Language Key='冷凝NTC1热面'}"
                                        FontSize="{DynamicResource MediumFontSize}"
                                        Foreground="{DynamicResource SecondaryTextBrush}"
                                        IsChecked="{Binding SensorType, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=CoolingModuleNTC2}" />
                                    <RadioButton
                                        Width="auto"
                                        Height="35"
                                        Margin="5,0,5,0"
                                        hc:BorderElement.CornerRadius="8"
                                        Background="{DynamicResource BorderBrush}"
                                        Content="{ex:Language Key='冷凝NTC3室温'}"
                                        FontSize="{DynamicResource MediumFontSize}"
                                        Foreground="{DynamicResource SecondaryTextBrush}"
                                        IsChecked="{Binding SensorType, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=CoolingModuleNTC3}" />
                                </hc:ButtonGroup>
                            </Border>
                        </DockPanel>
                    </hc:UniformSpacingPanel>
                    <hc:UniformSpacingPanel Orientation="Horizontal" Spacing="10">
                        <ComboBox
                            Width="120"
                            VerticalAlignment="Center"
                            hc:InfoElement.Title="{ex:Language Key='校准模式'}"
                            BorderBrush="{DynamicResource PrimaryBrush}"
                            SelectedIndex="{Binding CalibrateIndex}"
                            Style="{StaticResource ComboBoxExtend}">
                            <ComboBoxItem Content="系数校准" />
                            <ComboBoxItem Content="单点校准" />
                            <ComboBoxItem Content="两点校准" />
                        </ComboBox>
                        <TextBox
                            Width="120"
                            hc:InfoElement.Title="{ex:Language Key='当前值'}"
                            BorderBrush="{DynamicResource PrimaryBrush}"
                            IsEnabled="False"
                            Style="{StaticResource TextBoxExtend}"
                            Text="{Binding CurrentValue}" />
                        <TextBox
                            Width="120"
                            hc:InfoElement.Title="{ex:Language Key='校准点1'}"
                            BorderBrush="{DynamicResource PrimaryBrush}"
                            IsEnabled="{Binding Calibrate1Enabled}"
                            Style="{StaticResource TextBoxExtend}"
                            Text="{Binding CaliPoint1}" />
                        <DockPanel LastChildFill="False">
                            <Button
                                Width="80"
                                hc:BorderElement.CornerRadius="{StaticResource DefaultCornerRadius}"
                                BorderBrush="{StaticResource PrimaryBrush}"
                                Command="{Binding CalibrateSensorCommand}"
                                CommandParameter="1"
                                Content="{ex:Language Key='校准1'}"
                                DockPanel.Dock="Bottom"
                                IsEnabled="{Binding Calibrate1Enabled}"
                                Style="{StaticResource ButtonPrimary}" />
                        </DockPanel>
                        <TextBox
                            Width="120"
                            hc:InfoElement.Title="{ex:Language Key='校准点2'}"
                            BorderBrush="{DynamicResource PrimaryBrush}"
                            IsEnabled="{Binding Calibrate2Enabled}"
                            Style="{StaticResource TextBoxExtend}"
                            Text="{Binding CaliPoint2}" />
                        <DockPanel LastChildFill="False">
                            <Button
                                Width="80"
                                hc:BorderElement.CornerRadius="{StaticResource DefaultCornerRadius}"
                                BorderBrush="{StaticResource PrimaryBrush}"
                                Command="{Binding CalibrateSensorCommand}"
                                CommandParameter="2"
                                Content="{ex:Language Key='校准2'}"
                                DockPanel.Dock="Bottom"
                                IsEnabled="{Binding Calibrate2Enabled}"
                                Style="{StaticResource ButtonPrimary}" />
                        </DockPanel>
                        <TextBox
                            Width="120"
                            hc:InfoElement.Title="{ex:Language Key='传感器系数'}"
                            BorderBrush="{DynamicResource PrimaryBrush}"
                            IsEnabled="False"
                            Style="{StaticResource TextBoxExtend}"
                            Text="{Binding Coefficient}" />
                        <TextBox
                            Width="120"
                            hc:InfoElement.Title="{ex:Language Key='传感器偏置'}"
                            BorderBrush="{DynamicResource PrimaryBrush}"
                            IsEnabled="False"
                            Style="{StaticResource TextBoxExtend}"
                            Text="{Binding Bias}" />
                        <TextBox
                            Width="120"
                            hc:InfoElement.Title="{ex:Language Key='状态码'}"
                            BorderBrush="{DynamicResource PrimaryBrush}"
                            IsEnabled="False"
                            Style="{StaticResource TextBoxExtend}"
                            Text="{Binding StatusCode}" />
                    </hc:UniformSpacingPanel>
                </hc:UniformSpacingPanel>
            </GroupBox>
            <GroupBox Header="{ex:Language Key='蠕动泵校准'}" Style="{StaticResource MaterialDesignCardGroupBox}">
                <hc:UniformSpacingPanel Orientation="Vertical" Spacing="10">
                    <hc:UniformSpacingPanel Orientation="Horizontal" Spacing="10">
                        <TextBox
                            Width="60"
                            HorizontalContentAlignment="Center"
                            hc:InfoElement.Title="{ex:Language Key='泵编号'}"
                            BorderBrush="{DynamicResource PrimaryBrush}"
                            IsEnabled="False"
                            Style="{StaticResource TextBoxExtend}"
                            Text="泵1" />
                        <ComboBox
                            Width="100"
                            HorizontalContentAlignment="Center"
                            hc:InfoElement.Title="{ex:Language Key='泵用途'}"
                            BorderBrush="{DynamicResource PrimaryBrush}"
                            ItemsSource="{Binding Source={StaticResource DataFromEnum}}"
                            SelectedItem="{Binding Pump1Param.Pump}"
                            Style="{StaticResource ComboBoxExtend}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={StaticResource EnumToStringConverter}}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                            <i:Interaction.Triggers>
                                <i:EventTrigger EventName="SelectionChanged">
                                    <i:InvokeCommandAction Command="{Binding ChangePumpCommand}" PassEventArgsToCommand="True" />
                                </i:EventTrigger>
                            </i:Interaction.Triggers>
                        </ComboBox>
                        <TextBox
                            Width="80"
                            hc:InfoElement.Title="{ex:Language Key='流速（ml/h）'}"
                            BorderBrush="{DynamicResource PrimaryBrush}"
                            Style="{StaticResource TextBoxExtend}"
                            Text="{Binding Pump1Param.Speed, UpdateSourceTrigger=LostFocus}" />
                        <TextBox
                            Width="80"
                            hc:InfoElement.Title="{ex:Language Key='时间（min）'}"
                            BorderBrush="{DynamicResource PrimaryBrush}"
                            Style="{StaticResource TextBoxExtend}"
                            Text="{Binding Pump1Param.Time, UpdateSourceTrigger=LostFocus}" />
                        <TextBox
                            Width="80"
                            hc:InfoElement.Title="体积(mL)"
                            BorderBrush="{DynamicResource PrimaryBrush}"
                            IsEnabled="False"
                            Style="{StaticResource TextBoxExtend}"
                            Text="{Binding Pump1Param.TheoreticalVolume, UpdateSourceTrigger=LostFocus}" />
                        <DockPanel>
                            <Button
                                Width="80"
                                VerticalAlignment="Bottom"
                                hc:BorderElement.CornerRadius="{StaticResource DefaultCornerRadius}"
                                Command="{Binding CalibratePumpCommand}"
                                CommandParameter="1,1"
                                Content="{ex:Language Key='开始'}"
                                Style="{StaticResource ButtonPrimary}" />
                        </DockPanel>
                        <TextBox
                            Width="80"
                            hc:InfoElement.Title="称重(g)"
                            BorderBrush="{DynamicResource PrimaryBrush}"
                            Style="{StaticResource TextBoxExtend}"
                            Text="{Binding Pump1Param.Weigh, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBox
                            Width="80"
                            hc:InfoElement.Title="密度(g/mL)"
                            BorderBrush="{DynamicResource PrimaryBrush}"
                            Style="{StaticResource TextBoxExtend}"
                            Text="{Binding Pump1Param.Density, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBox
                            Width="80"
                            hc:InfoElement.Title="实测体积(mL)"
                            BorderBrush="{DynamicResource PrimaryBrush}"
                            IsEnabled="False"
                            Style="{StaticResource TextBoxExtend}"
                            Text="{Binding Pump1Param.RealVolume, UpdateSourceTrigger=PropertyChanged}" />
                        <DockPanel>
                            <Button
                                Width="80"
                                VerticalAlignment="Bottom"
                                Command="{Binding CalibratePumpCommand}"
                                CommandParameter="3,1"
                                Content="{ex:Language Key='写入'}"
                                Style="{StaticResource ButtonPrimary}" />
                        </DockPanel>
                        <DockPanel>
                            <Button
                                Width="80"
                                VerticalAlignment="Bottom"
                                Command="{Binding CalibratePumpCommand}"
                                CommandParameter="255,1"
                                Content="{ex:Language Key='完成校准'}"
                                Style="{StaticResource ButtonPrimary}" />
                        </DockPanel>
                        <TextBox
                            Width="80"
                            hc:InfoElement.Title="当前系数"
                            BorderBrush="{DynamicResource PrimaryBrush}"
                            IsEnabled="False"
                            Style="{StaticResource TextBoxExtend}"
                            Text="{Binding Pump1Param.OldCoefficient, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBox
                            Width="80"
                            hc:InfoElement.Title="更正系数"
                            BorderBrush="{DynamicResource PrimaryBrush}"
                            Style="{StaticResource TextBoxExtend}"
                            Text="{Binding Pump1Param.Coefficient, UpdateSourceTrigger=LostFocus}" />
                        <DockPanel>
                            <Button
                                Width="80"
                                VerticalAlignment="Bottom"
                                Command="{Binding CalibratePumpCommand}"
                                CommandParameter="0,1"
                                Content="{ex:Language Key='校准系数'}"
                                Style="{StaticResource ButtonPrimary}" />
                        </DockPanel>
                    </hc:UniformSpacingPanel>
                    <hc:UniformSpacingPanel Orientation="Horizontal" Spacing="10">
                        <TextBox
                            Width="60"
                            HorizontalContentAlignment="Center"
                            hc:InfoElement.Title="{ex:Language Key='泵编号'}"
                            BorderBrush="{DynamicResource PrimaryBrush}"
                            IsEnabled="False"
                            Style="{StaticResource TextBoxExtend}"
                            Text="泵2" />
                        <ComboBox
                            Width="100"
                            HorizontalContentAlignment="Center"
                            hc:InfoElement.Title="{ex:Language Key='泵用途'}"
                            BorderBrush="{DynamicResource PrimaryBrush}"
                            ItemsSource="{Binding Source={StaticResource DataFromEnum}}"
                            SelectedItem="{Binding Pump2Param.Pump}"
                            Style="{StaticResource ComboBoxExtend}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={StaticResource EnumToStringConverter}}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                            <i:Interaction.Triggers>
                                <i:EventTrigger EventName="SelectionChanged">
                                    <i:InvokeCommandAction Command="{Binding ChangePumpCommand}" PassEventArgsToCommand="True" />
                                </i:EventTrigger>
                            </i:Interaction.Triggers>
                        </ComboBox>
                        <TextBox
                            Width="80"
                            hc:InfoElement.Title="{ex:Language Key='流速（ml/h）'}"
                            BorderBrush="{DynamicResource PrimaryBrush}"
                            Style="{StaticResource TextBoxExtend}"
                            Text="{Binding Pump2Param.Speed, UpdateSourceTrigger=LostFocus}" />
                        <TextBox
                            Width="80"
                            hc:InfoElement.Title="{ex:Language Key='时间（min）'}"
                            BorderBrush="{DynamicResource PrimaryBrush}"
                            Style="{StaticResource TextBoxExtend}"
                            Text="{Binding Pump2Param.Time, UpdateSourceTrigger=LostFocus}" />
                        <TextBox
                            Width="80"
                            hc:InfoElement.Title="体积(mL)"
                            BorderBrush="{DynamicResource PrimaryBrush}"
                            IsEnabled="False"
                            Style="{StaticResource TextBoxExtend}"
                            Text="{Binding Pump2Param.TheoreticalVolume, UpdateSourceTrigger=LostFocus}" />
                        <DockPanel>
                            <Button
                                Width="80"
                                VerticalAlignment="Bottom"
                                hc:BorderElement.CornerRadius="{StaticResource DefaultCornerRadius}"
                                Command="{Binding CalibratePumpCommand}"
                                CommandParameter="1,2"
                                Content="{ex:Language Key='开始'}"
                                Style="{StaticResource ButtonPrimary}" />
                        </DockPanel>
                        <TextBox
                            Width="80"
                            hc:InfoElement.Title="称重(g)"
                            BorderBrush="{DynamicResource PrimaryBrush}"
                            Style="{StaticResource TextBoxExtend}"
                            Text="{Binding Pump2Param.Weigh, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBox
                            Width="80"
                            hc:InfoElement.Title="密度(g/mL)"
                            BorderBrush="{DynamicResource PrimaryBrush}"
                            Style="{StaticResource TextBoxExtend}"
                            Text="{Binding Pump2Param.Density, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBox
                            Width="80"
                            hc:InfoElement.Title="实测体积(mL)"
                            BorderBrush="{DynamicResource PrimaryBrush}"
                            IsEnabled="False"
                            Style="{StaticResource TextBoxExtend}"
                            Text="{Binding Pump2Param.RealVolume, UpdateSourceTrigger=PropertyChanged}" />
                        <DockPanel>
                            <Button
                                Width="80"
                                VerticalAlignment="Bottom"
                                Command="{Binding CalibratePumpCommand}"
                                CommandParameter="3,2"
                                Content="{ex:Language Key='写入'}"
                                Style="{StaticResource ButtonPrimary}" />
                        </DockPanel>
                        <DockPanel>
                            <Button
                                Width="80"
                                VerticalAlignment="Bottom"
                                Command="{Binding CalibratePumpCommand}"
                                CommandParameter="255,2"
                                Content="{ex:Language Key='完成校准'}"
                                Style="{StaticResource ButtonPrimary}" />
                        </DockPanel>
                        <TextBox
                            Width="80"
                            hc:InfoElement.Title="当前系数"
                            BorderBrush="{DynamicResource PrimaryBrush}"
                            IsEnabled="False"
                            Style="{StaticResource TextBoxExtend}"
                            Text="{Binding Pump2Param.OldCoefficient, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBox
                            Width="80"
                            hc:InfoElement.Title="更正系数"
                            BorderBrush="{DynamicResource PrimaryBrush}"
                            Style="{StaticResource TextBoxExtend}"
                            Text="{Binding Pump2Param.Coefficient, UpdateSourceTrigger=LostFocus}" />
                        <DockPanel>
                            <Button
                                Width="80"
                                VerticalAlignment="Bottom"
                                Command="{Binding CalibratePumpCommand}"
                                CommandParameter="0,2"
                                Content="{ex:Language Key='校准系数'}"
                                Style="{StaticResource ButtonPrimary}" />
                        </DockPanel>
                    </hc:UniformSpacingPanel>
                    <hc:UniformSpacingPanel Orientation="Horizontal" Spacing="10">
                        <TextBox
                            Width="60"
                            HorizontalContentAlignment="Center"
                            hc:InfoElement.Title="{ex:Language Key='泵编号'}"
                            BorderBrush="{DynamicResource PrimaryBrush}"
                            IsEnabled="False"
                            Style="{StaticResource TextBoxExtend}"
                            Text="泵3" />
                        <ComboBox
                            Width="100"
                            HorizontalContentAlignment="Center"
                            hc:InfoElement.Title="{ex:Language Key='泵用途'}"
                            BorderBrush="{DynamicResource PrimaryBrush}"
                            ItemsSource="{Binding Source={StaticResource DataFromEnum}}"
                            SelectedItem="{Binding Pump3Param.Pump}"
                            Style="{StaticResource ComboBoxExtend}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={StaticResource EnumToStringConverter}}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                            <i:Interaction.Triggers>
                                <i:EventTrigger EventName="SelectionChanged">
                                    <i:InvokeCommandAction Command="{Binding ChangePumpCommand}" PassEventArgsToCommand="True" />
                                </i:EventTrigger>
                            </i:Interaction.Triggers>
                        </ComboBox>
                        <TextBox
                            Width="80"
                            hc:InfoElement.Title="{ex:Language Key='流速（ml/h）'}"
                            BorderBrush="{DynamicResource PrimaryBrush}"
                            Style="{StaticResource TextBoxExtend}"
                            Text="{Binding Pump3Param.Speed, UpdateSourceTrigger=LostFocus}" />
                        <TextBox
                            Width="80"
                            hc:InfoElement.Title="{ex:Language Key='时间（min）'}"
                            BorderBrush="{DynamicResource PrimaryBrush}"
                            Style="{StaticResource TextBoxExtend}"
                            Text="{Binding Pump3Param.Time, UpdateSourceTrigger=LostFocus}" />
                        <TextBox
                            Width="80"
                            hc:InfoElement.Title="体积(mL)"
                            BorderBrush="{DynamicResource PrimaryBrush}"
                            IsEnabled="False"
                            Style="{StaticResource TextBoxExtend}"
                            Text="{Binding Pump3Param.TheoreticalVolume, UpdateSourceTrigger=LostFocus}" />
                        <DockPanel>
                            <Button
                                Width="80"
                                VerticalAlignment="Bottom"
                                hc:BorderElement.CornerRadius="{StaticResource DefaultCornerRadius}"
                                Command="{Binding CalibratePumpCommand}"
                                CommandParameter="1,3"
                                Content="{ex:Language Key='开始'}"
                                Style="{StaticResource ButtonPrimary}" />
                        </DockPanel>
                        <TextBox
                            Width="80"
                            hc:InfoElement.Title="称重(g)"
                            BorderBrush="{DynamicResource PrimaryBrush}"
                            Style="{StaticResource TextBoxExtend}"
                            Text="{Binding Pump3Param.Weigh, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBox
                            Width="80"
                            hc:InfoElement.Title="密度(g/mL)"
                            BorderBrush="{DynamicResource PrimaryBrush}"
                            Style="{StaticResource TextBoxExtend}"
                            Text="{Binding Pump3Param.Density, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBox
