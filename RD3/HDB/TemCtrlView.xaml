<UserControl
    x:Class="RD3.Views.TemCtrlView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:RD3.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="35"
    d:DesignWidth="200"
    mc:Ignorable="d">
    <Canvas Width="200" HorizontalAlignment="Left">
        <TextBlock
            Name="tempName"
            Canvas.Left="5"
            Canvas.Top="9"
            Width="26"
            Height="22"
            Text="温度"
            TextWrapping="Wrap" />
        <TextBox
            Name="targetValue"
            Canvas.Left="31"
            Canvas.Top="2"
            Width="41"
            Text="0"
            TextWrapping="Wrap" />
        <TextBlock
            Name="realValue"
            Canvas.Left="73"
            Canvas.Top="9"
            Width="38"
            Height="22"
            Text="99.2 "
            TextWrapping="Wrap" />
        <TextBlock
            Name="capcityUnit"
            Canvas.Left="108"
            Canvas.Top="9"
            Width="15"
            Height="22"
            Text="℃"
            TextWrapping="Wrap" />
        <ComboBox
            x:Name="ctrType"
            Canvas.Left="126"
            Canvas.Top="2"
            Width="73" />
    </Canvas>
</UserControl>
