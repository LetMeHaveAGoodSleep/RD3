<UserControl
    x:Class="RD3.Views.PumpView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:local="clr-namespace:RD3.Views"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:rd3="clr-namespace:RD3"
    xmlns:share="clr-namespace:RD3.Shared;assembly=RD3.Shared"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    xmlns:vm="clr-namespace:RD3.ViewModels"
    d:DataContext="{d:DesignInstance Type=vm:PumpViewModel}"
    d:DesignHeight="79"
    d:DesignWidth="900"
    prism:ViewModelLocator.AutoWireViewModel="True"
    Background="Transparent"
    FontSize="{StaticResource SubHeadFontSize}"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ObjectDataProvider
            x:Key="DataFromEnum"
            MethodName="GetValues"
            ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="share:PeristalticPump" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
    </UserControl.Resources>
    <Canvas>
        <Grid Canvas.Top="30">
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition Height="auto" />
                <RowDefinition />
            </Grid.RowDefinitions>
            <StackPanel HorizontalAlignment="Left" Orientation="Horizontal">
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="{StaticResource NormalFontSize}"
                    Text="{Binding PumpInfo.PumpName}" />
            </StackPanel>
            <Image
                Grid.Row="1"
                Width="90"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Source="/Images/NewReactor/分割线（图左2）.png" />
            <StackPanel
                Grid.Row="2"
                HorizontalAlignment="Left"
                Orientation="Horizontal">
                <TextBlock
                    Grid.Row="2"
                    Width="40"
                    VerticalAlignment="Center"
                    FontSize="{StaticResource NormalFontSize}"
                    Text="{Binding PumpInfo.FlowRate, StringFormat={}{0:F2}}" />
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="{StaticResource NormalFontSize}"
                    Text="mL/h" />
            </StackPanel>
        </Grid>
        <Image
            Canvas.Left="120"
            Canvas.Top="0"
            Width="22"
            Height="79"
            HorizontalAlignment="Left"
            VerticalAlignment="Center"
            Source="/Images/NewReactor/蠕动泵贯穿线.png" />
        <Image
            Name="PumpOpen"
            Canvas.Left="102"
            Canvas.Top="41"
            Width="30"
            HorizontalAlignment="Left"
            VerticalAlignment="Center"
            Source="/Images/NewReactor/蠕动泵（开启）.png"
            Visibility="{Binding PumpInfo.IsRunning, Converter={StaticResource Boolean2VisibilityConverter}}">
            <i:Interaction.Triggers>
                <i:EventTrigger EventName="MouseLeftButtonDown">
                    <i:InvokeCommandAction Command="{Binding PumpSettingCommand}" />
                </i:EventTrigger>
            </i:Interaction.Triggers>
        </Image>
        <Image
            Name="PumpClose"
            Canvas.Left="102"
            Canvas.Top="41"
            Width="30"
            HorizontalAlignment="Left"
            VerticalAlignment="Center"
            Source="/Images/NewReactor/蠕动泵（关闭）.png"
            Visibility="{Binding PumpInfo.IsRunning, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
            <i:Interaction.Triggers>
                <i:EventTrigger EventName="MouseLeftButtonDown">
                    <i:InvokeCommandAction Command="{Binding PumpSettingCommand}" />
                </i:EventTrigger>
            </i:Interaction.Triggers>
        </Image>
        <hc:UniformSpacingPanel
            Canvas.Left="160"
            Canvas.Top="20"
            Orientation="Horizontal"
            Spacing="20">
            <DockPanel Height="50" LastChildFill="False">
                <hc:UniformSpacingPanel
                    DockPanel.Dock="Bottom"
                    Orientation="Horizontal"
                    Spacing="10">
                    <Image
                        Width="13"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Source="/Images/NewReactor/小瓶.png"
                        Visibility="{Binding PumpInfo.IsWeigh, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                        <i:Interaction.Triggers>
                            <i:EventTrigger EventName="MouseLeftButtonDown">
                                <i:InvokeCommandAction Command="{Binding PumpClearCommand}" />
                            </i:EventTrigger>
                        </i:Interaction.Triggers>
                    </Image>
                    <Image
                        Width="15"
                        Source="/Images/NewReactor/小瓶（称重）.png"
                        Visibility="{Binding PumpInfo.IsWeigh, Converter={StaticResource Boolean2VisibilityConverter}}">
                        <i:Interaction.Triggers>
                            <i:EventTrigger EventName="MouseLeftButtonDown">
                                <i:InvokeCommandAction Command="{Binding PumpClearCommand}" />
                            </i:EventTrigger>
                        </i:Interaction.Triggers>
                    </Image>
                    <StackPanel Orientation="Horizontal" Visibility="{Binding PumpInfo.IsWeigh, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                        <TextBlock
                            Margin="0,0,5,0"
                            VerticalAlignment="Center"
                            Text="{Binding PumpInfo.FlowCapacity, StringFormat={}{0:F2}}" />
                        <TextBlock VerticalAlignment="Center" Text="mL" />
                    </StackPanel>
                    <Grid Visibility="{Binding PumpInfo.IsWeigh, Converter={StaticResource Boolean2VisibilityConverter}}">
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition Height="auto" />
                            <RowDefinition />
                        </Grid.RowDefinitions>
                        <StackPanel HorizontalAlignment="Left" Orientation="Horizontal">
                            <TextBlock
                                Width="40"
                                VerticalAlignment="Center"
                                FontSize="{StaticResource NormalFontSize}"
                                Text="{Binding PumpInfo.FlowCapacity, StringFormat={}{0:F2}}" />
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="{StaticResource NormalFontSize}"
                                Text="mL" />
                        </StackPanel>
                        <Image
                            Grid.Row="1"
                            Width="70"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Source="/Images/NewReactor/分割线（图左2）.png" />
                        <StackPanel
                            Grid.Row="2"
                            HorizontalAlignment="Left"
                            Orientation="Horizontal">
                            <TextBlock
                                Grid.Row="2"
                                Width="40"
                                VerticalAlignment="Center"
                                FontSize="{StaticResource NormalFontSize}"
                                Text="{Binding PumpInfo.Weight, StringFormat={}{0:F2}}" />
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="{StaticResource NormalFontSize}"
                                Text="g" />
                        </StackPanel>
                    </Grid>
                </hc:UniformSpacingPanel>
            </DockPanel>
        </hc:UniformSpacingPanel>
    </Canvas>
</UserControl>
